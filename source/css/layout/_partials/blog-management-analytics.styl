@require '../../common/variables'

// ========================================================================================
//                          BLOG MANAGEMENT · ANALYTICS
// ========================================================================================
// The console's sixth section: Umami's own dashboard at Umami's own density,
// wearing this theme's type, spacing and colour.
//
// Built from the parts the other five sections already use — `.bm-card` for a
// panel, `.bm-seg` for a picker, `.bm-sub-title` for a panel head, `.bm-hint`
// for a note, `.bm-blank` for an empty state. What is added is only what a
// dashboard needs and a form does not: a metric tile, a ranked row, a chart, a
// choropleth, a data table, a pager.
//
// COLOUR. The surfaces are the theme's own tokens, so the section reads on a
// light, a dark and an accent-tinted ground. The SERIES are a twelve-hue
// palette whose first entry is the site accent: one colour for everything is
// unreadable the moment a chart stacks more than two things, and a palette
// derived entirely from the accent would be twelve shades of one hue. The
// good/warn/bad triple is literal on purpose — "this page is slow" must not
// change meaning when the accent does.
//
// Material: BASE tier. Nothing floats; nothing earns a backdrop-filter.
//
// Auto-included: style.styl requires layout/_partials/* as a glob.

// Local, not borrowed: _partials/* is required alphabetically, so this file is
// concatenated BEFORE blog-management.styl and its $bm-gap does not exist yet.
$bma-gap = 12px
$bma-radius = 12px

.bma-body
  --bma-good #16a34a
  --bma-warn #d97706
  --bma-bad #dc2626

  // The series palette. p1 is the site accent so the lead series stays on
  // brand; the other eleven are chosen to stay apart from each other and to
  // hold their own on both a white and a near-black panel.
  --bma-p1 var(--primary-color)
  --bma-p2 #2680eb
  --bma-p3 #9256d9
  --bma-p4 #2fa84f
  --bma-p5 #e68619
  --bma-p6 #00a7c0
  --bma-p7 #6b7f95
  --bma-p8 #c2185b
  --bma-p9 #7cb342
  --bma-p10 #8d6e63
  --bma-p11 #5c6bc0
  --bma-p12 #c9a227

  // unquote() is mandatory — Stylus reads `in oklab` as an expression and fails
  // the WHOLE stylesheet on it.
  --bma-track unquote('color-mix(in oklab, var(--primary-color) 14%, transparent)')
  --bma-map-ground var(--third-background-color-transparent)
  --bma-map-line var(--border-color)

  display flex
  flex-direction column
  gap 16px
  min-height 240px

.dark .bma-body
  --bma-good #4ade80
  --bma-warn #fbbf24
  --bma-bad #f87171

  // Four of the twelve sit too dark on a near-black panel; the rest carry over.
  --bma-p4 #4ac26b
  --bma-p8 #ef5a8c
  --bma-p10 #b08a7c
  --bma-p11 #8a97e0

// ─── head ────────────────────────────────────────────────────────────────────
.bma-head
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap
  gap $bma-gap

// `.bm-seg` and `.bm-card` are declared in blog-management.styl, which the glob
// concatenates AFTER this file — a bare `.bma-*` rule loses the tie.
.bm-seg.bma-seg
  // A long picker (seventeen dimensions) has to scroll rather than become five
  // rows of buttons above a four-row table.
  flex-wrap nowrap
  overflow-x auto
  overscroll-behavior-x contain
  scrollbar-width none

  &::-webkit-scrollbar
    display none

  &.is-mini button
    padding 3px 9px
    font-size 0.7rem

.bma-controls
  display flex
  align-items center
  flex-wrap wrap
  gap 8px

.bma-wait
  display flex
  align-items center
  justify-content center
  min-height 220px
  color var(--third-text-color)
  font-size 1.4rem

// A row of controls above a table or a chart.
.bma-bar
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap
  gap $bma-gap
  min-width 0

// ─── metric tiles ────────────────────────────────────────────────────────────
// `auto-fit` + `minmax` rather than a column count: four or five tiles reflow
// through 5, 3, 2 and 1 across every breakpoint without one media query, and the
// last row is never a single tile stretched across the grid.
.bma-metrics
  display grid
  grid-template-columns repeat(auto-fit, minmax(136px, 1fr))
  gap $bma-gap

.bma-metric
  display flex
  flex-direction column
  gap 2px
  padding 12px 14px
  border 1px solid var(--border-color)
  border-radius $bma-radius
  background var(--background-color)
  transition border-color 0.2s ease, background 0.2s ease

.bma-metric-label
  font-size 0.72rem
  font-weight 500
  letter-spacing 0.02em
  color var(--third-text-color)
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.bma-metric-value
  font-size 1.6rem
  font-weight 650
  line-height 1.15
  letter-spacing -0.025em
  font-variant-numeric tabular-nums
  color var(--first-text-color)

.bma-metric-change
  display flex
  align-items center
  gap 4px
  min-height 1.1em
  font-size 0.7rem
  font-weight 600
  font-variant-numeric tabular-nums
  color var(--third-text-color)

  &.is-up
    color var(--bma-good)
  &.is-down
    color var(--bma-bad)
  &.is-empty
    font-weight 500
    opacity 0.75

// A vitals tile says good / needs work / poor with a stripe rather than by
// turning the whole number red, which at five tiles side by side reads as an
// alarm rather than as a reading.
.bma-metric.tone-good,
.bma-metric.tone-warn,
.bma-metric.tone-bad
  position relative
  padding-left 17px
  overflow hidden

  &::before
    content ''
    position absolute
    left 0
    top 0
    bottom 0
    width 3px

.bma-metric.tone-good::before
  background var(--bma-good)
.bma-metric.tone-warn::before
  background var(--bma-warn)
.bma-metric.tone-bad::before
  background var(--bma-bad)

// The performance tiles pick which metric the chart draws, so they have to look
// pressable and one of them has to look chosen.
.bma-metric[data-pick]
  cursor pointer

  &:hover
    border-color var(--primary-color)

  &.is-on
    border-color var(--primary-color)
    background var(--bma-track)

// ─── panels ──────────────────────────────────────────────────────────────────
.bma-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(300px, 1fr))
  gap $bma-gap
  align-items start

  // The map wants twice the width of the traffic grid beside it, which is the
  // proportion Umami gives them.
  &.is-two-one
    grid-template-columns minmax(0, 2fr) minmax(260px, 1fr)

    +redefine-tablet()
      grid-template-columns minmax(0, 1fr)

.bm-card.bma-panel
  display flex
  flex-direction column
  gap 10px
  min-width 0
  padding 14px 16px

.bma-panel-head
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap
  gap 10px

// ─── tabs ────────────────────────────────────────────────────────────────────
// A panel's own tabs, underlined rather than segmented: `.bm-seg` is the page's
// picker and using it twice in one card would make the two look like the same
// control at two sizes.
.bma-tabs
  display flex
  gap 2px
  margin-bottom 2px
  border-bottom 1px solid var(--border-color)
  overflow-x auto
  scrollbar-width none

  &::-webkit-scrollbar
    display none

  button
    position relative
    padding 6px 10px
    border none
    background none
    color var(--third-text-color)
    font-family $default-font-family
    font-size 0.78rem
    font-weight 500
    white-space nowrap
    cursor pointer
    transition color 0.2s ease

    &::after
      content ''
      position absolute
      left 6px
      right 6px
      bottom -1px
      height 2px
      border-radius 2px
      background transparent
      transition background 0.2s ease

    &:hover
      color var(--first-text-color)

    &.is-on
      color var(--primary-color)
      font-weight 600

      &::after
        background var(--primary-color)

// ─── ranked lists ────────────────────────────────────────────────────────────
.bma-list
  display flex
  flex-direction column
  min-width 0

.bma-list-head
  display grid
  grid-template-columns minmax(0, 1fr) auto auto
  gap 10px
  padding 0 8px 5px
  border-bottom 1px solid var(--border-color)
  font-size 0.66rem
  font-weight 600
  letter-spacing 0.05em
  text-transform uppercase
  color var(--third-text-color)

  span + span
    text-align right

.bma-rows
  display flex
  flex-direction column
  margin 0
  padding 0
  list-style none

// The bar is the row's own background, not a track beside it: a separate column
// would cost the width the name needs more.
.bma-row
  position relative
  display grid
  grid-template-columns minmax(0, 1fr) auto auto
  align-items center
  gap 10px
  padding 5px 8px
  border-radius 7px
  font-size 0.8rem
  overflow hidden

  &::before
    content ''
    position absolute
    left 0
    top 2px
    bottom 2px
    width var(--bma-bar, 0%)
    border-radius 6px
    background var(--bma-track)

  &:hover::before
    background unquote('color-mix(in oklab, var(--primary-color) 24%, transparent)')

.bma-row-name
  position relative
  display flex
  align-items center
  gap 8px
  min-width 0
  color var(--second-text-color)

  > span
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.bma-row-value
  position relative
  font-weight 600
  font-variant-numeric tabular-nums
  color var(--first-text-color)

.bma-row-share
  position relative
  min-width 34px
  text-align right
  font-variant-numeric tabular-nums
  color var(--third-text-color)

// ─── icons ───────────────────────────────────────────────────────────────────
// One fixed box whatever goes inside it — a brand glyph, a flag, or a remote
// favicon that may never arrive — so a column of names stays aligned.
.bma-ico
  display inline-flex
  align-items center
  justify-content center
  flex 0 0 auto
  width 16px
  height 16px
  font-size 0.82em
  line-height 1
  color var(--third-text-color)

  img
    width 16px
    height 16px
    object-fit contain
    border-radius 3px

  &.bma-flag
    font-size 1.02em
    font-style normal

.bma-cell
  display inline-flex
  align-items center
  gap 7px
  min-width 0
  max-width 100%

  > span
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.bma-more
  align-self center
  margin-top 6px
  padding 4px 12px
  border none
  border-radius 999px
  background var(--third-background-color-transparent)
  color var(--third-text-color)
  font-family $default-font-family
  font-size 0.72rem
  font-weight 500
  cursor pointer
  transition color 0.2s ease, background 0.2s ease

  i
    margin-right 5px

  &:hover
    color var(--primary-color)
    background var(--bma-track)

// ─── chart ───────────────────────────────────────────────────────────────────
.bma-chart
  position relative
  width 100%
  min-width 0

.bma-chart-svg
  display block
  width 100%
  height var(--bma-chart-h, 300px)
  overflow visible

.bma-legend
  display flex
  flex-wrap wrap
  justify-content center
  gap 6px 16px
  margin-top 2px
  font-size 0.72rem
  color var(--third-text-color)

  span
    display inline-flex
    align-items center
    gap 6px

  i
    width 10px
    height 10px
    border-radius 3px

    // A line series is drawn as a line, so its key is one.
    &.is-line
      height 3px
      border-radius 2px

// The axis furniture. Quiet enough to read past, present enough to read from.
.bma-gridline,
.bma-axis
  stroke var(--border-color)
  stroke-width 1
  shape-rendering crispEdges

.bma-axis
  stroke var(--third-text-color)
  opacity 0.45

.bma-axis-x,
.bma-axis-y
  fill var(--third-text-color)
  font-size 10.5px
  font-variant-numeric tabular-nums

.bma-axis-y
  text-anchor end

.bma-axis-x
  text-anchor middle

.bma-line
  fill none
  stroke-width 2
  stroke-linecap round
  stroke-linejoin round

.bma-cursor
  fill var(--bma-track)
  pointer-events none

.bma-chart-tip
  position absolute
  z-index 3
  top 6px
  display flex
  flex-direction column
  gap 3px
  padding 8px 11px
  border 1px solid var(--border-color)
  border-radius 9px
  background var(--background-color)
  box-shadow 0 4px 18px var(--shadow-color-1)
  font-size 0.72rem
  line-height 1.4
  color var(--second-text-color)
  white-space nowrap
  pointer-events none
  opacity 0
  transform translate(-50%, 0) scale(0.97)
  transform-origin top center
  transition opacity 0.14s ease, transform 0.14s cubic-bezier(0.32, 0.72, 0, 1)

  b
    color var(--first-text-color)
    font-weight 600

  span
    display flex
    align-items center
    gap 6px

  i
    width 8px
    height 8px
    border-radius 2px

  em
    margin-left auto
    padding-left 14px
    font-style normal
    font-weight 600
    font-variant-numeric tabular-nums
    color var(--first-text-color)

  &.is-on
    opacity 1
    transform translate(-50%, 0) scale(1)

// ─── world map ───────────────────────────────────────────────────────────────
// Six steps rather than a continuous ramp: a country's exact share is what the
// list beside it is for, and a smooth fill over 174 shapes reads as noise.
.bma-map
  position relative
  width 100%
  min-width 0

  &.is-waiting
    min-height 200px

  svg
    display block
    width 100%
    height auto

.bma-land
  fill var(--bma-map-ground)
  stroke var(--bma-map-line)
  stroke-width 0.4
  vector-effect non-scaling-stroke
  transition fill 0.15s ease

  &.l1
    fill unquote('color-mix(in oklab, var(--primary-color) 18%, var(--background-color))')
  &.l2
    fill unquote('color-mix(in oklab, var(--primary-color) 34%, var(--background-color))')
  &.l3
    fill unquote('color-mix(in oklab, var(--primary-color) 50%, var(--background-color))')
  &.l4
    fill unquote('color-mix(in oklab, var(--primary-color) 66%, var(--background-color))')
  &.l5
    fill unquote('color-mix(in oklab, var(--primary-color) 83%, var(--background-color))')
  &.l6
    fill var(--primary-color)

  &:hover
    stroke var(--first-text-color)
    stroke-width 1

.bma-map-tip
  position absolute
  z-index 3
  display flex
  flex-direction column
  padding 6px 10px
  border 1px solid var(--border-color)
  border-radius 9px
  background var(--background-color)
  box-shadow 0 4px 18px var(--shadow-color-1)
  font-size 0.72rem
  line-height 1.4
  color var(--third-text-color)
  white-space nowrap
  pointer-events none
  opacity 0
  transform translate(-50%, 0)
  transition opacity 0.14s ease

  b
    color var(--first-text-color)
    font-weight 600

  &.is-on
    opacity 1

// ─── weekly traffic ──────────────────────────────────────────────────────────
// Days across, hours down, each cell a dot whose size AND opacity carry the
// count. Umami's own grid: a quiet hour has to read as nearly nothing, which a
// pale square does not manage.
.bma-week
  display flex
  flex-direction column
  gap 3px
  min-width 0

.bma-week-row
  display grid
  grid-template-columns 36px repeat(7, minmax(0, 1fr))
  align-items center
  justify-items center
  gap 3px

  > span:first-child
    justify-self end
    padding-right 4px
    font-size 0.6rem
    color var(--third-text-color)
    font-variant-numeric tabular-nums

  i
    position relative
    width 15px
    height 15px
    border-radius 50%
    background var(--third-background-color-transparent)

    &::after
      content ''
      position absolute
      inset 0
      border-radius 50%
      background var(--primary-color)
      opacity var(--bma-dot, 0)
      transform unquote('scale(var(--bma-dot, 0))')

  &.is-head span
    padding 0
    justify-self center
    font-size 0.68rem
    font-weight 600
    letter-spacing 0.03em
    color var(--second-text-color)

// ─── tables ──────────────────────────────────────────────────────────────────
.bma-scroll
  overflow-x auto
  overscroll-behavior-x contain

.bma-table
  width 100%
  border-collapse collapse
  font-size 0.78rem

  &.is-fixed
    table-layout fixed

  th,
  td
    padding 7px 10px
    text-align left
    white-space nowrap
    max-width 280px
    overflow hidden
    text-overflow ellipsis

  th
    position sticky
    top 0
    z-index 1
    border-bottom 1px solid var(--border-color)
    background var(--background-color)
    font-size 0.66rem
    font-weight 600
    letter-spacing 0.05em
    text-transform uppercase
    color var(--third-text-color)

  td
    border-bottom 1px solid var(--border-color)
    color var(--second-text-color)

  tbody tr:last-child td
    border-bottom none

  tbody tr:hover td
    background var(--third-background-color-transparent)

.bma-num
  text-align right
  font-variant-numeric tabular-nums

.bma-strong
  font-weight 600
  color var(--first-text-color)

.bma-id
  font-family ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  font-size 0.72rem
  color var(--third-text-color)

.bma-kind
  display inline-flex
  align-items center
  gap 5px
  padding 2px 8px
  border-radius 999px
  background var(--third-background-color-transparent)
  font-size 0.68rem
  font-weight 600
  color var(--third-text-color)

  &.is-event
    color var(--primary-color)
    background var(--bma-track)

.bma-delta
  font-weight 600

  &.is-up
    color var(--bma-good)
  &.is-down
    color var(--bma-bad)

// ─── pager and search ────────────────────────────────────────────────────────
.bma-pager
  display flex
  align-items center
  gap 8px
  padding-top 4px
  font-size 0.74rem
  font-variant-numeric tabular-nums
  color var(--third-text-color)

  button
    display inline-flex
    align-items center
    justify-content center
    width 26px
    height 26px
    border 1px solid var(--border-color)
    border-radius 8px
    background var(--background-color)
    color var(--second-text-color)
    font-size 0.7rem
    cursor pointer
    transition border-color 0.2s ease, color 0.2s ease

    &:hover:not(:disabled)
      border-color var(--primary-color)
      color var(--primary-color)

    &:disabled
      opacity 0.4
      cursor default

.bma-pager-count
  margin-left auto

.bma-search
  display inline-flex
  align-items center
  gap 7px
  padding 5px 10px
  border 1px solid var(--border-color)
  border-radius 10px
  background var(--second-background-color)
  color var(--third-text-color)
  font-size 0.74rem

  input
    width 150px
    max-width 40vw
    border none
    background none
    color var(--first-text-color)
    font-family $default-font-family
    font-size 0.78rem
    outline none

// ─── breakdown field picker ──────────────────────────────────────────────────
// Chips rather than a segmented control: this is a multiple choice, and a
// segment with four of its buttons lit is the wrong affordance.
.bma-fields
  display flex
  flex-wrap wrap
  gap 6px

  button
    padding 4px 11px
    border 1px solid var(--border-color)
    border-radius 999px
    background var(--background-color)
    color var(--third-text-color)
    font-family $default-font-family
    font-size 0.74rem
    font-weight 500
    cursor pointer
    transition border-color 0.2s ease, color 0.2s ease, background 0.2s ease

    &:hover
      color var(--first-text-color)
      border-color var(--primary-color)

    &.is-on
      border-color var(--primary-color)
      background var(--bma-track)
      color var(--primary-color)
      font-weight 600

// ─── narrow ──────────────────────────────────────────────────────────────────
+redefine-tablet()
  .bma-head
    flex-direction column
    align-items stretch

    .bm-seg.bma-seg
      align-self stretch

  .bma-metric-value
    font-size 1.35rem

+redefine-mobile()
  .bma-metrics
    grid-template-columns repeat(auto-fit, minmax(112px, 1fr))

  .bma-metric
    padding 10px 12px

  .bma-metric-value
    font-size 1.2rem

  .bm-card.bma-panel
    padding 12px

  .bma-search input
    width 110px

  .bma-week-row
    grid-template-columns 26px repeat(7, minmax(0, 1fr))

    i
      width 12px
      height 12px
