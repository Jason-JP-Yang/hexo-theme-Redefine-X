// ========================================================================================
//                                    ENCRYPTED POSTS
// ========================================================================================
// The gate an encrypted post's page renders, the badge an authorized card
// carries in a listing, the audience field an admin gets above the article, and
// the management console's registry.
//
// Material: BASE tier only. Nothing here floats over live content.
// Auto-included: style.styl requires layout/_partials/* as a glob.

$vault-radius = 14px

// ─── the gate ───────────────────────────────────────────────
// Once the article is in, the gate and its host STOP BEING BOXES. Every rule the
// post layout has is written against `.main-content > .post-page-container` —
// the table of contents column, the content width, the table styling — and two
// extra wrappers in between silently defeated all of it. `display: contents`
// puts the decrypted article exactly where a public post's markup sits.
.vault-gate[data-vault-state="open"]
  display contents

  .vault-article-host
    display contents

// It opens on the unlocking card, never on the not-found page: a 404 that
// flashes before the article arrives reads as a broken link.
.vault-gate-card
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 18px
  min-height 58vh
  padding 40px 20px

.vault-gate-lock
  display flex
  align-items center
  justify-content center
  width 62px
  height 62px
  border 1px solid var(--border-color)
  border-radius 50%
  background var(--second-background-color)
  font-size 1.35rem
  color var(--primary-color)
  animation vault-breathe 2.4s ease-in-out infinite

.vault-gate-text
  margin 0
  font-size 0.9rem
  font-weight 500
  letter-spacing 0.01em
  color var(--third-text-color)

.vault-gate-bar
  position relative
  overflow hidden
  width 168px
  height 3px
  border-radius 999px
  background var(--third-background-color-transparent)

  span
    position absolute
    top 0
    left 0
    width 42%
    height 100%
    border-radius inherit
    background var(--primary-color)
    animation vault-sweep 1.25s cubic-bezier(0.65, 0, 0.35, 1) infinite

@keyframes vault-breathe
  0%, 100%
    transform scale(1)
    opacity 0.72
  50%
    transform scale(1.06)
    opacity 1

@keyframes vault-sweep
  0%
    transform translateX(-110%)
  100%
    transform translateX(270%)

// ─── signed out mid-read ────────────────────────────────────
// The plaintext is removed rather than hidden, and the page says why instead of
// silently turning into a 404 under the reader.
.vault-signout
  display flex
  align-items center
  justify-content center
  min-height 62vh
  padding 40px 20px

.vault-signout-card
  display flex
  flex-direction column
  align-items center
  gap 12px
  max-width 420px
  padding 34px 30px
  border 1px solid var(--border-color)
  border-radius 18px
  background var(--second-background-color)
  text-align center

  > i
    font-size 1.6rem
    color var(--primary-color)

  h2
    margin 0
    font-size 1.35rem
    font-weight 650
    color var(--second-text-color)

  p
    margin 0
    font-size 0.84rem
    line-height 1.6
    color var(--third-text-color)

.vault-signout-home
  display inline-flex
  align-items center
  gap 8px
  margin-top 8px
  padding 9px 18px
  border-radius 999px
  background var(--primary-color)
  font-size 0.82rem
  font-weight 600
  color var(--background-color)
  transition transform 0.2s ease, opacity 0.2s ease

  &:hover
    transform translateY(-1px)
    opacity 0.92

.vault-signout-count
  opacity 0.7
  font-variant-numeric tabular-nums

// Everything but the navbar goes inert behind the notice — the same treatment
// the notification panel gives a banned account. Driven by a class on <html>
// rather than a sibling selector, because the gate is an only child and had
// nothing to select.
html.vault-locked
  .main-content-footer,
  .post-tools,
  .right-side-tools-container,
  .home-banner
    filter blur(6px) saturate(0.6)
    pointer-events none
    user-select none
    transition filter 0.4s ease

// ─── the authorized badge ───────────────────────────────────
// Sits where the sticky badge sits: the same kind of statement about the card,
// and never both at once.
.home-article-vault-badge
  position absolute
  top 10px
  left 10px
  z-index 3
  display inline-flex
  align-items center
  gap 6px
  padding 4px 9px
  border-radius 999px
  background var(--primary-color)
  font-size 0.68rem
  font-weight 600
  color var(--background-color)

  i
    font-size 0.68rem

.home-article-item.is-vault
  position relative

  &::after
    content ''
    position absolute
    inset 0
    border-radius inherit
    border 1px solid var(--primary-color)
    opacity 0.34
    pointer-events none

// ─── admin: who can read this ───────────────────────────────
// Inside the article body, above the first paragraph — where the decision it
// controls is actually being made.
.vault-admin
  display flex
  flex-direction column
  gap 8px
  margin 0 0 28px
  padding 14px 16px
  border 1px solid var(--border-color)
  border-radius $vault-radius
  background var(--second-background-color)

.vault-admin-label
  display flex
  align-items center
  gap 8px
  font-size 0.76rem
  font-weight 600
  color var(--third-text-color)

.vault-admin-state
  margin-left auto
  font-size 0.76rem
  color var(--primary-color)

// ─── management console ─────────────────────────────────────
.bm-vault-add-row
  display flex
  gap 8px
  margin-top 10px

  @media screen and (max-width: 600px)
    flex-direction column

.bm-vault-line
  flex 1
  min-width 0
  padding 9px 11px
  border 1px solid var(--border-color)
  border-radius 10px
  background var(--second-background-color)
  font-family var(--code-font)
  font-size 0.74rem
  color var(--text-color)

  &:focus
    border-color var(--primary-color)
    outline none

.bm-vault-add-state
  margin 8px 0 0
  font-size 0.74rem
  color var(--third-text-color)

  &[data-tone="ok"]
    color var(--primary-color)

  &[data-tone="bad"]
    color var(--box-red-text)

  &:empty
    display none

.bm-vault-list
  display flex
  flex-direction column
  gap 12px
  margin 0
  padding 0
  list-style none

// Two columns for the identity of the post, a third row spanning both for the
// audience — the field is the widest thing here and reads badly in a gutter.
.bm-vault
  display grid
  grid-template-columns minmax(0, 1fr) auto
  gap 6px 18px
  padding 16px 18px
  border 1px solid var(--border-color)
  border-radius $vault-radius
  background var(--background-color)
  transition border-color 0.2s ease

  &:hover
    border-color var(--shadow-color-1)

  @media screen and (max-width: 640px)
    grid-template-columns minmax(0, 1fr)

.bm-vault-main
  display flex
  flex-direction column
  gap 6px
  min-width 0

.bm-vault-title
  display flex
  align-items center
  gap 9px
  font-size 1rem
  font-weight 620
  letter-spacing -0.01em
  color var(--second-text-color)

  i
    flex-shrink 0
    font-size 0.82rem
    color var(--primary-color)

  a
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    color inherit

    &:hover
      color var(--primary-color)

.bm-vault-meta
  display flex
  flex-wrap wrap
  align-items center
  gap 4px 14px
  font-size 0.72rem
  color var(--third-text-color)

  span
    display inline-flex
    align-items center
    gap 5px

  i
    font-size 0.68rem
    opacity 0.75

.bm-vault-slug
  font-family var(--code-font)
  opacity 0.8

.bm-vault-excerpt
  overflow hidden
  display -webkit-box
  -webkit-line-clamp 2
  -webkit-box-orient vertical
  margin 2px 0 0
  font-size 0.76rem
  line-height 1.55
  color var(--third-text-color)

.bm-vault-side
  display flex
  flex-direction column
  align-items flex-end
  gap 8px

  @media screen and (max-width: 640px)
    flex-direction row
    align-items center
    justify-content space-between

.bm-vault-readers
  display inline-flex
  align-items baseline
  gap 6px
  padding 4px 10px
  border-radius 999px
  background var(--third-background-color-transparent)
  font-size 0.72rem
  color var(--third-text-color)
  white-space nowrap

  i
    align-self center
    font-size 0.68rem
    color var(--primary-color)

  strong
    font-size 0.86rem
    font-weight 650
    color var(--second-text-color)
    font-variant-numeric tabular-nums

  &[data-empty="1"]
    i
      color var(--third-text-color)
      opacity 0.6

.bm-vault-audience
  grid-column 1 / -1
  display flex
  flex-direction column
  gap 6px
  margin-top 6px
  padding-top 12px
  border-top 1px dashed var(--border-color)
