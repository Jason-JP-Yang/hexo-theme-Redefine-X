// ========================================================================================
//                                        EDITOR
// ========================================================================================
// Editing happens ON the article, not on a page of its own.
//
// So there is no editor layout here, and there must never be one: the cover,
// the title, the measure and the body are the post's, and the only thing this
// file styles is what is ADDED to it — a bar naming the file, a card holding
// the front matter, a floating toolbar and the per-block gutter. If a rule
// here changes how the article itself looks, the editor has stopped showing
// what will be published, which is the one thing it exists to do.
//
// Material: BASE tier throughout, except the three surfaces that genuinely float
// over live content — the toolbar, the slash menu and the two popovers. Those
// earn a backdrop-filter; nothing else does.
//
// Motion: 130ms fade / 280ms morph / cubic-bezier(0.32, 0.72, 0, 1), the
// console's own constants. Anything longer belongs in JS, where it can measure.
//
// Ink: --third-text-color is the dimmest thing allowed to carry a word here.
// --fourth-text-color is `darken(--default, 70%)`, which in dark mode lands at
// roughly 1.6:1 against the surfaces in this file — a field label written in it
// is not faint, it is gone. It stays available for borders and rules only.
//
// Auto-included: style.styl requires layout/_partials/* as a glob.

$ed-radius = 14px
$ed-morph = 0.28s cubic-bezier(0.32, 0.72, 0, 1)
$ed-fade = 0.13s ease
// Ink for anything sitting ON --primary-color, which is a dark cardinal red.
// --background-color inverts with the theme, so pairing the two puts near-black
// on red the moment the site is dark. White, the way the notification centre,
// the console and the error book already do it.
$ed-on-primary = #fff
// Where the document bar pins, and the anchor the floating toolbar is placed
// under. One value, so the two cannot drift back onto the same band.
$ed-docbar-top = ($navbar-height + 12px)
$ed-mono = 'Geist Mono Variable', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace

@keyframes ed-breathe
  0%, 100%
    opacity 0.35
  50%
    opacity 1

@keyframes ed-drop-in
  from
    opacity 0
    transform scaleX(0.82)
  to
    opacity 1
    transform none

// ─── the pencil ─────────────────────────────────────────────
// One more tool in the article's own rail; `.blog-admin-only` already decides
// whether it exists at all.
.tool-edit-post
  cursor pointer

  &:hover i
    color var(--primary-color)

// While editing, the way out is the bar's own ×. A second entrance to a room
// you are already in is just a thing to press by mistake.
html.blog-editing .tool-edit-post
  display none !important

// A post with nothing in it yet is still a page you have to be able to aim at.
.article-content-container.is-editing .article-content
  min-height 40vh

// ─── what editing puts away ─────────────────────────────────
// Copyright, tags, recommendations, navigation and comments are all downstream
// of the body and none of them is yours to edit here. They leave rather than
// grey out: an inert control is still a control.
.ed-put-away
  display none !important

// ─── gate ───────────────────────────────────────────────────
.ed-gate
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 12px
  padding 72px 24px
  color var(--third-text-color)
  text-align center

// ─── document bar ───────────────────────────────────────────
// Sticky, because publish has to stay reachable from the bottom of a long post.
//
// It pins ABOVE the floating toolbar, in both senses: a higher stacking order,
// and the toolbar offset below it by `--ed-docbar-h` (set from JS, since the
// bar's height changes as it wraps and as notices and the progress row appear).
// The two used to be given the same band under the navbar and the toolbar won,
// so the file you were editing and the way to save it were both behind it.
.ed-docbar
  position sticky
  top $ed-docbar-top
  // Above the toolbar ($z-index-4); the transient popovers stay above both.
  z-index $z-index-5
  display flex
  flex-wrap wrap
  align-items center
  gap 8px 10px
  // Top margin clears the author banner directly above. Sides are the article's
  // own px-2 / sm:px-6 / md:px-8, or the bar sits a few pixels off the column it
  // belongs to — the kind of thing you see without being able to say what it is.
  margin 22px 8px 14px
  padding 9px 12px
  border 1px solid var(--border-color)
  border-radius 12px
  background var(--second-background-color)
  box-shadow 0 6px 20px -16px var(--shadow-color-1)

  @media (min-width 640px)
    margin 24px 24px 16px

  @media (min-width 768px)
    margin 26px 32px 16px

  +redefine-tablet()
    position static

// Both halves wrap, and either may take a whole row of its own. A file path is
// the one thing here that can be any length, so it is what gives way first —
// but it gives way by wrapping to its own line, never by being squeezed to the
// two or three characters that used to be left of it.
.ed-docbar-id
  display flex
  flex-wrap wrap
  align-items center
  gap 6px 8px
  flex 1 1 210px
  min-width 0

  > i
    flex-shrink 0
    color var(--third-text-color)
    font-size 0.8rem

.ed-docbar-path
  // A floor, not a preference: without one the path is the only item here that
  // shrinks, so the tags kept their full width and the filename was ground down
  // to a character and a half. Below this the tags wrap to a line of their own.
  flex 1 1 12rem
  min-width 8rem
  overflow hidden
  color var(--second-text-color)
  font-family $ed-mono
  font-size 0.74rem
  text-overflow ellipsis
  white-space nowrap

.ed-tag
  display inline-flex
  align-items center
  gap 5px
  flex-shrink 0
  padding 2px 8px
  border-radius 999px
  font-size 0.66rem
  font-weight 650

  &.ed-tag-vault
    background var(--box-blue-bg)
    color var(--box-blue-text)

  &.ed-tag-draft
    background var(--box-amber-bg)
    color var(--box-amber-text)

.ed-docbar-actions
  display flex
  flex-wrap wrap
  justify-content flex-end
  align-items center
  gap 8px
  margin-left auto

// The whole change indicator: one amber dot, and nothing when there is nothing
// to say.
.ed-dot
  flex-shrink 0
  width 8px
  height 8px
  border-radius 50%
  background transparent
  transition background $ed-fade

  &[data-state="dirty"]
    background var(--box-amber-text)

  &[data-state="busy"]
    background var(--box-blue-text)
    animation ed-breathe 1.4s ease-in-out infinite

.ed-act
  display inline-flex
  align-items center
  gap 7px
  padding 6px 12px
  border 1px solid var(--border-color)
  border-radius 10px
  background var(--background-color)
  color var(--second-text-color)
  font-size 0.78rem
  font-weight 550
  cursor pointer
  transition background $ed-fade, border-color $ed-fade, transform $ed-morph, opacity $ed-fade

  &:hover:not(:disabled)
    background var(--third-background-color)
    transform translateY(-1px)

  &:disabled
    opacity 0.4
    cursor default

.ed-act-primary
  border-color transparent
  background var(--primary-color)
  color $ed-on-primary

  i
    color $ed-on-primary

  &:hover:not(:disabled)
    background var(--primary-color)
    filter brightness(1.08)

.ed-close
  padding 6px 9px

// ─── the title, in its own place ────────────────────────────
.ed-title
  outline none
  cursor text

  &:empty::before
    content attr(data-placeholder)
    color var(--third-text-color)
    opacity 0.6

.ed-cover-tools
  position absolute
  top 12px
  right 12px
  z-index 2
  display flex
  gap 6px

  &.is-bare
    position static
    margin 0 8px 4px

    @media (min-width 640px)
      margin 0 24px 4px

    @media (min-width 768px)
      margin 0 32px 4px

.ed-cover-act
  display grid
  place-items center
  width 32px
  height 32px
  border 1px solid var(--border-color)
  border-radius 9px
  background var(--third-background-color-transparent)
  backdrop-filter blur(10px)
  -webkit-backdrop-filter blur(10px)
  color var(--second-text-color)
  font-size 0.8rem
  cursor pointer
  transition background $ed-fade, transform $ed-morph

  &:hover
    background var(--second-background-color)
    transform translateY(-1px)

// ─── front matter ───────────────────────────────────────────
// ONE card. Every field is a row inside it, and nothing inside it is a card —
// a panel of panels is how a form stops being readable.
.ed-front
  margin 0 8px 20px
  padding 14px 16px
  border 1px solid var(--border-color)
  border-radius $ed-radius
  background var(--second-background-color)

  @media (min-width 640px)
    margin 0 24px 22px

  @media (min-width 768px)
    margin 0 32px 22px

.ed-front-group + .ed-front-group
  margin-top 12px
  padding-top 12px
  border-top 1px solid var(--border-color)

.ed-front-legend
  margin 0 0 8px
  font-size 0.66rem
  font-weight 700
  letter-spacing 0.06em
  text-transform uppercase
  color var(--third-text-color)

.ed-front-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(210px, 1fr))
  gap 8px 14px
  align-items start

.ed-f
  display flex
  flex-direction column
  gap 3px
  min-width 0

  &.is-wide
    grid-column 1 / -1

.ed-f-label
  display flex
  align-items center
  gap 5px
  font-size 0.68rem
  font-weight 600
  letter-spacing 0.02em
  color var(--third-text-color)

.ed-f-extra
  font-size 0.5rem
  color var(--box-amber-text)

.ed-f-input
  width 100%
  padding 5px 9px
  border 1px solid var(--border-color)
  border-radius 8px
  background var(--background-color)
  color var(--first-text-color)
  font-size 0.78rem
  line-height 1.5
  outline none
  resize vertical
  transition border-color $ed-fade

  &:focus
    border-color var(--primary-color)

  // Shown, not offered: a date the build owns.
  &:disabled
    background var(--second-background-color)
    color var(--third-text-color)
    cursor default

textarea.ed-f-input
  font-family inherit

.ed-f-assetrow
  display flex
  align-items center
  gap 6px

.ed-f-thumb
  display grid
  place-items center
  flex-shrink 0
  width 30px
  height 30px
  border 1px solid var(--border-color)
  border-radius 8px
  background var(--background-color)
  overflow hidden
  color var(--third-text-color)
  font-size 0.7rem

  img
    width 100%
    height 100%
    object-fit cover

.ed-f-pick
  display grid
  place-items center
  flex-shrink 0
  width 30px
  height 30px
  border 1px solid var(--border-color)
  border-radius 8px
  background var(--background-color)
  color var(--second-text-color)
  font-size 0.74rem
  cursor pointer
  transition background $ed-fade

  &:hover
    background var(--third-background-color)

// Chips, because a category is a thing you add and remove, not a string you
// punctuate correctly.
.ed-f-chips
  display flex
  flex-wrap wrap
  align-items center
  gap 4px
  min-height 30px
  padding 3px 5px
  border 1px solid var(--border-color)
  border-radius 8px
  background var(--background-color)

  &:focus-within
    border-color var(--primary-color)

.ed-chipv
  display inline-flex
  align-items center
  gap 4px
  padding 2px 4px 2px 8px
  border-radius 999px
  background var(--third-background-color)
  color var(--second-text-color)
  font-size 0.72rem

.ed-chipv-x
  display grid
  place-items center
  width 15px
  height 15px
  border none
  border-radius 50%
  background transparent
  color var(--third-text-color)
  font-size 0.58rem
  cursor pointer

  &:hover
    background var(--box-red-bg)
    color var(--box-red-text)

.ed-f-chipadd
  flex 1
  min-width 52px
  padding 2px 4px
  border none
  background transparent
  color var(--first-text-color)
  font-size 0.74rem
  outline none

// The toggle is `.np-switch`, the notification centre's own. Only the row
// spacing is local — the control itself must not fork.
.ed-f-toggle
  gap 8px
  padding 4px 0

  .np-row-label
    font-size 0.78rem

// ─── notice ─────────────────────────────────────────────────
// A row of the bar rather than a banner over the article: nothing the editor
// has to say is worth pushing the post down the page for.
.ed-notice
  display flex
  align-items center
  gap 8px
  flex-basis 100%
  padding 8px 11px
  border-radius 10px
  font-size 0.76rem
  line-height 1.5

  &[data-kind="info"]
    background var(--box-blue-bg)
    color var(--box-blue-text)

  &[data-kind="warn"]
    background var(--box-amber-bg)
    color var(--box-amber-text)

  &[data-kind="error"]
    background var(--box-red-bg)
    color var(--box-red-text)

// ─── publish progress ───────────────────────────────────────
.ed-progress
  display flex
  flex-wrap wrap
  align-items center
  gap 8px
  flex-basis 100%
  padding 7px 10px
  border 1px solid var(--border-color)
  border-radius 10px
  background var(--background-color)
  font-size 0.72rem

.ed-stage
  position relative
  display inline-flex
  align-items center
  gap 6px
  padding 4px 10px
  border-radius 999px
  color var(--third-text-color)
  transition color $ed-morph, background $ed-morph

  & + .ed-stage::before
    content ""
    position absolute
    left -8px
    width 8px
    height 1px
    background var(--border-color)

  &[data-state="live"]
    background var(--box-blue-bg)
    color var(--box-blue-text)

    i
      animation ed-breathe 1.4s ease-in-out infinite

  &[data-state="done"]
    background var(--box-green-bg)
    color var(--box-green-text)

  &[data-state="fail"]
    background var(--box-red-bg)
    color var(--box-red-text)

.ed-stage-link
  margin-left auto
  color var(--link-color)
  font-size 0.72rem

// ─── toolbar ────────────────────────────────────────────────
// Genuinely floating over live content, so one of the three surfaces that earns
// a compositor layer. Fixed rather than sticky: it belongs to the session, not
// to a scroll container, and the article no longer has one to stick inside.
.ed-toolbar
  position fixed
  // Below the document bar's pinned band. `--ed-docbar-h` is that bar's measured
  // height, republished by a ResizeObserver, so this clears it however it wraps.
  top unquote(s('calc(%s + var(--ed-docbar-h, 0px))', $ed-docbar-top + 12px))
  left 50%
  z-index $z-index-4
  transform translateX(-50%)
  pointer-events none
  transition top $ed-morph

  +redefine-tablet()
    top auto
    bottom 16px

.ed-toolbar-inner
  display flex
  align-items center
  gap 2px
  padding 5px 7px
  border 1px solid var(--border-color)
  border-radius 999px
  background var(--third-background-color-transparent)
  backdrop-filter saturate(180%) blur(14px)
  -webkit-backdrop-filter saturate(180%) blur(14px)
  box-shadow 0 6px 22px -12px var(--shadow-color-1)
  pointer-events auto
  overflow hidden

.ed-toolbar-face
  display flex
  align-items center
  gap 2px

  &[hidden]
    display none

.ed-tool
  display grid
  place-items center
  width 30px
  height 30px
  border none
  border-radius 8px
  background transparent
  color var(--second-text-color)
  font-size 0.82rem
  cursor pointer
  transition background $ed-fade, color $ed-fade, transform 0.18s ease

  &:hover
    background var(--second-background-color)
    color var(--first-text-color)
    transform translateY(-1px)

  &[data-on="1"]
    background var(--primary-color)
    color $ed-on-primary

.ed-tool-sep
  width 1px
  height 18px
  margin 0 4px
  background var(--border-color)

// ─── block shell ────────────────────────────────────────────
// No padding, no margin, no background: the wrapper must be dimensionally
// invisible, or every line in the editor breaks somewhere the published post
// does not.
.ed-block
  position relative
  transition background $ed-fade, opacity $ed-fade

  &:hover > .ed-gutter,
  &[data-on="1"] > .ed-gutter
    opacity 1
    transform none

  // The block being carried. It stays legible — you are aiming it at a gap, and
  // a ghost you cannot read is a gap you cannot aim at.
  &.is-dragging
    opacity 0.45

  &[data-drop="before"]::before,
  &[data-drop="after"]::after
    content ""
    position absolute
    left 0
    right 0
    height 3px
    border-radius 3px
    background var(--primary-color)
    box-shadow 0 0 0 3px var(--background-color), 0 0 12px -1px var(--primary-color)
    animation ed-drop-in 0.18s cubic-bezier(0.32, 0.72, 0, 1)

  &[data-drop="before"]::before
    top -4px

  &[data-drop="after"]::after
    bottom -4px

// The article zeroes the top margin of its first child. With blocks that child
// is a wrapper, so the rule has to reach one level further in — otherwise the
// body starts a line lower here than it will once published.
.article-content > .ed-block:first-child .ed-body > *
  margin-top 0 !important

// The carried block keeps its own handle lit — hover is not a thing you can do
// with a button already held down. Every OTHER gutter stays hidden: they are not
// targets, and a column of buttons lighting up as you pass is noise over the one
// line you are actually aiming at.
.ed-block.is-dragging > .ed-gutter
  opacity 1
  transform none

// The gutter rides in the article's own left padding, never in the measure:
// pushing the text across would mean the line breaks you are editing are not
// the line breaks you will publish.
// Anchored off the block's own left edge rather than a hardcoded offset, so the
// column stays in the padding whatever the buttons measure.
.ed-gutter
  position absolute
  top 1px
  right 100%
  margin-right 3px
  display flex
  flex-direction column
  gap 3px
  opacity 0
  transform translateX(4px)
  transition opacity $ed-fade, transform $ed-morph

  +redefine-tablet()
    position static
    flex-direction row
    margin 0 0 5px
    opacity 1
    transform none

// A control you cannot find is a control you do not have. These sit on the
// article's own surface with the site's flat elevation ring under them, rather
// than on --second-background-color, which is two per cent off the card they
// were drawn on and read as nothing at all.
.ed-gutter-btn
  display grid
  place-items center
  width 26px
  height 26px
  border 1px solid var(--border-color)
  border-radius 8px
  background var(--background-color)
  box-shadow var(--redefine-box-shadow-flat)
  color var(--second-text-color)
  font-size 0.74rem
  cursor pointer
  transition background $ed-fade, color $ed-fade, border-color $ed-fade, transform 0.18s ease

  &:hover
    border-color var(--primary-color)
    background var(--primary-color)
    color $ed-on-primary
    transform translateY(-1px)

.ed-handle
  cursor grab

  // Held down, the handle stays lit for the whole drag — the pointer has left
  // the button by then, so :hover is gone exactly when the feedback matters.
  &:active,
  .ed-block.is-dragging &
    border-color var(--primary-color)
    background var(--primary-color)
    color $ed-on-primary
    cursor grabbing

// ─── rich text ──────────────────────────────────────────────
.ed-rich
  outline none
  border-radius 6px
  transition box-shadow $ed-fade

  &:focus
    box-shadow 0 0 0 2px var(--third-background-color)

  &:empty::before,
  &[data-placeholder]:empty::before
    content attr(data-placeholder)
    color var(--third-text-color)
    pointer-events none

  mark
    padding 0 2px
    border-radius 3px
    background var(--box-amber-bg)
    color var(--box-amber-text)

// `<mark>` is written as inline HTML rather than as invented markdown, so it
// has to look right in the PUBLISHED article too.
.markdown-body mark
  padding 0 2px
  border-radius 3px
  background var(--box-amber-bg)
  color var(--box-amber-text)

// ─── source blocks ──────────────────────────────────────────
.ed-source-block
  position relative
  margin 1rem 0
  border 1px solid var(--border-color)
  border-radius 12px
  overflow hidden
  transition border-color $ed-fade

  &:hover
    border-color var(--primary-color)

  &[data-mode="preview"] .ed-source
    display none

  &[data-mode="source"] .ed-preview
    display none

.ed-source-bar
  display flex
  align-items center
  gap 8px
  padding 6px 10px
  border-bottom 1px solid var(--border-color)
  background var(--second-background-color)

.ed-chip
  display inline-flex
  align-items center
  gap 5px
  font-size 0.68rem
  font-weight 600
  letter-spacing 0.03em
  text-transform uppercase
  color var(--third-text-color)

.ed-lang,
.ed-component-args,
.ed-component-title
  flex 1 1 auto
  min-width 0
  padding 3px 7px
  border 1px solid transparent
  border-radius 7px
  background transparent
  color var(--second-text-color)
  font-size 0.74rem
  outline none
  transition border-color $ed-fade, background $ed-fade

  &:focus
    border-color var(--border-color)
    background var(--background-color)

.ed-source-toggle,
.ed-component-remove
  display grid
  place-items center
  flex-shrink 0
  width 26px
  height 26px
  margin-left auto
  border none
  border-radius 7px
  background transparent
  color var(--third-text-color)
  font-size 0.74rem
  cursor pointer
  transition background $ed-fade, color $ed-fade

  &:hover
    background var(--third-background-color)
    color var(--second-text-color)

.ed-component-remove
  margin-left 0

  &:hover
    color var(--box-red-text)

.ed-source
  display block
  width 100%
  min-height 4.5em
  padding 12px 14px
  border none
  background var(--background-color)
  color var(--first-text-color)
  font-family $ed-mono
  font-size 0.82rem
  line-height 1.6
  resize none
  outline none

.ed-preview
  padding 12px 14px
  cursor text
  min-height 2.4em

  > *:first-child
    margin-top 0

  > *:last-child
    margin-bottom 0

  figure.highlight
    margin 0

.ed-math-block
  display flex
  justify-content center
  min-height 1.6em

.ed-math-error
  color var(--box-red-text)
  font-family $ed-mono
  font-size 0.8rem

.ed-mermaid-error
  color var(--box-red-text)
  font-family $ed-mono
  font-size 0.78rem
  white-space pre-wrap

.ed-math-inline
  padding 0 1px
  border-bottom 1px dotted var(--fourth-text-color)

// ─── image ──────────────────────────────────────────────────
.ed-figure-block
  margin 1.4rem 0

.ed-image-frame
  position relative
  border-radius 12px
  overflow hidden

  img
    display block
    width 100%
    height auto

  &:hover .ed-image-tools
    opacity 1
    transform none

.ed-image-tools
  position absolute
  top 10px
  right 10px
  display flex
  gap 4px
  padding 4px
  border-radius 10px
  background var(--third-background-color-transparent)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  opacity 0
  transform translateY(-4px)
  transition opacity $ed-fade, transform $ed-morph

  button
    display grid
    place-items center
    width 26px
    height 26px
    border none
    border-radius 7px
    background transparent
    color var(--second-text-color)
    font-size 0.74rem
    cursor pointer
    transition background $ed-fade

    &:hover
      background var(--background-color)

    &[data-act="remove"]:hover
      color var(--box-red-text)

.ed-image-missing
  display grid
  place-items center
  min-height 140px
  background var(--second-background-color)
  color var(--third-text-color)
  font-size 22px

.ed-caption
  margin-top 6px
  outline none
  font-size 0.78rem
  text-align center
  color var(--third-text-color)

  &:empty::before
    content attr(data-placeholder)
    color var(--third-text-color)

// ─── table ──────────────────────────────────────────────────
.ed-table-block
  margin 1.2rem 0
  border 1px solid var(--border-color)
  border-radius 12px
  overflow hidden

  table
    margin 0

  th, td
    outline none

    &:focus
      box-shadow inset 0 0 0 2px var(--primary-color)

.ed-table-bar
  display flex
  flex-wrap wrap
  align-items center
  gap 6px
  padding 6px 10px
  border-bottom 1px solid var(--border-color)
  background var(--second-background-color)

  button
    display inline-flex
    align-items center
    gap 4px
    padding 3px 8px
    border 1px solid var(--border-color)
    border-radius 7px
    background var(--background-color)
    color var(--third-text-color)
    font-size 0.68rem
    cursor pointer
    transition background $ed-fade, color $ed-fade

    &:hover
      background var(--third-background-color)
      color var(--second-text-color)

.ed-table-align
  display inline-flex
  gap 2px
  margin-right 4px

  button
    padding 3px 6px

// ─── components ─────────────────────────────────────────────
.ed-component
  position relative
  margin 1.2rem 0
  border 1px dashed transparent
  border-radius 12px
  transition border-color $ed-fade

  &:hover
    border-color var(--border-color)

  &:hover .ed-component-bar
    opacity 1
    transform none

  &[data-mode="preview"] .ed-source
    display none

  &[data-mode="source"] .ed-preview
    display none

.ed-component-bar
  display flex
  align-items center
  gap 8px
  padding 5px 8px
  border-bottom 1px solid var(--border-color)
  background var(--second-background-color)
  border-radius 11px 11px 0 0
  opacity 0.35
  transform translateY(-2px)
  transition opacity $ed-fade, transform $ed-morph

.ed-component-render
  padding 4px

  > *:first-child
    margin-top 0

  > *:last-child
    margin-bottom 0

.ed-swatches
  display flex
  gap 3px

.ed-swatch
  display grid
  place-items center
  width 20px
  height 20px
  padding 0
  border 1px solid transparent
  border-radius 6px
  background transparent
  cursor pointer
  transition border-color $ed-fade, transform 0.18s ease

  &:hover
    transform translateY(-1px)

  &[data-on="1"]
    border-color var(--primary-color)

.ed-swatch-dot
  display block
  width 11px
  height 11px
  border-radius 4px

.ed-icon-btn
  display grid
  place-items center
  width 24px
  height 24px
  border 1px solid var(--border-color)
  border-radius 7px
  background var(--background-color)
  color var(--second-text-color)
  font-size 0.72rem
  cursor pointer
  transition background $ed-fade

  &:hover
    background var(--third-background-color)

.ed-unknown
  border 1px solid var(--border-color)
  border-radius 10px
  overflow hidden

  pre
    margin 0
    padding 10px 12px
    background var(--second-background-color)
    font-size 0.76rem
    white-space pre-wrap

.ed-unknown-tag
  display flex
  align-items center
  gap 6px
  padding 5px 10px
  background var(--third-background-color)
  font-size 0.68rem
  font-weight 600
  text-transform uppercase
  letter-spacing 0.03em
  color var(--third-text-color)

.ed-raw-render
  font-size 0.9em

// A `<style>` or `<script>` block is shown, never injected: rendering one would
// apply the post's own rules to the workspace around it.
.ed-raw-source
  margin 0
  padding 10px 12px
  border-left 3px solid var(--box-amber-text)
  border-radius 0 8px 8px 0
  background var(--second-background-color)
  color var(--third-text-color)
  font-family $ed-mono
  font-size 0.76rem
  line-height 1.55
  white-space pre-wrap
  overflow-x auto

.ed-rule
  padding 8px 0

// ─── slash menu & popovers ──────────────────────────────────
.ed-slash,
.ed-more-menu,
.ed-icon-picker
  position absolute
  z-index ($z-index-5 + 1)
  padding 6px
  border 1px solid var(--border-color)
  border-radius 12px
  background var(--third-background-color-transparent)
  backdrop-filter saturate(180%) blur(16px)
  -webkit-backdrop-filter saturate(180%) blur(16px)
  box-shadow 0 12px 34px -16px var(--shadow-color-1)

.ed-slash
  width 232px
  max-height 302px
  overflow-y auto

.ed-slash-row,
.ed-more-menu button
  display flex
  align-items center
  gap 9px
  width 100%
  padding 7px 9px
  border none
  border-radius 8px
  background transparent
  color var(--second-text-color)
  font-size 0.8rem
  text-align left
  cursor pointer
  transition background $ed-fade

  i
    width 15px
    color var(--third-text-color)
    font-size 0.78rem
    text-align center

  &:hover,
  &[data-on="1"]
    background var(--second-background-color)

  &[data-on="1"] i
    color var(--primary-color)

.ed-more-menu
  width 216px

.ed-slash-empty
  padding 14px 10px
  color var(--third-text-color)
  font-size 0.78rem
  text-align center

.ed-icon-picker
  display grid
  grid-template-columns repeat(6, 28px)
  gap 2px

  button
    display grid
    place-items center
    width 28px
    height 28px
    border 1px solid transparent
    border-radius 7px
    background transparent
    color var(--second-text-color)
    cursor pointer
    transition background $ed-fade, border-color $ed-fade

    &:hover
      background var(--second-background-color)

    &[data-on="1"]
      border-color var(--primary-color)

// ─── the console's link into here ───────────────────────────
.bm-write
  display inline-flex
  align-items center
  gap 7px
  margin-top 12px
  padding 7px 13px
  border 1px solid transparent
  border-radius 10px
  background var(--primary-color)
  color $ed-on-primary
  font-size 0.8rem
  font-weight 550
  transition transform $ed-morph, filter $ed-fade

  &:hover
    transform translateY(-1px)
    filter brightness(1.08)

// ─── the draft ribbon on a superseded tile ──────────────────
.vault-draft
  position relative

.vault-draft-ribbon
  position absolute
  top 10px
  left 10px
  z-index 2
  display inline-flex
  align-items center
  gap 5px
  padding 3px 9px
  border-radius 999px
  background var(--box-amber-bg)
  color var(--box-amber-text)
  font-size 0.66rem
  font-weight 650
  letter-spacing 0.02em
  pointer-events none

.vault-archive-draft .vault-archive-lock
  color var(--box-amber-text)

@media (prefers-reduced-motion: reduce)
  .ed-block,
  .ed-act,
  .ed-tool,
  .ed-gutter,
  .ed-stage,
  .ed-component-bar
    transition none !important
