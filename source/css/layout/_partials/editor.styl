// ========================================================================================
//                                        EDITOR
// ========================================================================================
// The writing workspace at /blog-management/write/.
//
// Built from the management console's parts — same radii, same quiet buttons,
// same red confirm — because it is the same subsystem seen from the other side.
// The one thing it does NOT restyle is the canvas: that carries
// `.article-content.markdown-body`, so its type scale, its headings, its notes
// and its code blocks are the published article's, not a lookalike.
//
// Material: BASE tier throughout, except the three surfaces that genuinely float
// over live content — the toolbar, the slash menu and the two popovers. Those
// earn a backdrop-filter; nothing else does.
//
// Motion: 130ms fade / 280ms morph / cubic-bezier(0.32, 0.72, 0, 1), the
// console's own constants. Anything longer belongs in JS, where it can measure.
//
// Auto-included: style.styl requires layout/_partials/* as a glob.

$ed-gap = 12px
$ed-radius = 14px
$ed-morph = 0.28s cubic-bezier(0.32, 0.72, 0, 1)
$ed-fade = 0.13s ease
$ed-mono = 'Geist Mono Variable', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace
$ed-rail = 232px
$ed-inspector = 288px

// The editor takes the width the bento grid takes, and for the same reason: the
// reading measure applies to the canvas, not to the workspace around it.
.main-content.is-editor
  width 94%
  max-width 1560px

.ed
  display flex
  flex-direction column
  min-height 60vh
  padding-bottom 32px

  &[data-phase="loading"] .ed-shell,
  &[data-phase="denied"] .ed-shell,
  &[data-phase="error"] .ed-shell
    display none

  &[data-phase="ready"] .ed-gate
    display none

// ─── gate ───────────────────────────────────────────────────
.ed-gate
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 12px
  padding 72px 24px
  border 1px solid var(--border-color)
  border-radius $ed-radius
  color var(--third-text-color)
  text-align center

// ─── shell ──────────────────────────────────────────────────
.ed-shell
  display grid
  grid-template-columns $ed-rail minmax(0, 1fr) $ed-inspector
  gap 20px
  align-items start

  @media (max-width 1280px)
    grid-template-columns $ed-rail minmax(0, 1fr)

  +redefine-tablet()
    grid-template-columns minmax(0, 1fr)
    gap 14px

// ─── rail ───────────────────────────────────────────────────
.ed-rail
  position sticky
  top ($navbar-height + 16px)
  display flex
  flex-direction column
  gap 10px
  max-height s("calc(100vh - %s)", $navbar-height + 40px)

  +redefine-tablet()
    position static
    max-height none

.ed-rail-head
  display flex
  align-items center
  justify-content space-between
  gap 8px

  h2
    margin 0
    font-size 0.95rem
    font-weight 650
    letter-spacing -0.01em
    color var(--second-text-color)

.ed-new
  display grid
  place-items center
  width 28px
  height 28px
  border 1px solid var(--border-color)
  border-radius 9px
  background var(--second-background-color)
  color var(--primary-color)
  cursor pointer
  transition background $ed-fade, transform $ed-morph

  &:hover
    background var(--third-background-color)
    transform translateY(-1px)

.ed-filter
  width 100%
  padding 7px 10px
  border 1px solid var(--border-color)
  border-radius 10px
  background var(--second-background-color)
  color var(--first-text-color)
  font-size 0.82rem
  outline none
  transition border-color $ed-fade

  &:focus
    border-color var(--primary-color)

.ed-doc-list
  flex 1 1 auto
  margin 0
  padding 0
  overflow-y auto
  list-style none
  display flex
  flex-direction column
  gap 4px

  +redefine-tablet()
    max-height 40vh

.ed-doc
  display flex
  align-items center
  gap 9px
  padding 8px 10px
  border 1px solid transparent
  border-radius 10px
  cursor pointer
  transition background $ed-fade, border-color $ed-fade, transform $ed-morph

  &:hover
    background var(--second-background-color)
    transform translateX(2px)

  &[data-on="1"]
    border-color var(--border-color)
    background var(--third-background-color)

  &[data-draft="1"] .ed-doc-icon
    color var(--box-amber-text)

.ed-doc-icon
  flex-shrink 0
  width 18px
  font-size 0.8rem
  color var(--third-text-color)
  text-align center

.ed-doc-text
  min-width 0
  display flex
  flex-direction column

  strong
    overflow hidden
    font-size 0.82rem
    font-weight 550
    line-height 1.35
    white-space nowrap
    text-overflow ellipsis
    color var(--second-text-color)

  small
    font-size 0.68rem
    color var(--fourth-text-color)

.ed-doc-blank
  padding 18px 10px
  color var(--fourth-text-color)
  font-size 0.78rem
  text-align center

.ed-rail-foot
  border-top 1px solid var(--border-color)
  padding-top 10px

  h3
    margin 0 0 6px
    font-size 0.72rem
    font-weight 650
    letter-spacing 0.04em
    text-transform uppercase
    color var(--fourth-text-color)

.ed-outline
  margin 0
  padding 0
  max-height 26vh
  overflow-y auto
  list-style none
  counter-reset none

  li
    padding 3px 0 3px 0
    font-size 0.76rem
    line-height 1.4
    color var(--third-text-color)
    cursor pointer
    transition color $ed-fade, transform $ed-morph

    &:hover
      color var(--primary-color)
      transform translateX(2px)

    &[data-level="3"]
      padding-left 12px

    &[data-level="4"],
    &[data-level="5"],
    &[data-level="6"]
      padding-left 24px

  span
    display block
    overflow hidden
    white-space nowrap
    text-overflow ellipsis

.ed-outline-blank
  color var(--fourth-text-color)
  cursor default !important

// ─── main ───────────────────────────────────────────────────
.ed-main
  position relative
  min-width 0
  display flex
  flex-direction column
  gap 10px

.ed-bar
  position sticky
  top ($navbar-height + 8px)
  z-index 3
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 10px 14px
  border 1px solid var(--border-color)
  border-radius $ed-radius
  background var(--second-background-color)

.ed-bar-title
  min-width 0
  display flex
  align-items center
  gap 8px

.ed-doc-name
  overflow hidden
  font-size 0.95rem
  font-weight 600
  white-space nowrap
  text-overflow ellipsis
  color var(--second-text-color)

.ed-badge
  display inline-flex
  align-items center
  gap 5px
  flex-shrink 0
  padding 2px 8px
  border-radius 999px
  font-size 0.66rem
  font-weight 600
  letter-spacing 0.02em

  i
    font-size 0.9em

.ed-badge-draft
  background var(--box-amber-bg)
  color var(--box-amber-text)

.ed-badge-vault
  background var(--box-blue-bg)
  color var(--box-blue-text)

.ed-bar-actions
  display flex
  align-items center
  gap 8px

.ed-status
  display grid
  place-items center
  width 22px
  height 22px
  font-size 0.78rem
  color var(--fourth-text-color)
  transition color $ed-fade

  &[data-state="typing"]
    color var(--box-amber-text)

    i
      animation ed-breathe 1.8s ease-in-out infinite

  &[data-state="saved"]
    color var(--box-green-text)

  &[data-state="error"]
    color var(--box-red-text)

@keyframes ed-breathe
  0%, 100%
    opacity 0.35
  50%
    opacity 1

.ed-save,
.ed-publish
  display inline-flex
  align-items center
  gap 7px
  padding 7px 13px
  border 1px solid var(--border-color)
  border-radius 10px
  background var(--background-color)
  color var(--second-text-color)
  font-size 0.8rem
  font-weight 550
  cursor pointer
  transition background $ed-fade, border-color $ed-fade, transform $ed-morph, opacity $ed-fade

  &:hover:not(:disabled)
    background var(--third-background-color)
    transform translateY(-1px)

  &:disabled
    opacity 0.4
    cursor default

.ed-publish
  border-color transparent
  background var(--primary-color)
  color var(--background-color)

  &:hover:not(:disabled)
    background var(--primary-color)
    filter brightness(1.08)

// ─── notice ─────────────────────────────────────────────────
.ed-notice
  display flex
  align-items flex-start
  gap 10px
  padding 11px 14px
  border-radius 12px
  font-size 0.8rem
  line-height 1.55

  p
    margin 4px 0 0
    opacity 0.85

  &[data-kind="warn"]
    background var(--box-amber-bg)
    color var(--box-amber-text)

  &[data-kind="error"]
    background var(--box-red-bg)
    color var(--box-red-text)

// ─── publish progress ───────────────────────────────────────
.ed-progress
  display flex
  flex-wrap wrap
  align-items center
  gap 8px
  padding 9px 12px
  border 1px solid var(--border-color)
  border-radius 12px
  background var(--second-background-color)
  font-size 0.74rem

.ed-stage
  position relative
  display inline-flex
  align-items center
  gap 6px
  padding 4px 10px
  border-radius 999px
  color var(--fourth-text-color)
  transition color $ed-morph, background $ed-morph

  & + .ed-stage::before
    content ""
    position absolute
    left -8px
    width 8px
    height 1px
    background var(--border-color)

  &[data-state="live"]
    background var(--box-blue-bg)
    color var(--box-blue-text)

    i
      animation ed-breathe 1.4s ease-in-out infinite

  &[data-state="done"]
    background var(--box-green-bg)
    color var(--box-green-text)

  &[data-state="fail"]
    background var(--box-red-bg)
    color var(--box-red-text)

.ed-stage-link
  margin-left auto
  color var(--link-color)
  font-size 0.72rem

// ─── toolbar ────────────────────────────────────────────────
// One of the three surfaces that genuinely floats over live content, so one of
// the three that earns a compositor layer.
.ed-toolbar
  position sticky
  top ($navbar-height + 68px)
  z-index 4
  display flex
  justify-content center
  pointer-events none

.ed-toolbar-inner
  display flex
  align-items center
  gap 2px
  padding 5px 7px
  border 1px solid var(--border-color)
  border-radius 999px
  background var(--third-background-color-transparent)
  backdrop-filter saturate(180%) blur(14px)
  -webkit-backdrop-filter saturate(180%) blur(14px)
  box-shadow 0 6px 22px -12px var(--shadow-color-1)
  pointer-events auto
  overflow hidden

.ed-toolbar-face
  display flex
  align-items center
  gap 2px

.ed-tool
  display grid
  place-items center
  width 30px
  height 30px
  border none
  border-radius 8px
  background transparent
  color var(--third-text-color)
  font-size 0.82rem
  cursor pointer
  transition background $ed-fade, color $ed-fade, transform 0.18s ease

  &:hover
    background var(--second-background-color)
    color var(--second-text-color)
    transform translateY(-1px)

  &[data-on="1"]
    background var(--primary-color)
    color var(--background-color)

.ed-tool-sep
  width 1px
  height 18px
  margin 0 4px
  background var(--border-color)

// ─── canvas ─────────────────────────────────────────────────
.ed-canvas-scroll
  position relative
  min-height 46vh

.ed-canvas
  padding 4px 0 40px

  &:empty
    display none

.ed-empty
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 12px
  padding 90px 24px
  border 1px dashed var(--border-color)
  border-radius $ed-radius
  color var(--fourth-text-color)
  text-align center

  i
    font-size 26px
    opacity 0.55

  p
    margin 0
    font-size 0.85rem

// ─── block shell ────────────────────────────────────────────
.ed-block
  position relative
  padding-left 4px
  border-radius 8px
  transition background $ed-fade

  &:hover > .ed-gutter,
  &[data-on="1"] > .ed-gutter
    opacity 1
    transform none

  &.is-dragging
    opacity 0.45

  &[data-drop="before"]::before,
  &[data-drop="after"]::after
    content ""
    position absolute
    left 0
    right 0
    height 2px
    border-radius 2px
    background var(--primary-color)

  &[data-drop="before"]::before
    top -3px

  &[data-drop="after"]::after
    bottom -3px

// The gutter sits OUTSIDE the measure so it never narrows the writing column.
.ed-gutter
  position absolute
  top 2px
  left -58px
  display flex
  gap 2px
  opacity 0
  transform translateX(4px)
  transition opacity $ed-fade, transform $ed-morph

  @media (max-width 1100px)
    left -34px
    flex-direction column

  +redefine-tablet()
    position static
    flex-direction row
    margin-bottom 4px
    opacity 1
    transform none

.ed-gutter-btn
  display grid
  place-items center
  width 24px
  height 24px
  border none
  border-radius 7px
  background transparent
  color var(--fourth-text-color)
  font-size 0.72rem
  cursor pointer
  transition background $ed-fade, color $ed-fade

  &:hover
    background var(--second-background-color)
    color var(--second-text-color)

.ed-handle
  cursor grab

  &:active
    cursor grabbing

// ─── rich text ──────────────────────────────────────────────
.ed-rich
  outline none
  border-radius 6px
  transition box-shadow $ed-fade

  &:focus
    box-shadow 0 0 0 2px var(--third-background-color)

  &:empty::before,
  &[data-placeholder]:empty::before
    content attr(data-placeholder)
    color var(--fourth-text-color)
    pointer-events none

  mark
    padding 0 2px
    border-radius 3px
    background var(--box-amber-bg)
    color var(--box-amber-text)

// `<mark>` is written as inline HTML rather than as invented markdown, so it
// has to look right in the PUBLISHED article too.
.markdown-body mark
  padding 0 2px
  border-radius 3px
  background var(--box-amber-bg)
  color var(--box-amber-text)

// ─── source blocks ──────────────────────────────────────────
.ed-source-block
  position relative
  margin 1rem 0
  border 1px solid var(--border-color)
  border-radius 12px
  overflow hidden
  transition border-color $ed-fade

  &:hover
    border-color var(--primary-color)

  &[data-mode="preview"] .ed-source
    display none

  &[data-mode="source"] .ed-preview
    display none

.ed-source-bar
  display flex
  align-items center
  gap 8px
  padding 6px 10px
  border-bottom 1px solid var(--border-color)
  background var(--second-background-color)

.ed-chip
  display inline-flex
  align-items center
  gap 5px
  font-size 0.68rem
  font-weight 600
  letter-spacing 0.03em
  text-transform uppercase
  color var(--fourth-text-color)

.ed-lang,
.ed-component-args,
.ed-component-title
  flex 1 1 auto
  min-width 0
  padding 3px 7px
  border 1px solid transparent
  border-radius 7px
  background transparent
  color var(--second-text-color)
  font-size 0.74rem
  outline none
  transition border-color $ed-fade, background $ed-fade

  &:focus
    border-color var(--border-color)
    background var(--background-color)

.ed-source-toggle,
.ed-component-remove
  display grid
  place-items center
  flex-shrink 0
  width 26px
  height 26px
  margin-left auto
  border none
  border-radius 7px
  background transparent
  color var(--fourth-text-color)
  font-size 0.74rem
  cursor pointer
  transition background $ed-fade, color $ed-fade

  &:hover
    background var(--third-background-color)
    color var(--second-text-color)

.ed-component-remove
  margin-left 0

  &:hover
    color var(--box-red-text)

.ed-source
  display block
  width 100%
  min-height 4.5em
  padding 12px 14px
  border none
  background var(--background-color)
  color var(--first-text-color)
  font-family $ed-mono
  font-size 0.82rem
  line-height 1.6
  resize none
  outline none

.ed-preview
  padding 12px 14px
  cursor text
  min-height 2.4em

  > *:first-child
    margin-top 0

  > *:last-child
    margin-bottom 0

  figure.highlight
    margin 0

.ed-math-block
  display flex
  justify-content center
  min-height 1.6em

.ed-math-error
  color var(--box-red-text)
  font-family $ed-mono
  font-size 0.8rem

.ed-mermaid-error
  color var(--box-red-text)
  font-family $ed-mono
  font-size 0.78rem
  white-space pre-wrap

.ed-math-inline
  padding 0 1px
  border-bottom 1px dotted var(--fourth-text-color)

// ─── image ──────────────────────────────────────────────────
.ed-figure-block
  margin 1.4rem 0

.ed-image-frame
  position relative
  border-radius 12px
  overflow hidden

  img
    display block
    width 100%
    height auto

  &:hover .ed-image-tools
    opacity 1
    transform none

.ed-image-tools
  position absolute
  top 10px
  right 10px
  display flex
  gap 4px
  padding 4px
  border-radius 10px
  background var(--third-background-color-transparent)
  backdrop-filter blur(12px)
  -webkit-backdrop-filter blur(12px)
  opacity 0
  transform translateY(-4px)
  transition opacity $ed-fade, transform $ed-morph

  button
    display grid
    place-items center
    width 26px
    height 26px
    border none
    border-radius 7px
    background transparent
    color var(--second-text-color)
    font-size 0.74rem
    cursor pointer
    transition background $ed-fade

    &:hover
      background var(--background-color)

    &[data-act="remove"]:hover
      color var(--box-red-text)

.ed-image-missing
  display grid
  place-items center
  min-height 140px
  background var(--second-background-color)
  color var(--fourth-text-color)
  font-size 22px

.ed-caption
  margin-top 6px
  outline none
  font-size 0.78rem
  text-align center
  color var(--third-text-color)

  &:empty::before
    content attr(data-placeholder)
    color var(--fourth-text-color)

// ─── table ──────────────────────────────────────────────────
.ed-table-block
  margin 1.2rem 0
  border 1px solid var(--border-color)
  border-radius 12px
  overflow hidden

  table
    margin 0

  th, td
    outline none

    &:focus
      box-shadow inset 0 0 0 2px var(--primary-color)

.ed-table-bar
  display flex
  flex-wrap wrap
  align-items center
  gap 6px
  padding 6px 10px
  border-bottom 1px solid var(--border-color)
  background var(--second-background-color)

  button
    display inline-flex
    align-items center
    gap 4px
    padding 3px 8px
    border 1px solid var(--border-color)
    border-radius 7px
    background var(--background-color)
    color var(--third-text-color)
    font-size 0.68rem
    cursor pointer
    transition background $ed-fade, color $ed-fade

    &:hover
      background var(--third-background-color)
      color var(--second-text-color)

.ed-table-align
  display inline-flex
  gap 2px
  margin-right 4px

  button
    padding 3px 6px

// ─── components ─────────────────────────────────────────────
.ed-component
  position relative
  margin 1.2rem 0
  border 1px dashed transparent
  border-radius 12px
  transition border-color $ed-fade

  &:hover
    border-color var(--border-color)

  &:hover .ed-component-bar
    opacity 1
    transform none

  &[data-mode="preview"] .ed-source
    display none

  &[data-mode="source"] .ed-preview
    display none

.ed-component-bar
  display flex
  align-items center
  gap 8px
  padding 5px 8px
  border-bottom 1px solid var(--border-color)
  background var(--second-background-color)
  border-radius 11px 11px 0 0
  opacity 0.35
  transform translateY(-2px)
  transition opacity $ed-fade, transform $ed-morph

.ed-component-render
  padding 4px

  > *:first-child
    margin-top 0

  > *:last-child
    margin-bottom 0

.ed-swatches
  display flex
  gap 3px

.ed-swatch
  display grid
  place-items center
  width 20px
  height 20px
  padding 0
  border 1px solid transparent
  border-radius 6px
  background transparent
  cursor pointer
  transition border-color $ed-fade, transform 0.18s ease

  &:hover
    transform translateY(-1px)

  &[data-on="1"]
    border-color var(--primary-color)

.ed-swatch-dot
  display block
  width 11px
  height 11px
  border-radius 4px

.ed-icon-btn
  display grid
  place-items center
  width 24px
  height 24px
  border 1px solid var(--border-color)
  border-radius 7px
  background var(--background-color)
  color var(--second-text-color)
  font-size 0.72rem
  cursor pointer
  transition background $ed-fade

  &:hover
    background var(--third-background-color)

.ed-unknown
  border 1px solid var(--border-color)
  border-radius 10px
  overflow hidden

  pre
    margin 0
    padding 10px 12px
    background var(--second-background-color)
    font-size 0.76rem
    white-space pre-wrap

.ed-unknown-tag
  display flex
  align-items center
  gap 6px
  padding 5px 10px
  background var(--third-background-color)
  font-size 0.68rem
  font-weight 600
  text-transform uppercase
  letter-spacing 0.03em
  color var(--fourth-text-color)

.ed-raw-render
  font-size 0.9em

// A `<style>` or `<script>` block is shown, never injected: rendering one would
// apply the post's own rules to the workspace around it.
.ed-raw-source
  margin 0
  padding 10px 12px
  border-left 3px solid var(--box-amber-text)
  border-radius 0 8px 8px 0
  background var(--second-background-color)
  color var(--third-text-color)
  font-family $ed-mono
  font-size 0.76rem
  line-height 1.55
  white-space pre-wrap
  overflow-x auto

.ed-rule
  padding 8px 0

// ─── slash menu & popovers ──────────────────────────────────
.ed-slash,
.ed-more-menu,
.ed-icon-picker
  position absolute
  z-index $z-index-5
  padding 6px
  border 1px solid var(--border-color)
  border-radius 12px
  background var(--third-background-color-transparent)
  backdrop-filter saturate(180%) blur(16px)
  -webkit-backdrop-filter saturate(180%) blur(16px)
  box-shadow 0 12px 34px -16px var(--shadow-color-1)

.ed-slash
  width 232px
  max-height 302px
  overflow-y auto

.ed-slash-row,
.ed-more-menu button
  display flex
  align-items center
  gap 9px
  width 100%
  padding 7px 9px
  border none
  border-radius 8px
  background transparent
  color var(--second-text-color)
  font-size 0.8rem
  text-align left
  cursor pointer
  transition background $ed-fade

  i
    width 15px
    color var(--fourth-text-color)
    font-size 0.78rem
    text-align center

  &:hover,
  &[data-on="1"]
    background var(--second-background-color)

  &[data-on="1"] i
    color var(--primary-color)

.ed-more-menu
  width 216px

.ed-slash-empty
  padding 14px 10px
  color var(--fourth-text-color)
  font-size 0.78rem
  text-align center

.ed-icon-picker
  display grid
  grid-template-columns repeat(6, 28px)
  gap 2px

  button
    display grid
    place-items center
    width 28px
    height 28px
    border 1px solid transparent
    border-radius 7px
    background transparent
    color var(--second-text-color)
    cursor pointer
    transition background $ed-fade, border-color $ed-fade

    &:hover
      background var(--second-background-color)

    &[data-on="1"]
      border-color var(--primary-color)

// ─── inspector ──────────────────────────────────────────────
.ed-inspector
  position sticky
  top ($navbar-height + 16px)
  display flex
  flex-direction column
  gap 12px
  max-height s("calc(100vh - %s)", $navbar-height + 40px)
  padding 14px
  border 1px solid var(--border-color)
  border-radius $ed-radius
  background var(--second-background-color)
  overflow-y auto

  @media (max-width 1280px)
    position static
    grid-column 1 / -1
    max-height none

.ed-inspector-title
  margin 0
  font-size 0.95rem
  font-weight 650
  color var(--second-text-color)

.ed-fields
  display flex
  flex-direction column
  gap 10px

.ed-field
  display flex
  flex-direction column
  gap 4px

  > span
    font-size 0.7rem
    font-weight 600
    letter-spacing 0.03em
    text-transform uppercase
    color var(--fourth-text-color)

  input[type="text"],
  input:not([type]),
  textarea
    width 100%
    padding 6px 9px
    border 1px solid var(--border-color)
    border-radius 9px
    background var(--background-color)
    color var(--first-text-color)
    font-size 0.8rem
    outline none
    resize vertical
    transition border-color $ed-fade

    &:focus
      border-color var(--primary-color)

.ed-field-toggle
  flex-direction row
  align-items center
  justify-content space-between

.ed-field-row
  display flex
  gap 6px

  button
    display grid
    place-items center
    flex-shrink 0
    width 30px
    border 1px solid var(--border-color)
    border-radius 9px
    background var(--background-color)
    color var(--second-text-color)
    cursor pointer
    transition background $ed-fade

    &:hover
      background var(--third-background-color)

.ed-front-raw
  summary
    font-size 0.72rem
    color var(--fourth-text-color)
    cursor pointer

  textarea
    width 100%
    min-height 160px
    margin-top 8px
    padding 8px 10px
    border 1px solid var(--border-color)
    border-radius 9px
    background var(--background-color)
    color var(--first-text-color)
    font-family $ed-mono
    font-size 0.74rem
    line-height 1.55
    outline none
    resize vertical

// ─── the console's link into here ───────────────────────────
.bm-write
  display inline-flex
  align-items center
  gap 7px
  margin-top 12px
  padding 7px 13px
  border 1px solid transparent
  border-radius 10px
  background var(--primary-color)
  color var(--background-color)
  font-size 0.8rem
  font-weight 550
  transition transform $ed-morph, filter $ed-fade

  &:hover
    transform translateY(-1px)
    filter brightness(1.08)

// ─── the draft ribbon on a superseded tile ──────────────────
.vault-draft
  position relative

.vault-draft-ribbon
  position absolute
  top 10px
  left 10px
  z-index 2
  display inline-flex
  align-items center
  gap 5px
  padding 3px 9px
  border-radius 999px
  background var(--box-amber-bg)
  color var(--box-amber-text)
  font-size 0.66rem
  font-weight 650
  letter-spacing 0.02em
  pointer-events none

.vault-archive-draft .vault-archive-lock
  color var(--box-amber-text)

@media (prefers-reduced-motion: reduce)
  .ed-block,
  .ed-doc,
  .ed-tool,
  .ed-gutter,
  .ed-stage,
  .ed-component-bar
    transition none !important
