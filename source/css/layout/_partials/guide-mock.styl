// ========================================================================================
//                                      GUIDE — MOCKS
// ========================================================================================
// What the follow walkthrough is acted out on (source/js/plugins/guide/mock):
// the blog under its own stylesheet, four devices, and GitHub's pages. Every size
// here is a device pixel; the scene's camera scales the whole world at once.
//
// The devices draw their systems' own materials — frosted Apple bars, Windows
// Mica — because they are pictures of those systems, not surfaces of the blog.
//
// Auto-included: style.styl requires layout/_partials/* as a glob.

$gd-sys = -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif
$gd-win = 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif
$gd-and = 'Google Sans', Roboto, system-ui, sans-serif
$gd-gh = -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif

// ─── shared ─────────────────────────────────────────────────
.gd-page
  position relative
  overflow hidden

// An app icon's tile. Apple's artwork carries its own rounded corners; the tile
// cuts the blog's own icon to the same shape.
.gd-app
  display block
  flex none
  width 60px
  height 60px
  overflow hidden
  border-radius 22%

  > .gd-appimg, > svg, > .gd-blogicon
    display block
    width 100%
    height 100%
    border-radius 0

.gd-appimg
  display block
  max-width none
  user-select none
  -webkit-user-drag none

// The blog's icon as the site ships it, transparent corners and all.
.gd-blogicon
  display inline-block
  flex none
  border-radius 23%
  background-position center
  background-repeat no-repeat
  background-size contain

  &.is-empty
    background-color var(--primary-color)

// One browser, two pages: `.is-b` is having followed the link.
.gd-swap
  position relative
  width 100%
  height 100%

.gd-swap-a, .gd-swap-b
  position absolute
  inset 0
  transition opacity 0.35s ease, visibility 0.35s

.gd-swap-b, .gd-swap.is-b .gd-swap-a
  opacity 0
  visibility hidden

.gd-swap.is-b .gd-swap-b
  opacity 1
  visibility visible

// Apple's frosted controls.
.gd-glass
  border 1px solid rgba(255, 255, 255, 0.6)
  background rgba(250, 250, 252, 0.74)
  color #1d1d1f
  box-shadow 0 6px 24px rgba(0, 0, 0, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.8)
  -webkit-backdrop-filter blur(16px) saturate(1.7)
  backdrop-filter blur(16px) saturate(1.7)

.dark .gd-glass
  border-color rgba(255, 255, 255, 0.12)
  background rgba(44, 44, 48, 0.7)
  color #f5f5f7
  box-shadow 0 6px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08)


// ========================================================================================
//                                        THE BLOG
// ========================================================================================
// Real markup, real classes. Media queries answer for the reader's own screen,
// so what switches with the screen is pinned here for the device in the mock,
// and rem sizes are restated against --gd-rem, the root size that device has.
// The navbar's two measured switches are measured again at the mock's width
// and set on .gd-site (mock/site.js `fit`).
.gd-site
  position relative
  overflow hidden
  background var(--background-color)
  color var(--default-text-color)
  font-family $default-font-family
  font-size var(--gd-rem)
  line-height 1.5
  text-align left

  .page-container
    position absolute
    inset 0
    overflow hidden

  // The banner's background is fixed and screen-sized on the page; here it is
  // the page area's.
  .home-banner-background
    position absolute !important
    top 0 !important
    left 0 !important
    width 100% !important
    height var(--gd-vh) !important

  .home-banner-container
    width 100%
    min-height var(--gd-vh)
    background none

    // On the page the title is as wide as the screen (w-screen) and the row of
    // buttons under it is as wide as that; here both are the page area's.
    .content
      width 100%
      min-height unquote('calc(var(--gd-vh) * 0.9)')

    .description
      width 100% !important

.gd-site-head
  position absolute
  top 0
  left 0
  right 0
  z-index 5

  .navbar-container
    height 100%

// The bell and the Follow button: one slot, chosen by the mock, not by <html>,
// in whichever row the mock's navbar shows.
.gd-site .notifications-bell, .gd-site .navbar-follow
  display none !important

.gd-site.is-desk:not(.navbar-collapsed)[data-follow="1"] .desktop .notifications-bell, .gd-site.navbar-collapsed[data-follow="1"] .mobile .notifications-bell
  display flex !important

.gd-site.is-desk:not(.navbar-collapsed)[data-follow="0"] .desktop .navbar-follow, .gd-site.navbar-collapsed[data-follow="0"] .mobile .navbar-follow
  display block !important

.gd-site .navbar-follow .follow-trigger
  font-size var(--gd-rem)

// Follow keeps its label unless the mock's own row is too narrow for it — not
// because the reader's navbar is.
.gd-site:not(.navbar-follow-compact) .mobile .navbar-follow .follow-trigger
  width auto
  height auto
  padding 5px 12px
  border-radius $redefine-border-radius-small
  font-size var(--gd-rem)

  .follow-label
    display inline

// The inbox, in place of its fixed position on the page. Its one page is sized
// by what is in it, and past the panel's ceiling the list gives way, never the
// foot: every box on the way down may shrink.
.gd-site .notifications-mask
  position absolute
  inset 0
  z-index 4

.gd-site .notifications-panel
  position absolute
  z-index 6
  transition opacity 0.22s ease, transform 0.32s cubic-bezier(0.34, 1.2, 0.64, 1), visibility 0.32s

.gd-site .np-viewport, .gd-site .np-page
  display flex
  flex 0 1 auto
  flex-direction column
  min-height 0
  height auto

.gd-site .np-viewport
  transition none

.gd-site .np-page
  position relative
  visibility visible
  transform none

.gd-site .np-scroll
  flex 0 1 auto

.gd-site .np-foot
  flex none

.gd-site .np-head .np-title
  font-size unquote('calc(0.95 * var(--gd-rem))')

.gd-site .np-head .np-mark-read
  font-size unquote('calc(0.78 * var(--gd-rem))')

.gd-site .np-item-title
  font-size unquote('calc(0.875 * var(--gd-rem))')

.gd-site .np-item-body
  font-size unquote('calc(0.8 * var(--gd-rem))')

.gd-site .np-item-time
  font-size unquote('calc(0.72 * var(--gd-rem))')

.gd-site .np-action
  font-size unquote('calc(0.85 * var(--gd-rem))')

// ─── a desktop screen ───────────────────────────────────────
.gd-site.is-desk
  .gd-site-head
    height 70px

  .navbar-container
    padding-left 48px
    padding-right 48px

  .navbar-container .navbar-content .left .logo-image
    width 40px
    height 40px

  .navbar-container .navbar-content .left .logo-title, .navbar-container .navbar-content .left .logo-title h1
    font-size unquote('calc(1.7 * var(--gd-rem))')

  .home-banner-background
    transform scale(1.1)

  .home-banner-container .content .description
    font-size unquote('calc(2.8 * var(--gd-rem))')

  .home-banner-bottom
    padding-left 48px
    padding-right 48px

  // A desktop's inbox opens without dimming the page.
  .notifications-mask.is-open
    background transparent

  .notifications-panel
    top 76px
    right 24px
    bottom auto
    left auto
    width 440px
    max-width unquote('calc(100% - 32px)')
    max-height 80%
    border-radius 16px
    border-bottom 1px solid var(--border-color)
    transform translateY(-8px) scale(0.98)
    transform-origin top right

  .notifications-panel.is-open
    transform none

.gd-site.is-desk:not(.navbar-collapsed)
  .navbar-container .navbar-content .right .desktop .navbar-list
    display flex

  .navbar-container .navbar-content .right .desktop .navbar-list .navbar-item
    font-size var(--gd-rem)

  .navbar-container .navbar-content .right .desktop .navbar-list .navbar-item.notifications-bell, .navbar-container .navbar-content .right .desktop .navbar-list .navbar-item.search
    font-size unquote('calc(1.5 * var(--gd-rem))')

  .navbar-container .navbar-content .right .mobile .icon-item
    display none

// ─── a phone ────────────────────────────────────────────────
.gd-site.is-phone
  .gd-site-head
    height 56px

  .navbar-container
    padding-left 24px
    padding-right 24px

  .navbar-container .navbar-content .left .logo-image
    width 32px
    height 32px

  .navbar-container .navbar-content .left .logo-title, .navbar-container .navbar-content .left .logo-title h1
    font-size unquote('calc(1.36 * var(--gd-rem))')

  .navbar-container .navbar-content .right .mobile .icon-item
    display flex
    justify-content center
    align-items center

  .home-banner-background
    transform scale(1.25)

  .home-banner-container .content .description
    font-size unquote('calc(2.52 * var(--gd-rem))')

  .home-banner-bottom
    padding-left 32px
    padding-right 32px

  .notifications-mask.is-open
    background rgba(0, 0, 0, 0.28)

  .notifications-panel
    top auto
    right 0
    bottom 0
    left 0
    width 100%
    max-width 100%
    max-height 82%
    border-radius 16px 16px 0 0
    border-bottom none
    transform translateY(16px)
    transform-origin bottom center

  .notifications-panel.is-open
    transform none

.gd-site .home-banner-container .content .description p i
  font-size unquote('calc(1.4 * var(--gd-rem))')

// ========================================================================================
//                                         DESKTOPS
// ========================================================================================
.gd-desk
  position absolute
  inset 0
  overflow hidden
  color #1d1d1f
  font-family $gd-sys
  font-size 13px

// The systems' own wallpapers (images/guide), cropped to the screen.
.gd-wall
  position absolute
  inset 0
  background-position center
  background-repeat no-repeat
  background-size cover

.gd-desk.is-mac .gd-wall
  background-color #7a2fd0
  background-image url('../images/guide/wall-macos.avif')

.gd-desk.is-win .gd-wall
  background-color #12081f
  background-image url('../images/guide/wall-windows.avif')

.gd-lights
  display flex
  flex none
  gap 8px
  margin-right 6px

  i
    width 12px
    height 12px
    border-radius 50%
    background #ff5f57
    box-shadow inset 0 0 0 0.5px rgba(0, 0, 0, 0.18)

    &:nth-child(2)
      background #febc2e

    &:nth-child(3)
      background #28c840

// ─── macOS ──────────────────────────────────────────────────
.gd-mac-bar
  position absolute
  top 0
  left 0
  right 0
  z-index 3
  display flex
  align-items center
  justify-content space-between
  height 25px
  padding 0 14px
  background rgba(246, 246, 246, 0.55)
  color #1d1d1f
  font-size 13px
  -webkit-backdrop-filter blur(20px) saturate(1.8)
  backdrop-filter blur(20px) saturate(1.8)

  i
    font-size 13px

.gd-mac-menus
  display flex
  align-items center
  gap 18px

  > i
    font-size 15px

.gd-mac-m
  margin 0 -6px
  padding 1px 6px
  border-radius 5px

.gd-mac-status
  display flex
  align-items center
  gap 16px

.gd-desk.is-menu .gd-f-file
  background rgba(0, 0, 0, 0.14)

.dark .gd-mac-bar
  background rgba(30, 30, 32, 0.5)
  color #f5f5f7

.dark .gd-desk.is-menu .gd-f-file
  background rgba(255, 255, 255, 0.2)

// Safari's window; `is-app` is the same page opened from the Dock.
.gd-mw
  position absolute
  top 46px
  left 90px
  z-index 2
  display flex
  flex-direction column
  width 1100px
  height 654px
  overflow hidden
  border-radius 12px
  background #fff
  box-shadow 0 22px 70px rgba(0, 0, 0, 0.35), 0 0 0 0.5px rgba(0, 0, 0, 0.4)

  > .gd-page
    flex 1

.gd-mw-bar
  flex none
  display flex
  align-items center
  gap 12px
  height 52px
  padding 0 16px
  border-bottom 1px solid rgba(0, 0, 0, 0.1)
  background #f6f6f6
  color #6e6e73
  font-size 15px

.gd-mw-ic
  display grid
  place-items center
  width 28px
  height 28px
  border-radius 6px
  transition opacity 0.3s ease

  &.is-dim
    opacity 0.35

.gd-mw-addr
  display flex
  flex 0 1 560px
  align-items center
  justify-content center
  gap 7px
  height 32px
  margin 0 auto
  border-radius 9px
  background rgba(0, 0, 0, 0.06)
  color #1d1d1f
  font-size 14px
  transition background 0.3s ease

  i
    color #6e6e73
    font-size 11px

.gd-desk.is-app
  .gd-mw-addr
    background transparent
    font-weight 600

    i
      display none

  .gd-mw-ic
    opacity 0

.dark .gd-mw
  background #1e1e1e
  box-shadow 0 22px 70px rgba(0, 0, 0, 0.55), 0 0 0 0.5px rgba(255, 255, 255, 0.18)

.dark .gd-mw-bar
  border-bottom-color rgba(255, 255, 255, 0.08)
  background #2b2b2d
  color #98989d

.dark .gd-mw-addr
  background rgba(255, 255, 255, 0.1)
  color #f5f5f7

// The File menu, under the menu bar.
.gd-mac-menu
  position absolute
  top 26px
  left 108px
  z-index 4
  width 236px
  padding 5px
  border-radius 10px
  background rgba(242, 242, 242, 0.82)
  color #1d1d1f
  font-size 13px
  box-shadow 0 12px 40px rgba(0, 0, 0, 0.25), 0 0 0 0.5px rgba(0, 0, 0, 0.22)
  opacity 0
  visibility hidden
  -webkit-backdrop-filter blur(24px) saturate(1.8)
  backdrop-filter blur(24px) saturate(1.8)
  transition opacity 0.12s ease, visibility 0.12s

.gd-desk.is-menu .gd-mac-menu
  opacity 1
  visibility visible

.gd-mac-row
  display flex
  align-items center
  justify-content space-between
  height 22px
  padding 0 10px
  border-radius 5px

  kbd
    color #86868b
    font-family inherit
    font-size 13px

  &.gd-f-dock
    background #0a6cff
    color #fff

    kbd
      color rgba(255, 255, 255, 0.8)

.gd-mac-sep
  height 1px
  margin 5px 10px
  background rgba(0, 0, 0, 0.1)

.dark .gd-mac-menu
  background rgba(40, 40, 42, 0.82)
  color #f5f5f7
  box-shadow 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 0 0.5px rgba(255, 255, 255, 0.16)

.dark .gd-mac-sep
  background rgba(255, 255, 255, 0.12)

// A sheet dropping from Safari's toolbar: Add to Dock, and the permission prompt.
.gd-mac-sheet
  position absolute
  top 98px
  left 420px
  z-index 4
  width 440px
  padding 20px
  border-radius 12px
  background #ececec
  color #1d1d1f
  font-size 13px
  box-shadow 0 20px 60px rgba(0, 0, 0, 0.35), 0 0 0 0.5px rgba(0, 0, 0, 0.25)
  opacity 0
  visibility hidden
  transform translateY(-14px)
  transition opacity 0.25s ease, transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1), visibility 0.4s

.gd-desk.is-add .gd-mac-add, .gd-desk.is-ask .gd-mac-perm
  opacity 1
  visibility visible
  transform none

.gd-mac-add
  display grid
  grid-template-columns 64px 1fr
  gap 16px

  .gd-blogicon
    width 64px
    height 64px
    border-radius 14px

.gd-mac-add-main
  display flex
  flex-direction column
  gap 4px

  b
    margin-bottom 6px
    font-size 15px

  label
    color #6e6e73
    font-size 12px

  small
    color #6e6e73
    font-size 12px

.gd-mac-field
  display flex
  align-items center
  height 26px
  padding 0 8px
  border-radius 5px
  background #fff
  box-shadow 0 0 0 0.5px rgba(0, 0, 0, 0.25), 0 0 0 3.5px rgba(10, 108, 255, 0.35)

.gd-mac-btns
  grid-column unquote('1 / -1')
  display flex
  justify-content flex-end
  gap 10px
  margin-top 6px

.gd-mac-btn
  display inline-flex
  align-items center
  justify-content center
  min-width 76px
  height 24px
  padding 0 14px
  border-radius 6px
  background #fff
  font-size 13px
  box-shadow 0 0 0 0.5px rgba(0, 0, 0, 0.22), 0 1px 1px rgba(0, 0, 0, 0.08)

  &.is-default
    background linear-gradient(#3b95f6, #0a6cf0)
    color #fff

.gd-mac-perm
  text-align center

  b
    display block
    font-size 14px
    line-height 1.35

  p
    margin 6px 0 14px
    color #3a3a3c
    font-size 12px
    line-height 1.45

  .gd-mac-btns
    justify-content center

.gd-mac-perm-icon
  display grid
  place-items center
  width 52px
  height 52px
  margin 0 auto 10px
  border-radius 12px
  background linear-gradient(#ff5e57, #ff2d2d)
  color #fff
  font-size 26px

.dark .gd-mac-sheet
  background #323234
  color #f5f5f7
  box-shadow 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 0 0.5px rgba(255, 255, 255, 0.18)

.dark .gd-mac-field, .dark .gd-mac-btn
  background #5a5a5e
  color #f5f5f7

.dark .gd-mac-btn.is-default
  background linear-gradient(#3b95f6, #0a6cf0)
  color #fff

.dark .gd-mac-perm p
  color #c7c7cc

// The Dock; the blog's icon slides in when it is added.
.gd-dock
  position absolute
  bottom 6px
  left 50%
  z-index 3
  display flex
  align-items flex-end
  gap 6px
  padding 6px 8px 8px
  border 1px solid rgba(255, 255, 255, 0.35)
  border-radius 22px
  background rgba(255, 255, 255, 0.28)
  box-shadow 0 10px 30px rgba(0, 0, 0, 0.2)
  transform translateX(-50%)
  -webkit-backdrop-filter blur(20px) saturate(1.6)
  backdrop-filter blur(20px) saturate(1.6)

.gd-dock-i
  position relative
  flex none
  width 52px
  height 52px

  > svg, > .gd-appimg, > .gd-blogicon
    display block
    width 100%
    height 100%
    filter drop-shadow(0 1.5px 2px rgba(0, 0, 0, 0.22))

  > .gd-blogicon
    border-radius 22%

  &.is-bare > svg
    filter none

  &.is-run::after
    content ''
    position absolute
    bottom -6px
    left 50%
    width 4px
    height 4px
    margin-left -2px
    border-radius 50%
    background rgba(0, 0, 0, 0.6)

.gd-dock-sep
  width 1px
  height 44px
  margin 0 4px 4px
  background rgba(0, 0, 0, 0.18)

.gd-dock-new
  width 0
  margin 0 -3px
  opacity 0
  transform scale(0.4)
  transition width 0.45s cubic-bezier(0.2, 0.9, 0.3, 1), margin 0.45s ease, opacity 0.3s ease, transform 0.5s cubic-bezier(0.3, 1.5, 0.5, 1)

.gd-desk.is-docked .gd-dock-new
  width 52px
  margin 0
  opacity 1
  transform none

.gd-desk.is-app .gd-dock-new
  animation gd-bounce 0.7s ease 2

  &::after
    content ''
    position absolute
    bottom -6px
    left 50%
    width 4px
    height 4px
    margin-left -2px
    border-radius 50%
    background rgba(0, 0, 0, 0.6)

@keyframes gd-bounce
  0%, 100%
    transform none
  40%
    transform translateY(-16px)

// ─── Windows ────────────────────────────────────────────────
.gd-cw
  position absolute
  top 26px
  left 80px
  z-index 2
  display flex
  flex-direction column
  width 1120px
  height 682px
  overflow hidden
  border-radius 12px
  background #fff
  font-family $gd-win
  box-shadow 0 24px 64px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(0, 0, 0, 0.25)

  > .gd-page
    flex 1

.gd-cw-tabs
  flex none
  display flex
  align-items flex-end
  gap 2px
  height 40px
  padding-left 8px
  background #dfe3e8

.gd-cw-tab
  display flex
  align-items center
  gap 8px
  width 240px
  height 34px
  padding 0 10px 0 12px
  border-radius 10px 10px 0 0
  background #fff
  color #1f1f1f
  font-size 12px

  .gd-blogicon
    width 16px
    height 16px
    border-radius 0

  i
    color #5f6368
    font-size 12px

.gd-cw-title
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.gd-cw-new
  display grid
  place-items center
  width 28px
  height 28px
  margin 0 0 3px 4px
  border-radius 50%
  color #444
  font-size 13px

.gd-cw-ctl
  display flex
  align-self stretch
  margin-left auto

  i
    display grid
    place-items center
    width 46px
    color #1f1f1f
    font-size 13px

.gd-cw-bar
  flex none
  display flex
  align-items center
  gap 16px
  height 46px
  padding 0 14px
  border-bottom 1px solid rgba(0, 0, 0, 0.06)
  background #fff
  color #474747
  font-size 15px

  > i.is-dim
    opacity 0.35

  > i:last-child
    font-size 16px

.gd-omni
  display flex
  flex 1
  align-items center
  gap 12px
  height 34px
  padding 0 14px
  border-radius 17px
  background #edf0f5
  color #1f1f1f
  font-size 14px

  i
    color #474747
    font-size 13px

  .gd-url
    flex 1

.gd-cw-me
  width 26px
  height 26px
  border-radius 50%
  background linear-gradient(135deg, #f78736, #367df7)

.dark .gd-cw
  background #202124
  box-shadow 0 24px 64px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.12)

.dark .gd-cw-tabs
  background #202124

.dark .gd-cw-tab, .dark .gd-cw-bar
  background #35363a
  color #e8eaed

.dark .gd-cw-new, .dark .gd-cw-ctl i, .dark .gd-cw-bar, .dark .gd-cw-tab i
  color #e8eaed

.dark .gd-omni
  background #202124
  color #e8eaed

  i
    color #bdc1c6

// Chrome's permission bubble, under the address bar.
.gd-cperm
  position absolute
  top 110px
  left 196px
  z-index 4
  width 320px
  padding 16px 18px 14px
  border-radius 12px
  background #fff
  color #1f1f1f
  font-family $gd-win
  font-size 14px
  box-shadow 0 8px 28px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(0, 0, 0, 0.06)
  opacity 0
  visibility hidden
  transform translateY(-6px)
  transition opacity 0.2s ease, transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1), visibility 0.3s

  b
    display block
    margin-bottom 12px
    font-size 15px
    font-weight 500

  > span
    display flex
    align-items center
    gap 10px
    color #474747

.gd-desk.is-ask .gd-cperm
