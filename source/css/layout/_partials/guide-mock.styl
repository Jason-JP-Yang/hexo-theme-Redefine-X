.dark .gd-and-perm
  background #2b2930
  color #e6e1e5

.dark .gd-and-btns span
  color #a8c7fa

.dark .gd-and-btns .gd-f-allow
  background #a8c7fa
  color #062e6f


// ========================================================================================
//                                          GITHUB
// ========================================================================================
// Sizes are GitHub's own CSS pixels. A desktop page is laid out in the 1600px
// window the reference screenshots were taken in and scaled into the browser
// (`is-wide`, mock/github.js); a phone's is laid out at the phone's width.
.gd-gh
  position absolute
  inset 0
  overflow hidden
  background #fff
  color #1f2328
  font-family $gd-gh
  font-size 14px
  line-height 1.5

  a
    color #0969da
    text-decoration none

  label
    display block
    margin-bottom 8px
    font-size 14px
    font-weight 600

.gd-gh.is-wide
  right auto
  bottom auto
  width 1600px
  transform scale(var(--gd-ghs))
  transform-origin 0 0

.gd-gh.is-dark
  background #0d1117
  color #f0f6fc

  a
    color #4493f8

.gd-gh-col
  display flex
  flex-direction column
  width 340px
  margin 0 auto
  padding-top 28px

.gd-gh.is-narrow .gd-gh-col
  width auto
  margin 0 16px

// giscus's logo is its gem on white, as GitHub shows the app.
.gd-gh-giscus
  display block
  flex none
  background-color #fff
  background-image url('../images/guide/giscus.avif')
  background-position center
  background-repeat no-repeat
  background-size 66%

.gd-gh-logo
  align-self center
  width 88px
  height 88px
  border-radius 50%
  box-shadow 0 0 0 1px rgba(240, 246, 252, 0.1)

.gd-gh h1
  margin 14px 0 22px
  font-size 24px
  font-weight 300
  line-height 1.3
  letter-spacing -0.2px
  text-align center

  b
    font-weight 600

.gd-gh-input
  position relative
  display flex
  align-items center
  height 40px
  margin-bottom 16px
  padding 0 12px
  border 1px solid #d1d9e0
  border-radius 6px
  background #fff
  font-size 16px
  transition border-color 0.2s ease, box-shadow 0.2s ease

  &.is-focus
    border-color #0969da
    box-shadow inset 0 0 0 1px #0969da

.gd-gh-ph
  position absolute
  left 13px
  color #6e7781
  pointer-events none

.gd-val:not(:empty) ~ .gd-gh-ph
  display none

.gd-gh.is-dark .gd-gh-input
  border-color #3d444d
  background #0d1117

  &.is-focus
    border-color #1f6feb
    box-shadow inset 0 0 0 1px #1f6feb

.gd-caret
  display inline-block
  width 1px
  height 18px
  margin-left 1px
  background currentColor
  opacity 0

.is-focus .gd-caret
  animation gd-caret 1s steps(1) infinite

.gd-gh-label-row
  display flex
  align-items baseline
  justify-content space-between

  label
    margin-bottom 8px

.gd-gh-btn
  display flex
  align-items center
  justify-content center
  gap 8px
  height 40px
  margin-bottom 14px
  border 1px solid transparent
  border-radius 6px
  font-size 14px
  font-weight 500
  white-space nowrap

  svg
    width 16px
    height 16px

  i
    font-size 16px

  &.is-green
    border-color rgba(31, 35, 40, 0.15)
    background #1f883d
    color #fff
    font-weight 600

  &.is-alt
    border-color #d1d9e0
    background #f6f8fa
    color #25292e

  &.is-big
    height 44px
    font-size 15px

    i
      font-size 11px

.gd-gh.is-dark .gd-gh-btn
  &.is-green
    border-color rgba(240, 246, 252, 0.1)
    background #238636

  &.is-alt
    border-color #3d444d
    background #212830
    color #f0f6fc

.gd-gh-or
  display flex
  align-items center
  gap 14px
  margin 2px 0 18px
  color #59636e

  &::before, &::after
    content ''
    flex 1
    height 1px
    background #d1d9e0

.gd-gh.is-dark .gd-gh-or
  color #9198a1

  &::before, &::after
    background #3d444d

.gd-gh-new
  margin 10px 0 0
  text-align center

// ─── sign up ────────────────────────────────────────────────
.gd-gh-signup
  display flex

// GitHub's starfield under the offer, its three mascots rising out of the glow.
.gd-gh-space
  position relative
  flex 0 0 50%
  overflow hidden
  background-color #000
  background-image url('../images/guide/github-stars.avif')
  background-position center bottom
  background-repeat no-repeat
  background-size cover
  color #fff

.gd-gh-space-in
  position relative
  z-index 1
  width 434px
  margin 0 auto
  padding-top 4px

  h2
    margin 0
    font-size 32px
    font-weight 600
    line-height 1.25
    letter-spacing -0.4px

  p
    margin 18px 0 0
    font-size 16px
    line-height 1.5

  ul
    display flex
    flex-direction column
    gap 17px
    margin 17px 0 0
    padding 0
    list-style none

  li
    display flex
    gap 11px

    > i
      flex none
      width 14px
      margin-top 5px
      font-size 13px

    span
      display flex
      flex-direction column
      gap 2px
      font-size 16px
      line-height 1.4

    b
      font-weight 600

.gd-gh-incl
  display inline-flex
  align-items center
  gap 8px
  margin-top 16px
  font-size 16px
  font-weight 600

  i
    font-size 11px

.gd-gh-mascots
  position absolute
  left 7.25%
  bottom -144px
  width 83.6%
  aspect-ratio unquote('1194 / 841')
  background-image url('../images/guide/github-mascots.avif')
  background-repeat no-repeat
  background-size 100% 100%

.gd-gh-right
  position relative
  flex 1
  overflow hidden
  background #fff
  color #1f2328

// Spaced as the screenshot measures it, top to bottom.
.gd-gh-form
  width 476px
  margin 0 auto
  padding 8px 0 20px

  h1
    margin 0 0 32px
    font-size 24px
    font-weight 600
    line-height 1.5
    letter-spacing -0.2px
    text-align left

  .gd-gh-btn
    height 34px
    margin-bottom 8px

  .gd-gh-or
    margin 12px 0 15px

  label
    margin-bottom 4px

  .gd-gh-input
    margin-bottom 19px

  sup
    color #59636e
    font-size 12px

  small
    display block
    margin -14px 0 18px
    color #59636e
    font-size 12px
    line-height 1.5

  .gd-gh-btn.is-big
    height 45px
    margin 19px 0 0
    font-size 16px

.gd-gh-signup.is-narrow
  .gd-gh-right
    flex 1

  .gd-gh-form
    width auto
    margin 0 16px
    padding-top 18px

.gd-gh-select
  justify-content space-between
  padding-left 18px
  height 42px

  i
    color #25292e
    font-size 13px

.gd-gh-check
  display flex
  align-items center
  gap 10px
  margin-top 3px

  i
    flex none
    width 16px
    height 16px
    border 1px solid #818b98
    border-radius 4px

.gd-gh-terms
  margin 19px 0 0
  color #59636e
  font-size 12px
  line-height 1.45

  a
    text-decoration underline

// ─── authorize ──────────────────────────────────────────────
.gd-gh-auth
  .gd-gh-col
    width 460px
    padding-top 24px

  &.is-narrow .gd-gh-col
    width auto

  h1
    margin 14px 0 18px
    font-size 24px
    font-weight 400

    span
      font-size 17px

.gd-gh-pair
  display flex
  align-items center
  justify-content center
  gap 12px

.gd-gh-app
  width 72px
  height 72px
  border-radius 12px
  box-shadow 0 0 0 2px #3d444d

.gd-gh-dash
  width 56px
  border-top 2px dashed #3d444d

.gd-gh-shield
  color #9198a1
  font-size 18px

.gd-gh-mark
  display grid
  place-items center
  width 72px
  height 72px

  i
    color #fff
    font-size 72px

.gd-gh-box
  margin 4px 0 18px
  padding 18px 22px
  border 1px solid #3d444d
  border-radius 12px

  hr
    margin 16px 0 12px
    border 0
    border-top 1px solid #3d444d

.gd-gh-box-h
  display block
  margin-bottom 14px
  font-size 17px
  font-weight 600

.gd-gh-perm
  display flex
  align-items center
  gap 12px
  margin-bottom 12px
  font-size 15px

  i
    color #3fb950
    font-size 14px

  a
    text-decoration underline

.gd-gh-meta
  display flex
  align-items center
  gap 12px
  margin-top 10px
  color #9198a1

  i
    width 16px
    text-align center

.gd-gh-redirect
  margin 6px 0 0
  color #9198a1
  font-size 13px
  text-align center

  b
    color #f0f6fc

// Authorize, pressed: disabled, with a spinner, until the redirect lands.
.gd-gh-busy
  display none
  align-items center
  gap 8px

.gd-gh .gd-gh-btn.gd-f-auth
  transition background 0.2s ease, color 0.2s ease, border-color 0.2s ease

  &.is-busy
    border-color rgba(240, 246, 252, 0.1)
    background #105823
    color rgba(255, 255, 255, 0.72)

    .gd-gh-idle
      display none

    .gd-gh-busy
      display inline-flex

.gd-gh-spin
  width 14px
  height 14px
  border 2px solid rgba(255, 255, 255, 0.3)
  border-top-color #fff
  border-radius 50%
  animation gd-gh-spin 0.75s linear infinite

@keyframes gd-gh-spin
  to
    transform rotate(360deg)
