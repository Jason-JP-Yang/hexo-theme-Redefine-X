@require '../../common/variables'

// ── The activity card ────────────────────────────────────────────────────────
//
// The third card of the home grid's furniture row, and the only one whose
// contents are decided at runtime — how many days fit is a function of the width
// the row hands it (layouts/pulseCard.js).
//
// Written at the top level for the same reason the other two are: the cards have
// two homes, the classic rail and a grid cell, and they are identical in both.
//
// Every colour on this card is mixed from --primary-color against the card's own
// ground, so the five levels follow the accent, light and dark, without a single
// literal. oklab rather than sRGB because the five steps have to read as evenly
// spaced, and a naive sRGB ramp collapses its middle two on a saturated accent.

.sidebar-pulse
  redefine-container(
    false,
    1.02,
    1.02,
    15px,
    0
  )

  display flex
  flex-direction column
  gap 8px
  min-height 0
  overflow hidden

  // The five levels, mixed from the accent against the card's own ground, so an
  // empty day is invisible against the card and the ramp follows the theme
  // colour in both modes. oklab keeps the five steps perceptually even.
  //
  // unquote(): Stylus reads `in oklab` as an expression and fails on it, taking
  // the WHOLE stylesheet with it — the same trap as an @container prelude.
  --pulse-ground var(--background-color)
  --pulse-empty var(--second-background-color)
  --pulse-1 unquote('color-mix(in oklab, var(--primary-color) 22%, var(--pulse-ground))')
  --pulse-2 unquote('color-mix(in oklab, var(--primary-color) 42%, var(--pulse-ground))')
  --pulse-3 unquote('color-mix(in oklab, var(--primary-color) 62%, var(--pulse-ground))')
  --pulse-4 unquote('color-mix(in oklab, var(--primary-color) 81%, var(--pulse-ground))')
  --pulse-5 var(--primary-color)

  &[marginTop]
    margin-top $spacing-unit * 0.6

.pulse-head
  display flex
  align-items baseline
  justify-content space-between
  gap 10px
  flex 0 0 auto
  min-height 1.15em

.pulse-title
  font-size 0.74rem
  font-weight 600
  letter-spacing 0.08em
  text-transform uppercase
  color var(--third-text-color)
  white-space nowrap

.pulse-total
  font-size 0.86rem
  font-weight 600
  font-variant-numeric tabular-nums
  color var(--second-text-color)
  white-space nowrap
  // Nothing until the numbers land, so the row does not print a stray label over
  // an empty card on the frame before the fetch returns.
  opacity 0
  transition opacity 0.25s ease

  &.is-on
    opacity 1

// The plot owns the free height between the head and the foot. `min-height 0` is
// load-bearing: without it the grid inside would set the card's height, and the
// card would push the furniture row taller than the two beside it — the one
// thing bentoFit.js pins that row to prevent.
// `min-height` is not a nicety: in the wide grid the tile's row gives this box
// its height, but in the one-column layout the tile is content-sized and a pure
// `flex: 1` collapses to zero — the solver then measures 0 and never paints.
.pulse-plot
  position relative
  flex 1 1 auto
  display flex
  flex-direction column
  justify-content center
  gap 4px
  min-height 104px
  overflow hidden

.pulse-months
  position relative
  flex 0 0 auto
  height 0.82rem
  font-size 0.62rem
  line-height 0.82rem
  color var(--third-text-color)
  white-space nowrap

  span
    position absolute
    top 0
    transform translateX(-1px)

// Weeks run across, weekdays down — seven rows, and as many columns as the
// measured width allows. The track sizes come from the solver as custom
// properties so the grid itself needs no inline styles per cell.
.pulse-grid
  flex 0 0 auto
  display grid
  grid-auto-flow column
  grid-template-rows repeat(7, var(--pulse-cell, 8px))
  grid-auto-columns var(--pulse-cell, 8px)
  gap var(--pulse-gap, 2px)
  justify-content center
  align-content center

.pulse-day
  border-radius 2px
  background var(--pulse-empty)
  // Registered nowhere, so it steps rather than interpolates — which is what we
  // want on a level change, and the fade below carries the entrance instead.
  transition transform 0.12s ease

  &.l1
    background var(--pulse-1)
  &.l2
    background var(--pulse-2)
  &.l3
    background var(--pulse-3)
  &.l4
    background var(--pulse-4)
  &.l5
    background var(--pulse-5)

  // Days after today. They hold their cell so the weekday rows stay aligned, and
  // show nothing at all — an empty-looking day that has not happened yet reads as
  // a quiet day, which is a lie.
  &.is-future
    background none

  &.is-on
    transform scale(1.45)
    // The scaled cell has to clear its neighbours, and a 2px gap is not enough.
    outline 1px solid var(--pulse-ground)

// The grid paints in one wave on first fill. Column-staggered rather than
// per-cell, so it reads as the calendar arriving left to right instead of 350
// independent dots.
.pulse-grid.is-entering .pulse-day
  animation pulse-day-in 0.34s cubic-bezier(0.22, 0.61, 0.36, 1) both
  animation-delay calc(var(--pulse-col, 0) * 9ms)

@keyframes pulse-day-in
  from
    opacity 0
    transform scale(0.4)
  to
    opacity 1
    transform scale(1)

.pulse-foot
  display flex
  align-items center
  justify-content space-between
  gap 10px
  flex 0 0 auto
  min-height 0.9rem
  font-size 0.66rem
  color var(--third-text-color)

.pulse-range
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.pulse-scale
  display flex
  align-items center
  gap 3px
  flex 0 0 auto
  white-space nowrap

  i
    width 8px
    height 8px
    border-radius 2px
    background var(--pulse-empty)
    font-style normal

    &.l1
      background var(--pulse-1)
    &.l2
      background var(--pulse-2)
    &.l3
      background var(--pulse-3)
    &.l4
      background var(--pulse-4)
    &.l5
      background var(--pulse-5)

// One tooltip for the whole grid, moved to the hovered cell. 350 title
// attributes would be 350 native tooltips: slow to appear, unstyled, and unable
// to sit inside a card that clips its overflow.
.pulse-tip
  position absolute
  z-index 2
  left 0
  top 0
  padding 3px 7px
  border-radius 6px
  border 1px solid var(--border-color)
  background var(--background-color)
  box-shadow 0 2px 10px var(--shadow-color-1)
  font-size 0.64rem
  line-height 1.35
  color var(--second-text-color)
  white-space nowrap
  pointer-events none
  opacity 0
  transform translate(-50%, -100%) translateY(-4px) scale(0.96)
  transform-origin bottom center
  transition opacity 0.14s ease, transform 0.14s cubic-bezier(0.32, 0.72, 0, 1)

  b
    font-weight 600
    font-variant-numeric tabular-nums
    color var(--first-text-color)

  &.is-on
    opacity 1
    transform translate(-50%, -100%) translateY(-7px) scale(1)

// Before the first paint, and when the fetch comes back with nothing. The card
// keeps its shape either way — a furniture cell that collapses would drag the
// whole row with it.
.sidebar-pulse.is-blank
  .pulse-plot
    align-items center

  .pulse-grid
    opacity 0.5

.sidebar-pulse .pulse-note
  font-size 0.72rem
  color var(--third-text-color)
  text-align center

@media (prefers-reduced-motion: reduce)
  .pulse-grid.is-entering .pulse-day
    animation none

  .pulse-day,
  .pulse-tip
    transition none
