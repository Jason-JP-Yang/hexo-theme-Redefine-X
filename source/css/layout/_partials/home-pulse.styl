@require '../../common/variables'

// ── The activity card ────────────────────────────────────────────────────────
//
// The third card of the home grid's furniture row, and the only one whose
// contents are decided at runtime — the cell size is what the card's height
// affords under a fifteen-pixel ceiling, the row count follows from the cell
// size, and how many columns fit is what is left of the width
// (layouts/pulseCard.js).
//
// Written at the top level for the same reason the other two are: the cards have
// two homes, the classic rail and a grid cell, and they are identical in both.
//
// THE CALENDAR IS ABSOLUTELY POSITIONED. It has to be: the furniture row is
// pinned to the tallest card in it, so a grid that contributed its own height
// would stretch the row, and the stretched row would hand the card a taller box
// to solve against, which would stretch it again. Out of flow, the grid can only
// ever be sized DOWN into the box it is given.
//
// Every colour on this card is mixed from --primary-color against the card's own
// ground, so the five levels follow the accent, light and dark, without a single
// literal. oklab rather than sRGB because the five steps have to read as evenly
// spaced, and a naive sRGB ramp collapses its middle two on a saturated accent.

.sidebar-pulse
  redefine-container(
    false,
    1.02,
    1.02,
    15px,
    0
  )

  display flex
  flex-direction column
  gap 8px
  min-height 0
  overflow hidden

  // The five levels, mixed from the accent against the card's own ground, so an
  // empty day is invisible against the card and the ramp follows the theme
  // colour in both modes. oklab keeps the five steps perceptually even.
  //
  // unquote(): Stylus reads `in oklab` as an expression and fails on it, taking
  // the WHOLE stylesheet with it — the same trap as an @container prelude.
  --pulse-ground var(--background-color)
  --pulse-empty var(--second-background-color)
  --pulse-1 unquote('color-mix(in oklab, var(--primary-color) 22%, var(--pulse-ground))')
  --pulse-2 unquote('color-mix(in oklab, var(--primary-color) 42%, var(--pulse-ground))')
  --pulse-3 unquote('color-mix(in oklab, var(--primary-color) 62%, var(--pulse-ground))')
  --pulse-4 unquote('color-mix(in oklab, var(--primary-color) 81%, var(--pulse-ground))')
  --pulse-5 var(--primary-color)

  &[marginTop]
    margin-top $spacing-unit * 0.6

.pulse-head
  display flex
  align-items center
  justify-content space-between
  gap 10px
  flex 0 0 auto
  min-width 0

.pulse-title
  font-size 0.74rem
  font-weight 600
  letter-spacing 0.08em
  text-transform uppercase
  color var(--third-text-color)
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  padding 3px 0 0 8px

// The key to the ramp. Without it the card shows five shades of the accent and
// never says which end is which.
.pulse-legend
  display flex
  align-items center
  gap 3px
  flex 0 0 auto
  padding 3px 0 0 5px

  em
    font-style normal
    font-size 0.6rem
    letter-spacing 0.02em
    color var(--third-text-color)

  i
    width 9px
    height 9px
    border-radius 2px
    background var(--pulse-empty)

    &.l1
      background var(--pulse-1)
    &.l2
      background var(--pulse-2)
    &.l3
      background var(--pulse-3)
    &.l4
      background var(--pulse-4)
    &.l5
      background var(--pulse-5)

// The plot owns every pixel left between the head and the card's own padding.
//
// `min-height` is not a nicety: in the wide grid the tile's row gives this box
// its height, but in the one-column layout the tile is content-sized and a pure
// `flex: 1` collapses to zero — the solver then measures 0 and never paints.
.pulse-plot
  position relative
  flex 1 1 auto
  min-height 96px
  overflow hidden

// Out of flow and centred on the plot. Shrink-to-fit, so its width is the
// grid's own and the month rule above it lines up with the columns.
.pulse-canvas
  position absolute
  top 50%
  left 50%
  transform translate(-50%, -50%)
  display flex
  flex-direction column
  gap 3px

// A month label marks the column its month begins in and runs to the right of
// it; the labels are placed by the solver, which is the only thing that knows
// how wide a column is.
.pulse-months
  position relative
  height 12px
  overflow visible

  span
    position absolute
    top 0
    font-size 0.58rem
    font-weight 600
    letter-spacing 0.03em
    line-height 12px
    color var(--third-text-color)
    white-space nowrap

// Columns run across, days down each column — as many rows as the height takes,
// and as many columns as the measured width allows. The track sizes are written
// inline by the solver.
.pulse-grid
  display grid
  grid-auto-flow column
  grid-template-rows repeat(7, var(--pulse-cell, 10px))
  grid-auto-columns var(--pulse-cell, 10px)
  gap var(--pulse-gap, 3px)

.pulse-day
  position relative
  border-radius unquote('max(2px, calc(var(--pulse-cell, 10px) * 0.22))')
  background var(--pulse-empty)
  transition transform 0.14s cubic-bezier(0.32, 0.72, 0, 1)

  &.l1
    background var(--pulse-1)
  &.l2
    background var(--pulse-2)
  &.l3
    background var(--pulse-3)
  &.l4
    background var(--pulse-4)
  &.l5
    background var(--pulse-5)

  // Padding at the front, when the series is shorter than the grid. It holds its
  // cell so the columns stay aligned and shows nothing at all — an empty-looking
  // day that was never measured reads as a quiet day, which is a lie.
  &.is-empty
    background none

  // No tooltip: the cell lifting is the whole feedback. The outline is what lets
  // a grown cell clear its neighbours when the gap alone cannot.
  &:not(.is-empty):hover
    z-index 2
    transform scale(1.28)
    outline 2px solid var(--pulse-ground)

// The grid paints in one wave on first fill. Column-staggered rather than
// per-cell, so it reads as the calendar arriving left to right instead of 350
// independent dots.
.pulse-grid.is-entering .pulse-day
  animation pulse-day-in 0.34s cubic-bezier(0.22, 0.61, 0.36, 1) both
  animation-delay calc(var(--pulse-col, 0) * 7ms)

@keyframes pulse-day-in
  from
    opacity 0
    transform scale(0.4)
  to
    opacity 1
    transform scale(1)

// Before the first paint, and when the fetch comes back with nothing. The card
// keeps its shape either way — a furniture cell that collapses would drag the
// whole row with it.
.sidebar-pulse.is-blank .pulse-grid
  opacity 0.5

@media (prefers-reduced-motion: reduce)
  .pulse-grid.is-entering .pulse-day
    animation none

  .pulse-day
    transition none
