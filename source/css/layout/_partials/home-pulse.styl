@require '../../common/variables'

// ── The activity card ────────────────────────────────────────────────────────
//
// The third card of the home grid's furniture row, and the only one whose
// contents are decided at runtime — the cell size is the height the row hands it
// divided by seven, and how many days fit is what is left of the width
// (layouts/pulseCard.js).
//
// Written at the top level for the same reason the other two are: the cards have
// two homes, the classic rail and a grid cell, and they are identical in both.
//
// Every colour on this card is mixed from --primary-color against the card's own
// ground, so the five levels follow the accent, light and dark, without a single
// literal. oklab rather than sRGB because the five steps have to read as evenly
// spaced, and a naive sRGB ramp collapses its middle two on a saturated accent.

.sidebar-pulse
  redefine-container(
    false,
    1.02,
    1.02,
    15px,
    0
  )

  display flex
  flex-direction column
  gap 10px
  min-height 0
  overflow hidden

  // The five levels, mixed from the accent against the card's own ground, so an
  // empty day is invisible against the card and the ramp follows the theme
  // colour in both modes. oklab keeps the five steps perceptually even.
  //
  // unquote(): Stylus reads `in oklab` as an expression and fails on it, taking
  // the WHOLE stylesheet with it — the same trap as an @container prelude.
  --pulse-ground var(--background-color)
  --pulse-empty var(--second-background-color)
  --pulse-1 unquote('color-mix(in oklab, var(--primary-color) 22%, var(--pulse-ground))')
  --pulse-2 unquote('color-mix(in oklab, var(--primary-color) 42%, var(--pulse-ground))')
  --pulse-3 unquote('color-mix(in oklab, var(--primary-color) 62%, var(--pulse-ground))')
  --pulse-4 unquote('color-mix(in oklab, var(--primary-color) 81%, var(--pulse-ground))')
  --pulse-5 var(--primary-color)

  &[marginTop]
    margin-top $spacing-unit * 0.6

.pulse-head
  display flex
  align-items baseline
  gap 10px
  flex 0 0 auto

.pulse-title
  font-size 0.74rem
  font-weight 600
  letter-spacing 0.08em
  text-transform uppercase
  color var(--third-text-color)
  white-space nowrap

// The plot owns every pixel left between the label and the card's own padding,
// and hands all of it to the calendar: seven rows fill the height exactly, and
// the day count is whatever the width then allows.
//
// `min-height` is not a nicety: in the wide grid the tile's row gives this box
// its height, but in the one-column layout the tile is content-sized and a pure
// `flex: 1` collapses to zero — the solver then measures 0 and never paints.
.pulse-plot
  position relative
  flex 1 1 auto
  display flex
  align-items center
  justify-content center
  min-height 92px
  overflow hidden

// Weeks run across, weekdays down — seven rows, and as many columns as the
// measured width allows. The track sizes come from the solver as custom
// properties so the grid itself needs no inline styles per cell.
.pulse-grid
  display grid
  grid-auto-flow column
  grid-template-rows repeat(7, var(--pulse-cell, 10px))
  grid-auto-columns var(--pulse-cell, 10px)
  gap var(--pulse-gap, 2px)

.pulse-day
  position relative
  border-radius unquote('max(2px, calc(var(--pulse-cell, 10px) * 0.22))')
  background var(--pulse-empty)
  transition transform 0.14s cubic-bezier(0.32, 0.72, 0, 1)

  &.l1
    background var(--pulse-1)
  &.l2
    background var(--pulse-2)
  &.l3
    background var(--pulse-3)
  &.l4
    background var(--pulse-4)
  &.l5
    background var(--pulse-5)

  // Days after today. They hold their cell so the weekday rows stay aligned, and
  // show nothing at all — an empty-looking day that has not happened yet reads as
  // a quiet day, which is a lie.
  &.is-future
    background none

  // No tooltip: the cell lifting is the whole feedback. The outline is what lets
  // a grown cell clear its neighbours when the gap alone cannot.
  &:not(.is-future):hover
    z-index 2
    transform scale(1.22)
    outline 2px solid var(--pulse-ground)

// The grid paints in one wave on first fill. Column-staggered rather than
// per-cell, so it reads as the calendar arriving left to right instead of 350
// independent dots.
.pulse-grid.is-entering .pulse-day
  animation pulse-day-in 0.34s cubic-bezier(0.22, 0.61, 0.36, 1) both
  animation-delay calc(var(--pulse-col, 0) * 9ms)

@keyframes pulse-day-in
  from
    opacity 0
    transform scale(0.4)
  to
    opacity 1
    transform scale(1)

// Before the first paint, and when the fetch comes back with nothing. The card
// keeps its shape either way — a furniture cell that collapses would drag the
// whole row with it.
.sidebar-pulse.is-blank .pulse-grid
  opacity 0.5

@media (prefers-reduced-motion: reduce)
  .pulse-grid.is-entering .pulse-day
    animation none

  .pulse-day
    transition none
