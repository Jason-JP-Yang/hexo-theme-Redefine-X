// ═══════════════════════════════════════════════════════════
// Pull to refresh — the tile source/js/tools/pullRefresh.js moves
// ═══════════════════════════════════════════════════════════
@require '../../common/variables'

// The side tools' button, so the one control that appears on its own reads as
// one of that set. A plain surface, not a floating material: it rests on the
// gap it opens below the navbar.
$ptr-tile = 42px
$ptr-radius = 12px

// While the first screen shows, the browser's own pull (Chrome, Safari 15+,
// Firefox) and its top rubber band are off, so a pull reaches only the tile.
// Further down they are left alone and the bounce at a page's foot survives.
html.ptr-zone, html.ptr-zone body
  overscroll-behavior-y none

.pull-refresh
  position fixed
  top 0
  left 50%
  // Under the navbar ($z-index-5): the tile slides out from beneath it.
  z-index $z-index-4
  width $ptr-tile
  height $ptr-tile
  pointer-events none
  visibility hidden
  opacity 0

  +redefine-tablet()
    width round($ptr-tile * 0.9)
    height round($ptr-tile * 0.9)

  &.is-active
    visibility visible
    will-change transform, opacity

  .pull-refresh-tile
    position relative
    display flex
    align-items center
    justify-content center
    width 100%
    height 100%
    border-radius $ptr-radius
    background var(--background-color)
    box-shadow var(--redefine-box-shadow)
    color var(--default-text-color)
    transition background-color 0.22s ease, color 0.22s ease

  .pull-refresh-frame, .pull-refresh-spinner
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    overflow visible
    fill none

  .pull-refresh-frame
    transition opacity 0.18s ease

    path
      stroke var(--primary-color)
      stroke-width 2
      stroke-linecap round
      stroke-dasharray 100
      stroke-dashoffset 100

  .pull-refresh-glyph
    display flex
    font-size 15px
    line-height 1

  .pull-refresh-arrow
    transition transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.18s ease

  .pull-refresh-spinner
    opacity 0
    transform scale(0.6)
    transition opacity 0.2s ease 0.08s, transform 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s

    circle
      stroke #fff
      stroke-width 2.25
      stroke-linecap round
      stroke-dasharray 26 74
      transform-origin 21px 21px

  // Armed: the outline has closed, and the tile floods with the colour a side
  // tool takes under the pointer.
  &.is-armed
    .pull-refresh-tile
      background var(--primary-color)
      color #fff
      animation pull-refresh-pop 0.34s cubic-bezier(0.34, 1.56, 0.64, 1)

    .pull-refresh-frame
      opacity 0

    .pull-refresh-arrow
      transform rotate(180deg)

  &.is-refreshing
    .pull-refresh-arrow
      opacity 0
      transform rotate(180deg) scale(0.5)

    .pull-refresh-spinner
      opacity 1
      transform none

      circle
        animation pull-refresh-spin 0.9s linear infinite, pull-refresh-dash 1.5s ease-in-out infinite

@keyframes pull-refresh-pop
  0%
    transform scale(1)
  45%
    transform scale(1.1)
  100%
    transform scale(1)

@keyframes pull-refresh-spin
  100%
    transform rotate(360deg)

@keyframes pull-refresh-dash
  0%
    stroke-dasharray 4 96
    stroke-dashoffset 0
  50%
    stroke-dasharray 62 38
    stroke-dashoffset -16
  100%
    stroke-dasharray 4 96
    stroke-dashoffset -96

@media (prefers-reduced-motion: reduce)
  .pull-refresh
    &.is-armed .pull-refresh-tile
      animation none

    &.is-refreshing .pull-refresh-spinner circle
      animation pull-refresh-spin 1.6s linear infinite
