  opacity 1
  transform none
  pointer-events auto

// ─── following: a new post reaches the reader ───────────────
.gd-s-feed
  .gd-m-new
    max-height 0
    margin-top -7px
    padding-top 0
    padding-bottom 0
    border-width 0
    border-color var(--gd-accent)
    opacity 0
    transform translateY(-8px)
    transition max-height 0.5s ease, margin 0.5s ease, padding 0.5s ease, border-width 0.5s ease, opacity 0.4s ease 0.1s, transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1)

  .is-new .gd-m-new
    max-height 64px
    margin-top 0
    padding-top 7px
    padding-bottom 7px
    border-width 1px
    opacity 1
    transform none

  .gd-m-fly
    position absolute
    left 60px
    top 40px
    width 8px
    height 8px
    border-radius 50%
    background var(--gd-accent)
    opacity 0
    pointer-events none

  .is-sent .gd-m-fly
    animation gd-fly 0.8s cubic-bezier(0.5, 0, 0.3, 1) forwards

  .is-sent .gd-m-badge
    transform scale(1)
    transition-delay 0.72s

  .gd-m-drop
    position absolute
    top 29px
    right 6px
    z-index 2
    width 158px
    padding 5px
    border 1px solid var(--border-color)
    border-radius 8px
    background var(--background-color)
    box-shadow 0 12px 26px rgba(0, 0, 0, 0.16)
    opacity 0
    transform translateY(-4px) scale(0.97)
    transform-origin 100% 0
    pointer-events none
    transition opacity 0.22s ease, transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1)

  .is-open .gd-m-drop
    opacity 1
    transform none

  .gd-m-drop-head
    padding 2px 4px 5px
    font-size 8.5px
    font-weight 700
    color var(--first-text-color)

  .gd-m-drop-item
    display grid
    grid-template-columns 6px 1fr auto
    align-items center
    gap 5px
    padding 4px 5px
    border-radius 5px

    i
      width 5px
      height 5px
      border-radius 50%

    b
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
      font-size 8px

    small
      font-size 7px
      color var(--third-text-color)

    &.is-unread
      background var(--gd-accent-10)

      i
        background var(--gd-accent)

  .gd-m-toast
    position absolute
    right 16px
    bottom 16px
    display flex
    align-items center
    gap 7px
    width 176px
    padding 7px 9px
    border 1px solid var(--border-color)
    border-radius 10px
    background var(--background-color)
    box-shadow 0 10px 26px rgba(0, 0, 0, 0.2)
    opacity 0
    transform translateX(200px)
    transition transform 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.1), opacity 0.3s ease

  &.is-toast .gd-m-toast
    opacity 1
    transform none

  .gd-m-toast-text
    display flex
    flex-direction column
    min-width 0

    b
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
      font-size 8.5px
      color var(--first-text-color)

    small
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
      font-size 7.5px
      color var(--third-text-color)

// From the new post to the bell in the navbar, in page coordinates.
@keyframes gd-fly
  0%
    opacity 0
    transform translate(0, 0) scale(0.6)
  15%
    opacity 1
    transform translate(20px, -8px) scale(1)
  60%
    opacity 1
    transform translate(150px, -40px) scale(0.9)
  100%
    opacity 0
    transform translate(241px, -31px) scale(0.5)

// ─── GitHub ─────────────────────────────────────────────────
.gd-gh, .gd-auth-gh
