    width 5px
    height 5px
    border-radius 3px
    background rgba(255, 255, 255, 0.4)
    transition width 0.3s ease, background 0.3s ease

    &:first-child
      width 12px
      background #fff

.gd-v-panel
  position absolute
  top 40px
  right 12px
  z-index 2
  width 148px
  padding 9px 10px
  border-radius 10px
  background rgba(28, 28, 32, 0.94)
  color #fff
  font-size 8px
  opacity 0
  transform translateY(-4px) scale(0.97)
  transform-origin 100% 0
  pointer-events none
  transition opacity 0.22s ease, transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1)

  > b
    display block
    margin-bottom 6px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    font-size 8.5px

  dl
    display grid
    grid-template-columns auto 1fr
    gap 3px 8px
    margin 0

  dt
    color rgba(255, 255, 255, 0.6)

  dd
    margin 0
