// ========================================================================================
//                                          GUIDE
// ========================================================================================
// The virtual cursor, the label it speaks its tips through, and the walkthrough
// card (source/js/plugins/guide).
//
// Material: tier 1 only. Every surface is solid with a shadow and the tour's
// mask is a flat colour. The cursor and its label move every frame, and a
// backdrop pass under something that moves is the most expensive thing the
// compositor can be asked for.
//
// The devices and pages the follow walkthrough is acted out on are in
// guide-mock.styl. Auto-included: style.styl requires layout/_partials/*.

.gd-layer, .gd-tour
  --gd-accent var(--primary-color)
  --gd-accent-10 unquote('color-mix(in srgb, var(--primary-color) 10%, transparent)')
  --gd-accent-18 unquote('color-mix(in srgb, var(--primary-color) 18%, transparent)')
  --gd-accent-35 unquote('color-mix(in srgb, var(--primary-color) 35%, transparent)')
  --gd-accent-55 unquote('color-mix(in srgb, var(--primary-color) 55%, transparent)')
  --gd-skel rgba(0, 0, 0, 0.08)
  --gd-skel-strong rgba(0, 0, 0, 0.16)
  --gd-line-strong rgba(0, 0, 0, 0.18)
  font-family $default-font-family

.dark .gd-layer, .dark .gd-tour
  --gd-skel rgba(255, 255, 255, 0.09)
  --gd-skel-strong rgba(255, 255, 255, 0.2)
  --gd-line-strong rgba(255, 255, 255, 0.22)

// What a tip may reveal that a pointer otherwise would: the buttons of a code
// block, the camera card of a photo, a navbar menu (layout/_partials/navbar.styl).
.code-container.guide-reveal .copy-button, .code-container.guide-reveal .fold-button
  opacity 1

.image-exif-container.image-exif-float:not(.image-exif-overflow-fallback).guide-reveal .image-exif-info-card
  opacity 1
  pointer-events auto

// {% guide %} carries its note in data attributes and prints nothing.
.guide-note
  display none !important


// ─── the page layer ─────────────────────────────────────────
.gd-layer
  position fixed
  inset 0
  z-index $z-index-7
  pointer-events none
  // How wide a tip's text runs before it wraps (plugins/guide/callout.js).
  --gd-say-max 262px

.gd-sr
  position absolute
  width 1px
  height 1px
  overflow hidden
  clip-path inset(50%)
  white-space nowrap

.gd-cursor
  position absolute
  left 0
  top 0
  z-index 4
  width 0
  height 0
  opacity 0
  pointer-events none
  will-change transform
  transition opacity 0.18s ease

  &.is-on
    opacity 1

  .gd-cursor-body, .gd-cursor-press
    position absolute
    left 0
    top 0
    transform-origin 0 0

  // The rounded tip, (3, 3) on the arrow's grid, sits on (0, 0).
  .gd-arrow
    position absolute
    left -2.5px
    top -2.5px
    width 20px
    height 20px
    overflow visible
    filter drop-shadow(0 1.5px 3px rgba(0, 0, 0, 0.26))

    path
      fill var(--gd-accent)
      stroke #fff
      stroke-width 2.2
      stroke-linejoin round

  &.is-local .gd-arrow
    left -1.7px
    top -1.7px
    width 13.5px
    height 13.5px
    filter drop-shadow(0 1px 2px rgba(0, 0, 0, 0.28))

// The label, which is also the tip it grows into (plugins/guide/callout.js).
// While it speaks JS sets the box's width and each row's height; at rest the box
// is its own size.
.gd-pill
  position absolute
  left 0
  top 0
  z-index 3
  opacity 0
  pointer-events none
  will-change transform
  transition opacity 0.18s ease

  &.is-on
    opacity 1

  &.is-speaking
    pointer-events auto

.gd-pill-box
  position relative
  overflow hidden
  padding 3px 9px
  border-radius 10px
  background var(--gd-accent)
  color #fff
  font-size 12.5px
  line-height 17px
  letter-spacing 0.01em
  box-shadow 0 4px 14px rgba(0, 0, 0, 0.2)
  transform scale(0.86)
  transform-origin 50% 0
  transition transform 0.32s cubic-bezier(0.2, 0.9, 0.3, 1.3), border-radius 0.2s ease

.gd-pill.is-on .gd-pill-box
  transform none

// The corner by the arrow is the bubble's tail, and where it grows from.
.gd-pill.is-dr .gd-pill-box
  border-top-left-radius 4px
  transform-origin 0 0

.gd-pill.is-dl .gd-pill-box
  border-top-right-radius 4px
  transform-origin 100% 0

.gd-pill.is-ur .gd-pill-box
  border-bottom-left-radius 4px
  transform-origin 0 100%

.gd-pill.is-ul .gd-pill-box
  border-bottom-right-radius 4px
  transform-origin 100% 100%

.gd-pill.is-local .gd-pill-box
  padding 2px 6px
  border-radius 6px
  font-size 8.5px
  line-height 12px
  box-shadow 0 2px 5px rgba(0, 0, 0, 0.2)

.gd-pill.is-local.is-dr .gd-pill-box
  border-top-left-radius 2.5px

.gd-pill.is-local.is-dl .gd-pill-box
  border-top-right-radius 2.5px

.gd-pill.is-local.is-ur .gd-pill-box
  border-bottom-left-radius 2.5px

.gd-pill.is-local.is-ul .gd-pill-box
  border-bottom-right-radius 2.5px

.gd-say-title, .gd-say-text, .gd-say-actions
  overflow hidden

// Only a label that is speaking has these rows; at rest they would widen it.
.gd-say-title, .gd-say-actions
  display none
  height 0

.gd-pill.has-say .gd-say-actions
  display block

// A prompt to scroll, or a welcome: only what is said.
.gd-pill.has-say.no-actions .gd-say-actions
  display none

// Held by its bottom edge, so the title slides out from under the bubble's top.
.gd-pill.has-say .gd-say-title
  display flex
  flex-direction column
  justify-content flex-end
  align-items flex-start

  &[hidden]
    display none

.gd-say-title-in, .gd-say-line, .gd-say-actions-in
  width max-content
  max-width var(--gd-say-max)

.gd-say-title-in
  flex none
  padding-bottom 1px
  font-weight 700
  opacity 0
  transform translateY(5px)
  transition opacity 0.22s ease, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1)

.gd-say-name
  font-weight 700

.gd-say-body
  color rgba(255, 255, 255, 0.92)

.gd-say-body b, .gd-say-body strong
  font-weight 700
  color #fff

.gd-say-body a
  color #fff
  text-decoration underline

.gd-say-body p, .gd-say-body ul, .gd-say-body ol
  margin 3px 0 0

// An author's note is rendered Markdown: its first paragraph runs on from "Guide:".
.gd-say-body > b:first-child + p
  display inline

.gd-say-body ul, .gd-say-body ol
  padding-left 1.2em

.gd-say-body code
  padding 0 3px
  border-radius 4px
  background rgba(255, 255, 255, 0.16)
  font-size 0.92em

// One character of the text being typed.
.gd-c
  opacity 0
  transition opacity 0.16s ease

  &.is-on
    opacity 1

.gd-pill.is-hushing .gd-say-body
  opacity 0
  transition opacity 0.12s ease

.gd-say-actions-in
  display flex
  align-items center
  gap 4px
  padding 5px 0 2px
  visibility hidden
  opacity 0
  transform translateY(-5px)
  transition opacity 0.22s ease 0.05s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) 0.05s

.gd-pill.is-ready .gd-say-title-in, .gd-pill.is-ready .gd-say-actions-in
  visibility visible
  opacity 1
  transform none

.gd-say-btn, .gd-say-x
  display inline-flex
  align-items center
  justify-content center
  gap 5px
  height 22px
  border none
  border-radius 7px
  font-family inherit
  font-size 12px
  font-weight 600
  line-height 1
  white-space nowrap
  cursor pointer
  transition background 0.2s ease, color 0.2s ease, transform 0.15s ease

  &:active
    transform scale(0.96)

  &:focus-visible
    outline 2px solid #fff
    outline-offset 1px

  &[hidden]
    display none

.gd-say-btn
  padding 0 9px
  background rgba(255, 255, 255, 0.16)
  color #fff

  i
    font-size 10px
    transition transform 0.2s ease

  &:hover
    background rgba(255, 255, 255, 0.26)

    i
      transform translateX(2px)

  &.is-ok
    background #fff
    color var(--gd-accent)

    &:hover
      background rgba(255, 255, 255, 0.86)

.gd-say-x
  width 22px
  padding 0
  background transparent
  color rgba(255, 255, 255, 0.7)

  &:hover
    background rgba(255, 255, 255, 0.16)
    color #fff

.gd-say-timer
  position absolute
  left 0
  right 0
  bottom 0
  height 2px
  pointer-events none

  i
    display block
    width 100%
    height 100%
    background rgba(255, 255, 255, 0.45)
    transform-origin 0 50%
    animation gd-countdown var(--gd-wait, 12s) linear forwards

.gd-pill.is-held .gd-say-timer i
  animation-play-state paused

@keyframes gd-countdown
  from
    transform scaleX(1)
  to
    transform scaleX(0)

.gd-ripple
  position absolute
  left 0
  top 0
  z-index 2
  width 0
  height 0
  pointer-events none

  i
    position absolute
    left 0
    top 0
    width 34px
    height 34px
    border 1.5px solid var(--gd-accent)
    border-radius 50%
    background var(--gd-accent-10)
    opacity 0
    transform translate(-50%, -50%) scale(0.2)

.gd-cam .gd-ripple i
  width 22px
  height 22px
  border-width 1.2px


// ─── buttons ────────────────────────────────────────────────
.gd-btn
  display inline-flex
  align-items center
  justify-content center
  gap 7px
  height 36px
  padding 0 15px
  border none
  border-radius 10px
  font-family inherit
  font-size 14px
  font-weight 600
  line-height 1
  white-space nowrap
  cursor pointer
  transition background 0.2s ease, color 0.2s ease, filter 0.2s ease, transform 0.15s ease, box-shadow 0.25s ease

  i
    font-size 12px
    transition transform 0.2s ease

  &:active
    transform scale(0.97)

  &:focus-visible
    outline 2px solid var(--gd-accent)
    outline-offset 2px

  &[hidden]
    display none

.gd-btn-primary
  background var(--gd-accent)
  color #fff
  box-shadow 0 4px 14px var(--gd-accent-35)

  &:hover
    filter brightness(1.08)

    i
      transform translateX(2px)

  &.is-ready
    animation gd-ready 1.6s ease-in-out infinite

.gd-btn-quiet
  background transparent
  color var(--second-text-color)

  &:hover
    background var(--second-background-color)
    color var(--first-text-color)

@keyframes gd-ready
  0%, 100%
    box-shadow 0 4px 14px var(--gd-accent-35), 0 0 0 0 var(--gd-accent-55)
  50%
    box-shadow 0 4px 14px var(--gd-accent-35), 0 0 0 6px transparent


// ─── the walkthrough card ───────────────────────────────────
.gd-tour
  position fixed
  inset 0
  z-index $z-index-6
  display flex
  align-items center
  justify-content center
  padding 16px
  pointer-events none

.gd-tour-mask
  position absolute
  inset 0
  background rgba(8, 8, 12, 0.5)
  opacity 0
  pointer-events auto
  transition opacity 0.3s ease

.gd-tour.is-open .gd-tour-mask
  opacity 1

.gd-tour.is-closing .gd-tour-mask
  opacity 0

// Wide enough for a desktop to be read at a glance on the stage below.
.gd-tour-card
  position relative
  display flex
  flex-direction column
  width unquote('min(680px, 100%)')
  max-height unquote('calc(100svh - 32px)')
  overflow hidden
  border 1px solid var(--border-color)
  border-radius 22px
  background var(--background-color)
  color var(--default-text-color)
  box-shadow 0 30px 80px rgba(0, 0, 0, 0.28), 0 4px 16px rgba(0, 0, 0, 0.08)
  pointer-events auto
  opacity 0
  transform translateY(18px) scale(0.97)
  transition opacity 0.28s ease, transform 0.5s cubic-bezier(0.2, 0.9, 0.25, 1.08)

.gd-tour.is-open .gd-tour-card
  opacity 1
  transform none

.gd-tour.is-closing .gd-tour-card
  opacity 0
  transform translateY(12px) scale(0.98)
  transition-duration 0.22s

.gd-tour-head
  flex none
  display flex
  align-items center
  gap 10px
  min-width 0
  padding 14px 12px 10px 20px

.gd-tour-kicker
  flex none
  display inline-flex
  align-items center
  gap 6px
  font-size 11.5px
  font-weight 700
  letter-spacing 0.06em
  text-transform uppercase
  color var(--gd-accent)

.gd-tour-name
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  font-size 14px
  font-weight 600
  color var(--first-text-color)

// The system picker beside a walkthrough's name. Its list is the navbar's
// sub-menu surface: the same radius, ground and hover.
.gd-pick
  position relative
  flex none

  &[hidden]
    display none

.gd-pick-btn
  display inline-flex
  align-items center
  gap 6px
  height 28px
  padding 0 9px 0 10px
  border 1px solid var(--border-color)
  border-radius 999px
  background var(--background-color)
  color var(--second-text-color)
  font-family inherit
  font-size 12.5px
  font-weight 600
  white-space nowrap
  cursor pointer
  transition background 0.2s ease, color 0.2s ease, border-color 0.2s ease

  i
    font-size 12px

  .gd-pick-caret
    font-size 9px
    opacity 0.7
    transition transform 0.25s ease

  &:hover, &:focus-visible
    border-color var(--gd-accent-35)
    color var(--first-text-color)
    outline none

.gd-pick.is-open .gd-pick-caret
  transform rotate(180deg)

.gd-pick-list
  position absolute
  left 0
  top unquote('calc(100% + 6px)')
  z-index 5
  min-width 172px
  margin 0
  padding 5px
  list-style none
  border 1px solid var(--border-color)
  border-radius $redefine-border-radius-large
  background var(--background-color)
  box-shadow 0 12px 32px var(--shadow-color-1)
  opacity 0
  visibility hidden
  transform translateY(-4px)
  transform-origin 0 0
  transition opacity 0.18s ease, transform 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.2), visibility 0.22s

  li
    display flex
    align-items center
    gap 9px
    padding 7px 10px
    border-radius 9px
    color var(--default-text-color)
    font-size 13.5px
    white-space nowrap
    cursor pointer
    outline none
    transition background 0.15s ease, color 0.15s ease

    > i:first-child
      width 16px
      text-align center
      color var(--third-text-color)

    &:hover, &:focus-visible
      background var(--third-background-color)
      color var(--primary-color)

  .gd-pick-tick
    margin-left auto
    font-size 11px
    color var(--gd-accent)
    visibility hidden

  li[aria-selected="true"]
    font-weight 600

    .gd-pick-tick
      visibility visible

.gd-pick.is-open .gd-pick-list
  opacity 1
  visibility visible
  transform none

.gd-tour-count
  flex none
  margin-left auto
  font-size 12.5px
  font-variant-numeric tabular-nums
  color var(--third-text-color)

.gd-tour-close
  flex none
  display grid
  place-items center
  width 34px
  height 34px
  border none
  border-radius 10px
  background transparent
  color var(--third-text-color)
  font-size 16px
  cursor pointer
  transition background 0.2s ease, color 0.2s ease

  &:hover
    background var(--second-background-color)
    color var(--first-text-color)

.gd-tour.is-menu .gd-tour-count
  display none

.gd-tour.is-menu .gd-tour-close
  margin-left auto

// The stage: a letterboxed window onto the scaled world. Its height comes from
// the ratio alone — a desktop's, or a squarer one for a phone — capped on a
// short screen, and nothing inside it can size it.
.gd-tour-stage
  position relative
  flex none
  margin 0 14px
  aspect-ratio unquote('16 / 10')
  max-height 46svh
  overflow hidden
  border 1px solid var(--border-color)
  border-radius 16px
  background var(--second-background-color)
  contain layout paint

.gd-tour.is-tall .gd-tour-stage
  aspect-ratio unquote('1 / 1')
  max-height 52svh

.gd-tour.no-stage .gd-tour-stage
  display none

.gd-view
  position absolute
  inset 0
  overflow hidden

// Moved by scene.js on the guide's frame loop, never by a transition; it is
// promoted to its own layer only while it moves.
.gd-cam
  position absolute
  left 0
  top 0
  transform-origin 0 0

.gd-tour-text
  flex 1 1 auto
  display grid
  min-height 0
  overflow-x hidden
  overflow-y auto
  overscroll-behavior contain
  transition height 0.38s cubic-bezier(0.3, 0.7, 0.2, 1)

  &.is-sliding
    overflow hidden

.gd-tour-slide
  grid-area unquote('1 / 1')
  align-self start
  min-width 0
  padding 16px 22px 4px

  &.is-entering
    animation gd-slide-in 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) both

  &.is-leaving
    pointer-events none
    animation gd-slide-out 0.26s ease both

@keyframes gd-slide-in
  from
    opacity 0
    transform unquote('translateX(calc(var(--gd-dir, 1) * 28px))')
  to
    opacity 1
    transform none

@keyframes gd-slide-out
  from
    opacity 1
    transform none
  to
    opacity 0
    transform unquote('translateX(calc(var(--gd-dir, 1) * -28px))')

.gd-tour-title
  margin 0 0 6px
  font-size 19px
  font-weight 700
  line-height 1.3
  color var(--first-text-color)

.gd-tour-body
  font-size 14.5px
  line-height 1.7
  color var(--second-text-color)

  b
    font-weight 600
    color var(--first-text-color)

  p
    margin 0.6em 0 0

  .gd-note
    margin-top 10px
    padding 8px 12px
    border-radius 10px
    background var(--second-background-color)
    font-size 13.5px

.gd-tour-foot
  flex none
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 14px 18px 18px 22px

.gd-dots
  display flex
  flex-wrap wrap
  align-items center
  gap 6px
  min-width 0

.gd-dot
  position relative
  width 8px
  height 8px
  padding 0
  border none
  border-radius 4px
  background var(--gd-skel-strong)
  cursor pointer
  transition width 0.35s cubic-bezier(0.3, 0.7, 0.2, 1), background 0.25s ease

  // A target a finger can find, larger than the dot it belongs to.
  &::after
    content ''
    position absolute
    inset -9px -3px

  &.is-done
    background var(--gd-accent-35)

  &.is-current
    width 26px
    background var(--gd-accent)

.gd-tour-nav
  flex none
  display flex
  gap 8px

// ─── the guide menu ─────────────────────────────────────────
.gd-menu-lede
  margin 0 0 12px
  font-size 14px
  line-height 1.6
  color var(--second-text-color)

.gd-menu-list
  display flex
  flex-direction column
  gap 8px

.gd-menu-row
  display flex
  align-items center
  gap 12px
  width 100%
  padding 12px 14px
  border 1px solid var(--border-color)
  border-radius 14px
  background var(--background-color)
  color inherit
  font-family inherit
  text-align left
  cursor pointer
  transition background 0.2s ease, border-color 0.2s ease, transform 0.15s ease

  &:hover, &:focus-visible
    border-color var(--gd-accent-35)
    background var(--second-background-color)
    outline none

    .gd-menu-go
      color var(--gd-accent)
      transform translateX(3px)

  &:active
    transform scale(0.99)

.gd-menu-icon
  flex none
  display grid
  place-items center
  width 38px
  height 38px
  border-radius 11px
  background var(--gd-accent-10)
  color var(--gd-accent)
  font-size 16px

.gd-menu-text
  flex 1
  display flex
  flex-direction column
  gap 2px
  min-width 0

  b
    font-size 14.5px
    font-weight 600
    color var(--first-text-color)

  span
    font-size 12.5px
    line-height 1.45
    color var(--third-text-color)

.gd-menu-meta
  flex none
  font-size 12px
  white-space nowrap
  color var(--third-text-color)

.gd-menu-go
  flex none
  color var(--third-text-color)
  transition transform 0.2s ease, color 0.2s ease

.gd-menu-reset
  display inline-flex
  align-items center
  gap 8px
  margin-top 14px
  padding 8px 10px
  border none
  border-radius 10px
  background transparent
  color var(--second-text-color)
  font-family inherit
  font-size 13.5px
  font-weight 600
  cursor pointer
  transition background 0.2s ease, color 0.2s ease

  &:hover
    background var(--second-background-color)
    color var(--first-text-color)

  &.is-armed
    background var(--gd-accent-10)
    color var(--gd-accent)

  &.is-done
    color #2e9d57

.gd-menu-note
  margin 2px 0 10px
  font-size 12.5px
  line-height 1.5
  color var(--third-text-color)

+redefine-mobile()
  .gd-tour
    align-items flex-end
    padding 0

  .gd-tour-card
    width 100%
    max-height 94svh
    border-bottom none
    border-radius 22px 22px 0 0
    padding-bottom unquote('env(safe-area-inset-bottom)')
    transform translateY(48px)

  .gd-tour-stage
    margin 0 12px

  .gd-tour-slide
    padding 14px 18px 2px

  .gd-tour-title
    font-size 17.5px

  .gd-tour-body
    font-size 14px

  .gd-tour-foot
    padding 12px 14px 14px 18px

  .gd-layer
    --gd-say-max unquote('min(232px, calc(100vw - 40px))')

@media (prefers-reduced-motion: reduce)
  .gd-layer *, .gd-tour *
    transition-duration 0.01ms !important
    animation-duration 0.01ms !important
    animation-iteration-count 1 !important

  .gd-say-timer
    display none


// ========================================================================================
//                                          SCENES
// ========================================================================================
// A world is authored in its own pixels; the camera scales it. The follow
// walkthrough's devices and pages are in guide-mock.styl. `.is-canvas` worlds
// (the comments walkthrough) are drawn on the old 360×225 canvas with the small
// kit below, so every size under it is a canvas pixel.
.gd-world
  position absolute
  left 0
  top 0
  overflow hidden
  user-select none
  -webkit-user-select none
  animation gd-world-in 0.22s ease both

  // Between one playing of a scene and the next.
  &.is-leaving
    animation gd-world-out 0.2s ease both

@keyframes gd-world-in
  from
    opacity 0

@keyframes gd-world-out
  to
    opacity 0

.gd-world.is-canvas
  color var(--default-text-color)
  font-size 9px
  line-height 1.35

  b
    font-weight 600

  ul
    margin 0
    padding 0
    list-style none

@keyframes gd-pop
  from
    transform scale(0)
  to
    transform scale(1)

@keyframes gd-caret
  0%
    opacity 1
  50%
    opacity 0

// ─── kit ────────────────────────────────────────────────────
.gd-m-avatar
  flex none
  display inline-block
  width 14px
  height 14px
  border-radius 50%
  background linear-gradient(135deg, #f78736, #367df7)

.gd-m-btn
  display inline-flex
  align-items center
  justify-content center
  gap 5px
  height 22px
  padding 0 12px
  border-radius 6px
  font-size 9px
  font-weight 600
  white-space nowrap

.gd-m-input
  display flex
  align-items center
  height 20px
  padding 0 7px
  overflow hidden
  border 1px solid var(--gd-line-strong)
  border-radius 5px
  background var(--background-color)
  color var(--first-text-color)
  font-size 9px
  white-space nowrap
  transition border-color 0.2s ease, box-shadow 0.2s ease

  &.is-focus
    border-color var(--gd-accent)
    box-shadow 0 0 0 2px var(--gd-accent-18)

.gd-m-caret
  display inline-block
  width 1px
  height 11px
  margin-left 1px
  background currentColor
  opacity 0

.is-focus .gd-m-caret
  animation gd-caret 1s steps(1) infinite

.gd-gh-dark
  background #1f2328
  color #fff

.dark .gd-gh-dark
  background #f0f6fc
  color #0d1117

.gd-gh-green
  background #1f883d
  color #fff

.dark .gd-gh-green
  background #238636

.gd-v-photo
  position relative
  flex none
  overflow hidden

  &.p1
    background linear-gradient(180deg, #7ab8ff 0%, #bcd9ff 42%, #f6c79f 58%, #58795f 59%, #2c4435 100%)

  &.p2
    background linear-gradient(180deg, #2b1e4f 0%, #7b3f8c 38%, #f08a5d 56%, #1e3a5f 57%, #0f2238 100%)

  > i
    position absolute
    left 64%
    top 22%
    width 16%
    padding-top 16%
    border-radius 50%
    background radial-gradient(circle, #fffbe6 0%, #ffd87a 55%, rgba(255, 216, 122, 0) 72%)

  &::before
    content ''
    position absolute
    left 0
    right 0
    bottom 41%
    height 26%
    background rgba(40, 66, 90, 0.75)
    clip-path polygon(0 100%, 0 70%, 14% 38%, 26% 62%, 42% 12%, 58% 58%, 72% 30%, 86% 55%, 100% 36%, 100% 100%)

  &.p2::before
    background rgba(20, 16, 40, 0.8)

// ─── comments ───────────────────────────────────────────────
.gd-s-comments
  padding 12px 16px
  background var(--background-color)

.gd-c-head
  display flex
  align-items center
  justify-content space-between
  margin-bottom 8px
  font-size 9px
  white-space nowrap

.gd-c-gh
  display inline-flex
  align-items center
  gap 4px
  color var(--third-text-color)
  font-size 7.5px

.gd-c-box
  display flex
  align-items center
  justify-content center
  min-height 34px
  margin-bottom 10px
  padding 7px
  border 1px solid var(--border-color)
  border-radius 8px
  background var(--second-background-color)

  &.is-signed
    display block
    padding 7px 8px

.gd-c-item
  display grid
  grid-template-columns 18px 1fr
  gap 8px
  margin-bottom 8px

  > .gd-m-avatar
    width 18px
    height 18px

  &.is-reply
    margin-left 26px

.gd-c-main
  min-width 0
  overflow hidden
  border 1px solid var(--border-color)
  border-radius 8px

.gd-c-meta
  display flex
  align-items baseline
  gap 6px
  padding 4px 8px
  border-bottom 1px solid var(--border-color)
  background var(--second-background-color)
  font-size 8px
  white-space nowrap

  small
    color var(--third-text-color)
    font-size 7px

.gd-c-text
  padding 5px 8px
  color var(--second-text-color)
  font-size 8.5px
  line-height 1.4

.gd-c-react
  display flex
  flex-wrap wrap
  gap 4px
  padding 0 8px 6px

  &:empty
    display none

  span
    display inline-flex
    align-items center
    gap 2px
    padding 1px 6px
    border 1px solid var(--border-color)
    border-radius 999px
    background var(--background-color)
    font-size 7.5px

.gd-c-tabs
  display flex
  gap 2px
  margin-bottom 6px

.gd-c-tab
  padding 3px 8px
  border-radius 5px
  color var(--third-text-color)
  font-size 8px
  font-weight 600

  &.is-on
    background var(--background-color)
    color var(--first-text-color)
    box-shadow 0 0 0 1px var(--border-color)

.gd-s-comments.is-preview
  .gd-c-tab.is-on
    background transparent
    color var(--third-text-color)
    box-shadow none

  .gd-f-preview
    background var(--background-color)
    color var(--first-text-color)
    box-shadow 0 0 0 1px var(--border-color)

  .gd-c-area
    display none

  .gd-c-rendered
    display block

.gd-c-area
  display block
  height 46px
  padding 6px 7px
  line-height 1.4
  white-space pre-wrap

.gd-c-rendered
  display none
  height 46px
  padding 6px 7px
  overflow hidden
  border 1px solid var(--gd-line-strong)
  border-radius 5px
  background var(--background-color)
  color var(--first-text-color)
  font-size 9px
  line-height 1.4

.gd-c-actions
  display flex
  justify-content flex-end
  margin-top 6px

.gd-c-mine
  opacity 0
  transform translateY(10px)
  transition opacity 0.35s ease, transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.1)

.gd-s-comments.is-sent
  .gd-c-mine
    opacity 1
    transform none

  .gd-c-edit
    opacity 0.35

.gd-s-comments.is-react .gd-c-list
  position absolute
  left 16px
  top 22px
  width 214px

.gd-c-add
  color var(--third-text-color)

.gd-c-party
  display none !important

.gd-s-comments.is-reacted .gd-c-party
  display inline-flex !important
  animation gd-pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1)

.gd-c-picker
  position absolute
  left 44px
  top 88px
  z-index 3
  display flex
  gap 2px
  padding 4px
  border 1px solid var(--border-color)
  border-radius 9px
  background var(--background-color)
  box-shadow 0 10px 24px rgba(0, 0, 0, 0.16)
  opacity 0
  transform translateY(4px) scale(0.96)
  transform-origin 0 0
  pointer-events none
  transition opacity 0.2s ease, transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.1)

  span
    display grid
    place-items center
    width 19px
    height 19px
    border-radius 5px
    font-size 11px

.gd-s-comments.is-pick .gd-c-picker
  opacity 1
  transform none
  pointer-events auto

.gd-c-photo
  position absolute
  right 16px
  top 22px
  width 104px
  height 138px
  overflow hidden
  border-radius 10px
  box-shadow 0 6px 18px rgba(0, 0, 0, 0.14)

  .gd-v-photo
    position absolute
    inset 0

.gd-c-heart
  position absolute
  right 6px
  bottom 6px
  display inline-flex
  align-items center
  gap 3px
  padding 2px 7px
  border-radius 999px
  background rgba(0, 0, 0, 0.45)
  color #fff
  font-size 8px

  .fa-solid, .n1
    display none

.gd-s-comments.is-liked .gd-c-heart
  .fa-regular, .n0
    display none

  .fa-solid
    display inline-block
    color #ff4d6d
    animation gd-pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1)

  .n1
    display inline
