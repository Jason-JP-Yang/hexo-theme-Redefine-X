  color var(--first-text-color)
  font-size 9px
  line-height 1.4

.gd-c-actions
  display flex
  justify-content flex-end
  margin-top 6px

.gd-c-mine
  opacity 0
  transform translateY(10px)
  transition opacity 0.35s ease, transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.1)

.gd-s-comments.is-sent
  .gd-c-mine
    opacity 1
    transform none

  .gd-c-edit
    opacity 0.35

.gd-s-comments.is-react .gd-c-list
  position absolute
  left 16px
  top 22px
  width 214px

.gd-c-add
  color var(--third-text-color)

.gd-c-party
  display none !important

.gd-s-comments.is-reacted .gd-c-party
  display inline-flex !important
  animation gd-pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1)

.gd-c-picker
  position absolute
  left 44px
  top 88px
  z-index 3
  display flex
  gap 2px
  padding 4px
  border 1px solid var(--border-color)
  border-radius 9px
  background var(--background-color)
  box-shadow 0 10px 24px rgba(0, 0, 0, 0.16)
  opacity 0
  transform translateY(4px) scale(0.96)
  transform-origin 0 0
  pointer-events none
  transition opacity 0.2s ease, transform 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.1)

  span
    display grid
    place-items center
    width 19px
    height 19px
    border-radius 5px
    font-size 11px

.gd-s-comments.is-pick .gd-c-picker
  opacity 1
  transform none
  pointer-events auto

.gd-c-photo
  position absolute
  right 16px
  top 22px
  width 104px
  height 138px
  overflow hidden
  border-radius 10px
  box-shadow 0 6px 18px rgba(0, 0, 0, 0.14)

  .gd-v-photo
    position absolute
    inset 0

.gd-c-heart
  position absolute
  right 6px
  bottom 6px
  display inline-flex
  align-items center
  gap 3px
  padding 2px 7px
  border-radius 999px
  background rgba(0, 0, 0, 0.45)
  color #fff
  font-size 8px

  .fa-solid, .n1
    display none

.gd-s-comments.is-liked .gd-c-heart
  .fa-regular, .n0
    display none

  .fa-solid
    display inline-block
    color #ff4d6d
    animation gd-pop 0.45s cubic-bezier(0.3, 1.6, 0.5, 1)

  .n1
    display inline
