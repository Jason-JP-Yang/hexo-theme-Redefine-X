  left 50%
  bottom 12px
  display flex
  align-items center
  gap 8px
  padding 4px 10px
  border-radius 999px
  background rgba(255, 255, 255, 0.12)
  color #fff
  font-size 9px
  opacity 0
  transform translateX(-50%)
  pointer-events none
  transition opacity 0.3s ease 0.15s

.gd-v-dots
  display flex
  gap 4px

