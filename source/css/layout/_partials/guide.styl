  color #fff

.dark .gd-gh-green
  background #238636

// ─── authorizing giscus ─────────────────────────────────────
// A hidden layer keeps its visibility until its fade has finished; a shown one
// takes it at once. The delay therefore sits on the HIDDEN rule of each pair.
.gd-auth-blog, .gd-auth-gh, .gd-auth-wait
  position absolute
  inset 0
  transition opacity 0.35s ease, visibility 0s linear 0s

.gd-auth-gh, .gd-auth-wait
  opacity 0
  visibility hidden
  transition opacity 0.35s ease, visibility 0s linear 0.35s

