    height 100%

.gd-v-photo
  position relative
  flex none
  overflow hidden
  transition transform 0.5s cubic-bezier(0.3, 0.7, 0.2, 1)

  &.p1
    background linear-gradient(180deg, #7ab8ff 0%, #bcd9ff 42%, #f6c79f 58%, #58795f 59%, #2c4435 100%)

  &.p2
    background linear-gradient(180deg, #2b1e4f 0%, #7b3f8c 38%, #f08a5d 56%, #1e3a5f 57%, #0f2238 100%)

  > i
    position absolute
    left 64%
    top 22%
    width 16%
    padding-top 16%
    border-radius 50%
    background radial-gradient(circle, #fffbe6 0%, #ffd87a 55%, rgba(255, 216, 122, 0) 72%)

  &::before
    content ''
    position absolute
    left 0
    right 0
    bottom 41%
    height 26%
    background rgba(40, 66, 90, 0.75)
    clip-path polygon(0 100%, 0 70%, 14% 38%, 26% 62%, 42% 12%, 58% 58%, 72% 30%, 86% 55%, 100% 36%, 100% 100%)

