// `opacity`, spelled out. A bare `transition 0.4s` is `transition-property:
// all`, and the home banner's background carries this class while sized in
// viewport units — so every window resize animated its width and height for
// 400ms, trailing the viewport and showing the page behind it the whole way.
// A fade transitions opacity; that is the whole of what Swup asks of it.
.transition-fade
  transition opacity 0.4s ease
  opacity 1

.transition-fade-up
  transform translateY(0)
  opacity 1
  transition transform 0.4s ease, opacity 0.4s ease

.transition-fade-down
  transform translateY(0)
  opacity 1
  transition transform 0.4s ease, opacity 0.4s ease

// Define transitions for both classes
html.is-changing
  .transition-fade
    transition opacity 0.4s ease
    opacity 1
  
  .transition-fade-up
    transition transform 0.4s ease, opacity 0.4s ease
    transform translateY(0)
    opacity 1

  .transition-fade-down
    transition transform 0.4s ease, opacity 0.4s ease
    transform translateY(0)
    opacity 1

// Define states for unloaded pages
html.is-animating
  .transition-fade
    opacity 0
  
  .transition-fade-up
    transform translateY(20px)
    opacity 0

  .transition-fade-down
    transform translateY(-20px)
    opacity 0