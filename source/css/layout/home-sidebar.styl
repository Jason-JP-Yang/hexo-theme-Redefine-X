@require '../common/variables'

// The two site cards.
//
// Written at the top level rather than under `.home-sidebar-container` because
// they now have two homes: the classic layout's 240px rail, and a grid cell on
// the bento home page. The cards themselves are identical in both — only where
// they sit changes — so the rail below carries nothing but its own geometry.

.sidebar-content
  redefine-container(
    false,
    1.02,
    1.02,
    20px,
    0
  )
  // The positioning context the pager's dots sit in — unconditional, because
  // `position: relative` with no z-index changes nothing about a card that has
  // no pager, while asking `:has()` for it would leave the dots loose wherever
  // that selector is not understood.
  position relative

  &[marginTop]
    margin-top: $spacing-unit * 0.6

  .avatar img
      width 80px
      height 80px
      border-radius $redefine-border-radius-large
      box-shadow var(--redefine-box-shadow-flat)
      border 1px solid var(--border-color)
      padding 1px

      &:hover
        box-shadow var(--redefine-box-shadow)

  .author

    .name
      text-align center
      font-size 1.2rem
      font-weight 600
      color var(--second-text-color)

    .label
      text-align center
      font-size 0.8rem
      color var(--third-text-color)

// ── The profile card's pager ─────────────────────────────────────────────────
// Present only when a collaborator has actually contributed something; without
// one the card above is the whole card, unchanged.
//
// The size contract, which is the point of the whole arrangement: every page
// carries the same three rows, so the track is exactly as tall as the card
// already was, and the dots live INSIDE the card's own bottom padding rather
// than adding a row under it. Nothing here can move the bento row this card is
// furniture in.
.sb-pager
  position relative
  display flex
  flex-direction column
  justify-content center
  min-width 0
  min-height 0
  // `clip`, never `hidden`: hidden establishes a block formatting context, which
  // would stop the pages' own margins collapsing the way they do in the card
  // without one — and that difference IS a height change.
  overflow clip
  // The horizontal gesture is ours; the vertical one is the page's.
  touch-action pan-y
  // A flex item of the bento card, so it takes the slack the card is given and
  // centres the track in it.
  flex 1 1 auto

  &.is-dragging
    cursor grabbing
    user-select none

.sb-track
  display flex
  flex 0 0 auto
  align-items center
  will-change transform

// A block, not a flex item's own column: the three rows inside must collapse
// their margins exactly as they do in a card with no pager, or the page is a
// different height from the card it replaced.
.sb-page
  flex 0 0 100%
  max-width 100%
  min-width 0
  display block

  // The name and the role marker share ONE line box. Putting the marker under
  // the name would be a fourth row, and a fourth row is a taller card. Scoped to
  // the collaborator pages' own class so the author's page keeps the plain
  // centred block it has always been — a flex row and a centred block resolve
  // the same line box, and "should" is not a size guarantee.
  .sb-name-row
    display flex
    align-items baseline
    justify-content center
    gap 6px
    min-width 0

  .sb-name
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  .sb-role
    flex 0 0 auto
    padding 1px 7px
    border-radius 999px
    font-size 0.62rem
    font-weight 600
    letter-spacing 0.02em
    text-transform uppercase
    line-height 1.5
    color var(--primary-color)
    background unquote('color-mix(in oklab, var(--primary-color) 12%, var(--background-color))')
    border 1px solid unquote('color-mix(in oklab, var(--primary-color) 24%, transparent)')

.sb-dots
  position absolute
  left 0
  right 0
  bottom 5px
  display flex
  justify-content center
  align-items center
  gap 6px
  pointer-events none

.sb-dot
  pointer-events auto
  width 6px
  height 6px
  padding 0
  border 0
  border-radius 999px
  cursor pointer
  background var(--third-text-color)
  opacity 0.32
  // Longhands rather than the transition-t mixin: it splits its arguments on
  // commas, and a cubic-bezier's own commas would be split with them.
  transition-property width, opacity, background-color
  transition-duration 0.32s, 0.2s, 0.2s
  transition-timing-function cubic-bezier(0.22, 0.61, 0.36, 1), ease, ease

  &:hover
    opacity 0.6

  &.is-on
    width 16px
    opacity 1
    background var(--primary-color)

.sidebar-links
  overflow hidden
  redefine-container(
    false,
    1.02,
    1.02,
    15px,
    0
  )

  &[marginTop]
    margin-top: $spacing-unit * 0.6

  .site-info
    background-color var(--second-background-color)
    margin -15px -15px 10px -15px
    border-radius $redefine-border-radius-large-top
    padding 15px
    border-bottom 1px solid var(--border-color)

    .site-name
      font-size 1.2rem
      font-weight 500
      color var(--second-text-color)
      font-family 'Chillax-Variable', 'Noto Color Emoji', sans-serif
      text-align center
      if hexo-config('global.fonts.title.enable') {
        font-family hexo-config('global.fonts.title.family'), 'Noto Color Emoji', sans-serif
      }

    .announcement
      font-size 0.9rem
      color var(--third-text-color)
      text-align center
      margin-top 10px
      margin-bottom 5px

  .links
    padding 5px 0
    display flex
    justify-content center
    align-items center
    color var(--second-text-color)
    text-align left
    border-radius $redefine-border-radius-small
    cursor pointer
    font-family $default-font-family

    .link-name
      font-weight 500

    .icon-space
      margin-right 5px

    &:hover
      color var(--primary-color)
      background-color var(--second-background-color)

    .icon
      font-size 1.2rem

    .label
      font-size 0.8rem

  .announcement-outside
    display flex
    justify-content center
    align-items center
    margin-top 10px
    margin-bottom 5px
    padding 5px 0
    color var(--second-text-color)
    text-align center

// ── The classic layout's rail ────────────────────────────────────────────────
// Only the column geometry lives here now. The bento home page has no rail; it
// places the same two cards in the grid's first row instead.
.home-sidebar-container
  width 240px
  height auto
  margin 0 $spacing-unit

  +redefine-tablet()
    margin 0 ($spacing-unit * 0.5)

  +redefine-mobile()
    display none

  .sticky-container
    top $navbar-height
