.post-box
  display inline
  padding 0 .25rem
  border-radius 4px
  background-color #5A6375
  color #F8FAFC
  font-weight 500
  line-height 1.75
  margin 0 .04rem
  box-decoration-break clone
  -webkit-box-decoration-break clone
  word-break break-word
  overflow-wrap anywhere
  transition background-color .2s ease, color .2s ease

.markdown-body .post-box:first-child
  margin-left 0

.markdown-body .post-box:last-child
  margin-right 0

.markdown-body .post-box + .post-box
  margin-left .08rem

.post-box.post-box-default
  background-color #5A6375

.post-box.post-box-blue
  background-color #2E65B5

.post-box.post-box-cyan
  background-color #2B7F95

.post-box.post-box-teal
  background-color #2A8C74

.post-box.post-box-green
  background-color #2F874A

.post-box.post-box-lime
  background-color #638E2D

.post-box.post-box-yellow
  background-color #BE9700

.post-box.post-box-amber
  background-color #A56B1B

.post-box.post-box-orange
  background-color #B66223

.post-box.post-box-red
  background-color #AE3838

.post-box.post-box-pink
  background-color #A33A78

.post-box.post-box-purple
  background-color #7547B5

.post-box.post-box-indigo
  background-color #4B5FC4

.post-box.post-box-gray
  background-color #687588

.post-box.post-box-slate
  background-color #3F5A84

.post-box.post-box-display
  display block
  width fit-content
  max-width 100%
  padding .25rem .5rem
  margin .6rem auto
  line-height 1.6

  .mathjax-block
    margin .25rem auto