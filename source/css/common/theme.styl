  --box-blue-bg : mode == 'light' ? $box-blue-bg : $dark-box-blue-bg
  --box-blue-text : mode == 'light' ? $box-blue-text : $dark-box-blue-text
  --box-cyan-bg : mode == 'light' ? $box-cyan-bg : $dark-box-cyan-bg
  --box-cyan-text : mode == 'light' ? $box-cyan-text : $dark-box-cyan-text
