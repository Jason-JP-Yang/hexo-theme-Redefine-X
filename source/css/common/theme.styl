  --box-indigo-bg : mode == 'light' ? $box-indigo-bg : $dark-box-indigo-bg
  --box-indigo-text : mode == 'light' ? $box-indigo-text : $dark-box-indigo-text
  --box-gray-bg : mode == 'light' ? $box-gray-bg : $dark-box-gray-bg
  --box-gray-text : mode == 'light' ? $box-gray-text : $dark-box-gray-text
  --box-slate-bg : mode == 'light' ? $box-slate-bg : $dark-box-slate-bg
  --box-slate-text : mode == 'light' ? $box-slate-text : $dark-box-slate-text

  --home-banner-text-color mode == 'light' ? $home-banner-text-color : $home-banner-text-color-dark
  --home-banner-icons-container-border-color mode == 'light' ? $home-banner-icons-container-border-color : $home-banner-icons-container-border-color-dark
  --home-banner-icons-container-background-color mode == 'light' ? $home-banner-icons-container-background-color : $home-banner-icons-container-background-color-dark

  --redefine-box-shadow : var(--shadow-color-2) 0px 6px 24px 0px, var(--shadow-color-1) 0px 0px 0px 1px
  --redefine-box-shadow-hover : var(--shadow-color-2) 0px 6px 24px 0px, var(--shadow-color-1) 0px 0px 0px 1px, var(--shadow-color-1) 0px 0px 0px 1px inset
  --redefine-box-shadow-flat : var(--shadow-color-2) 0px 1px 4px 0px, var(--shadow-color-1) 0px 0px 0px 1px
  --redefine-box-shadow-flat-hover : var(--shadow-color-2) 0px 1px 4px 0px, var(--shadow-color-1) 0px 0px 0px 1px, var(--shadow-color-1) 0px 0px 0px 1px inset

  --mermaid-theme : mode == 'light' ? $mermaid-theme : $dark-mermaid-theme

}


$temp-mode = hexo-config('colors.default_mode')
$default-mode = $temp-mode == 'dark' ? 'dark' : 'light'

:root {
  root-color($default-mode)
}

// `data-scheme` is the same palette on one subtree: a switch restyles the page
// (or its mirror) a subtree at a time.
.light, [data-scheme="light"] {
  root-color('light')
}

.dark, [data-scheme="dark"] {
  root-color('dark')
}

// ========================================================================================
//                                  SWITCH ANIMATION
// ========================================================================================
// tools/lightDarkSwitch.js lands a scheme in one style pass. No element may
// start a colour transition in that pass — each would animate on its own, a
// recalc and repaint per frame — so every colour transition reads `--tg` and
// `--tgd` (animated.styl's mixins; scripts/filters/theme-switch-transitions.js
// for the rest), which are 0 while a switch is on. Running transitions of any
// kind are left alone. `data-tg` carries the same zero on bounded subtrees, so
// it can be lifted from them a few at a time.
html.theme-switching, [data-tg] {
  --tg: 0s
  --tgd: 0s
}

// Where the wave opens from, and how far. Registered so the circle interpolates.
@property --theme-x
  syntax '<length>'
  inherits false
  initial-value 0px

@property --theme-y
  syntax '<length>'
  inherits false
  initial-value 0px

@property --theme-r
  syntax '<length>'
  inherits false
  initial-value -2px

// How much of the new scheme shows outside the ring (the old one melting).
@property --theme-m
  syntax '<number>'
  inherits false
  initial-value 0

// The old page is a snapshot laid over the live one; the script drives it and
// the wave is a hole opening in it.
html.theme-reveal::view-transition-old(root) {
  animation: none
  mix-blend-mode: normal
  mask-image: unquote('radial-gradient(circle at var(--theme-x) var(--theme-y), transparent var(--theme-r), #000 calc(var(--theme-r) + 1.5px))')
}

// The live page under the snapshot takes every pointer.
html.theme-reveal::view-transition {
  pointer-events: none
}

// Set inside the switch, so only the old state is captured: under the snapshot
// is the real document, painted and hit-tested as usual. A captured root is
// drawn by the transition's layers instead and takes no input.
html.theme-live {
  view-transition-name: none
}

// The new page's tone settling (lightDarkSwitch.js animates its backdrop).
.theme-tone {
  position: fixed
  inset: 0
  z-index: 2147483647
  pointer-events: none
}

// The live copy of the page in the other scheme (tools/themeMirror.js). Inside
// the ring it is opaque; outside, `--theme-m` of it shows over the real page.
.theme-mirror {
  position: fixed
  inset: 0
  z-index: 2147483647
  pointer-events: none
  visibility: hidden
  contain: strict
  mask-image: unquote('radial-gradient(circle at var(--theme-x) var(--theme-y), #000 var(--theme-r), rgb(0 0 0 / var(--theme-m)) calc(var(--theme-r) + 1.5px))')
}

.theme-mirror.is-shown {
  visibility: visible
}

// Dims or lifts the real page under the mirror as the old scheme gives way.
.theme-shade {
  position: fixed
  inset: 0
  z-index: 2147483646
  pointer-events: none
}
