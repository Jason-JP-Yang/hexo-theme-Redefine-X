  --box-pink-bg : mode == 'light' ? $box-pink-bg : $dark-box-pink-bg
  --box-pink-text : mode == 'light' ? $box-pink-text : $dark-box-pink-text
  --box-purple-bg : mode == 'light' ? $box-purple-bg : $dark-box-purple-bg
