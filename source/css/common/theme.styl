  --box-orange-bg : mode == 'light' ? $box-orange-bg : $dark-box-orange-bg
  --box-orange-text : mode == 'light' ? $box-orange-text : $dark-box-orange-text
  --box-red-bg : mode == 'light' ? $box-red-bg : $dark-box-red-bg
