<%#
    Blog Management — the admin console.

    This markup is never published. The build renders it, seals it under the
    admin key and writes the ciphertext to the vault prefix; what lands at
    /blog-management/ is the access probe in pages/management/admin-gate.ejs,
    and this arrives only once the Worker has released the key AND the blob has
    opened under it. See scripts/vault-generator.js.

    The shell is the article layout's, not a page container's: the console is a
    long document with sections, and the contents rail beside it is the one the
    theme already has. Everything inside the sections is painted by
    source/js/plugins/blog-management.js — from the inventory sealed alongside
    this markup for anything the build knew, and from the Worker only for what
    it could not: who may read what, and the notification database.
%>
<% const backend = backend_config(); %>
<div class="post-page-container flex relative justify-between box-border w-full h-full">
    <div class="article-content-container">
        <%# The article's own inset, as the same utility `.article-content`
            carries — the console is a document in the article container, so it
            has to sit on the article's measure. %>
        <div id="blog-management" class="bm px-2 sm:px-6 md:px-8">
            <header class="bm-head">
                <h1 class="bm-heading" id="bm-top">
                    <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>
                    <%= __('management.title') %>
                </h1>
                <p class="bm-lede"><%= __('management.lede') %></p>
            </header>

            <div class="bm-console">
                <%# Posts first: it is the section this console is opened for, and
                    the only one whose content the build already knows. The console
                    only exists with encryption on, so Posts always does. %>
                <section class="bm-section" data-part="posts" id="bm-posts"></section>
                <% if (backend.analytics.enable) { %>
                <section class="bm-section" data-part="analytics" id="bm-analytics"></section>
                <% } %>
                <% if (backend.notifications.enable) { %>
                <section class="bm-section" data-part="announce" id="bm-announce"></section>
                <section class="bm-section" data-part="notifications" id="bm-notifications"></section>
                <section class="bm-section" data-part="followers" id="bm-followers"></section>
                <% } %>
            </div>
        </div>
    </div>

    <%# The contents rail, written out rather than generated: this page has no
        `page.content` for toc() to read, and its sections are fixed. Same
        markup the helper emits, so layouts/toc.js drives it unchanged. %>
    <% if (theme.articles.toc.enable === true) {
        const notify = backend.notifications.enable;
        const sections = [
            ['bm-posts', __('management.p_title')],
            backend.analytics.enable ? ['bm-analytics', __('management.a_title')] : null,
            notify ? ['bm-announce', __('management.announce')] : null,
            notify ? ['bm-notifications', __('management.notifications')] : null,
            notify ? ['bm-followers', __('management.followers')] : null,
        ].filter(Boolean);
    %>
    <div class="toc-content-container">
        <div class="post-toc-wrap">
            <div class="post-toc">
                <div class="toc-title"><%- __('toc') %></div>
                <div class="page-title"><%= __('management.title') %></div>
                <ol class="nav">
                    <% sections.forEach(([id, label]) => { %>
                    <li class="nav-item nav-level-2">
                        <a class="nav-link" href="#<%= id %>"><span class="nav-text"><%= label %></span></a>
                    </li>
                    <% }); %>
                </ol>
            </div>
        </div>
    </div>
    <% } %>
</div>
