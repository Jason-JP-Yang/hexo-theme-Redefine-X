<%
    // One album on the collection page. Extracted from masonry-collection so the
    // vault generator can render the SAME markup for an encrypted album without a
    // second, drifting copy of it in JavaScript.
    const thumbs = typeof hasThumbnail === "undefined" ? false : hasThumbnail;
    const vault = typeof isVault !== "undefined" && isVault;

    // An encrypted album is a statement about the card, not an invitation: it
    // drops `group` and the press-scale so nothing under the cursor moves or
    // recolours, and wears the same badge and the same outline the home grid's
    // encrypted tile does.
    const hover = "group transform scale-100 transition-transform duration-100 ease-linear active:scale-95";

    // An avatar whose `src` is a sealed hash is EMPTY until the reader's key
    // opens it, and an empty `src` fires `error` the moment the markup is
    // parsed. Hiding on that error is what blanked every encrypted album's
    // avatar; the guard defers to the reveal pass (tools/vaultCrypto.js), which
    // drops the attribute once the real bytes are in.
    const onImgError = "this.dataset.vaultAsset||(this.style.display='none')";
%>
<li class="<%= vault ? "is-vault-album" : hover %>"
    <%- vault ? ' data-vault-album="1"' : "" %>>
    <a href="<%= f.link %>">
        <%# Over the thumbnail, which is the only part of the card that is a
            picture. The flat variant has none, so its badge goes in the row
            (below) rather than on top of the avatar and the album's name. %>
        <% if (vault && thumbs) { %>
        <%- partial('components/vault-badge') %>
        <% } %>

        <% if (thumbs) { %>
        <div class="content rounded-lg redefine-box-shadow-flat">
            <div class="thumbnail rounded-t-lg h-32 md:h-44 overflow-hidden">
                <img class="rounded-t-lg object-cover w-full h-full" src="<%= f.thumbnail %>" />
            </div>
            <div class="avainfo flex flex-row items-center gap-1 sm:gap-2 overflow-hidden min-w-0">
                <div class="avatar h-16 w-16 rounded-bl-lg bg-third-background-color">
                    <% if (f.avatar) { %>
                    <img class="rounded-bl-lg h-16 w-16 max-w-none" src="<%= f.avatar %>" onerror="<%- onImgError %>">
                    <% } else { %>
                    <i class="fa-solid fa-user-group"></i>
                    <% } %>
                </div>
                <div class="flex flex-col min-w-0">
                    <div class="text-lg text-second-text-color ellipsis<%= vault ? "" : " group-hover:!text-primary" %>"><%= f.name %></div>
                    <div class="text-third-text-color ellipsis"><%= f.description %></div>
                </div>
            </div>
        </div>
        <% } else { %>
        <div class="flex flex-row items-center gap-1 sm:gap-2 overflow-hidden min-w-0 rounded-lg shadow-redefine-flat">
            <div class="h-16 w-16 rounded-bl-lg bg-third-background-color">
                <% if (f.avatar) { %>
                <img class="rounded-l-lg h-16 w-16 max-w-none" src="<%= f.avatar %>" onerror="<%- onImgError %>">
                <% } else { %>
                <i class="fa-solid fa-user-group"></i>
                <% } %>
            </div>
            <div class="flex flex-col min-w-0">
                <div class="text-lg text-second-text-color ellipsis<%= vault ? "" : " group-hover:!text-primary" %>"><%= f.name %></div>
                <div class="text-third-text-color ellipsis"><%= f.description %></div>
            </div>
            <% if (vault) { %>
            <%- partial('components/vault-badge', { extra: 'is-inline ml-auto mr-3' }) %>
            <% } %>
        </div>
        <% } %>
    </a>
</li>
