<%
// Define an array of images to display in the masonry layout
const images = page.images || theme.masonry;
const siteRoot = config.root || '/';
const hasReactions = page.masonryReactions && page.masonryReactions.imageIds && page.masonryReactions.imageIds.length > 0;

// Helper to build full image path
function buildImagePath(imagePath) {
    if (!imagePath) return '';
    // If already absolute or starts with http/https, return as is
    if (imagePath.startsWith('/') || imagePath.startsWith('http://') || imagePath.startsWith('https://')) {
        return imagePath;
    }
    // Otherwise, prepend /masonry/ path
    return siteRoot + 'masonry/' + imagePath;
}

// Determine container CSS class based on image metadata and reactions mode
function getContainerClass(image) {
    const classes = ['image-container'];
    if (hasReactions) {
        // Reactions mode: title always top-left, heart button bottom-right
        classes.push('masonry-reactions-mode');
    } else if (image.title && !image.description) {
        // Title-only mode: no description → title centered at bottom
        classes.push('masonry-title-only');
    }
    return classes.join(' ');
}
%>

<h1 class="page-title-header">
	<%- getPageTitle(page) %>
</h1>

<%# Which version of this album you are looking at, in the same object an
	article uses. Only a DRAFT ever renders it, and a draft album is never
	published — so this markup only exists inside the sealed page its author
	opens. A draft standing in front of a published album offers the swap; one
	that stands in front of nothing says only what it is. %>
<% if (page.albumDraft) { %>
<div class="article-version" data-version="draft">
	<% if (page.albumSupersedes) { %>
	<span class="article-version-tag is-draft">
		<i class="fa-solid fa-pen-nib" aria-hidden="true"></i><%= __('vault.draft') %>
	</span>
	<a class="article-version-swap" href="<%= url_for('/masonry/' + page.albumSupersedes + '/') %>">
		<i class="fa-regular fa-eye" aria-hidden="true"></i>
		<span><%= __('vault.view_published') %></span>
	</a>
	<% } else { %>
	<span class="article-version-tag is-unpublished">
		<i class="fa-solid fa-eye-slash" aria-hidden="true"></i><%= __('vault.unpublished') %>
	</span>
	<% } %>
</div>
<% } %>

<%#
Masonry layout using CSS columns.
Images are output as regular <img> tags which will be transformed to img-preloader
by lazyload-handle.js during hexo build (same as normal post images).
The preloaders have correct aspect ratios so layout is stable from page load.

EXIF support: images with data beyond just 'title' get a hidden <template> containing
the EXIF info card HTML. The imageViewer picks this up when the image is opened.

Reactions mode: when giscus comment is enabled and reactions data exists,
images show title (top-left) and heart button (bottom-right) instead of description.
%>
<%# `data-album-title` is the album's identity everywhere: it is the page it is
	published at, the key masonry.yml's `page-title` (or `name`) carries, and what
	the online editor looks this album up by. Public on purpose — it is already
	in the URL. %>
<div id="masonry-container" class="markdown-body" data-album-title="<%= page.title %>">
	<% images.forEach(function(image) { %>
	<div class="masonry-item">
		<div class="<%- getContainerClass(image) %>">
			<img src="<%- buildImagePath(image.image) %>" alt="<%- image.title || '' %>">
			<% if (image.title) { %>
			<div class="image-title"><%- image.title %></div>
			<% } %>
			<% if (!hasReactions && image.description) { %>
			<div class="image-description"><%- image.description %></div>
			<% } %>
			<% if (image.hasExifInfo && image.exifCardHtml) { %>
			<template class="masonry-exif-template"><%- image.exifCardHtml %></template>
			<% } %>
		</div>
	</div>
	<% }); %>
</div>

<% if (hasReactions) { %>
<%# Embed reactions config as JSON for the frontend script (data fetched live via giscus API) %>
<script type="application/json" id="masonry-reactions-data">
<%- JSON.stringify(page.masonryReactions).replace(/</g, '\\u003c') %>
</script>
<%# masonry-reactions.js is loaded globally via scripts.ejs for Swup compatibility %>
<% } %>