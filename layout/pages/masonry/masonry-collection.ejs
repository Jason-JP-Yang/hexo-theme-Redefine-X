<%#
	The album index. Every category block carries `data-masonry-category` so an
	encrypted album, which is not in this markup at all, can be put back into the
	right one once the reader's key has opened it (source/js/plugins/vault.js).
%>
<div class="friends-link-container flex flex-col">
	<h1 class="text-[3.2rem] mt-1.5 mb-5 font-bold leading-[1]"><%= page.title %></h1>
	<% for (const category of page.masonry_items) { %>
	<% const thumbs = category.has_thumbnail == true; %>
	<div class="mt-2 mb-4" data-masonry-heading="<%= category.links_category %>">
		<h2 class="text-2xl font-bold"><%= category.links_category %></h2>
	</div>
	<ul class="grid mb-6 w-full gap-4 <%= thumbs ? "grid-cols-2" : (theme.page_templates.friends_column === 3 ? "grid-cols-2 sm:grid-cols-3" : "grid-cols-2") %>"
		data-masonry-category="<%= category.links_category %>" data-masonry-thumbs="<%= thumbs %>">
		<% for (const f of category.list) { %>
		<%- partial('pages/masonry/masonry-collection-card', { f: f, hasThumbnail: thumbs, isVault: false }) %>
		<% } %>
	</ul>
	<% } %>
	<div class="clear"></div>
</div>
