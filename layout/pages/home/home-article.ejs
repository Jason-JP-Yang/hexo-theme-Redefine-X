<%# Each meta entry is one inline-flex unit: the icon and its text are flex items
    of the same box, so there is no collapsed whitespace between them for a line
    break to land on. That is what used to strand an icon alone on its own line.
    Wrapping happens BETWEEN entries; within an entry the text ellipsises. %>
<div class="home-article-meta-info-container">
    <div class="home-article-meta-info">
        <span class="home-article-meta-item">
            <i class="fa-solid fa-calendars"></i>
            <%# .home-article-date must stay text-only: utils.js relativeTimeInHome()
                overwrites its textContent, which would eat the icon if it were inside. %>
            <span class="meta-text home-article-date" data-date="<%= post.date %>">
                <% if (theme.home.article_date_format == 'auto' || theme.home.article_date_format == 'relative') { %>
                    <%= date(post.date, config.date_format) %>
                <% } else { %>
                    <%= date(post.date, theme.home.article_date_format) %>
                <% } %>
            </span>
        </span>

        <% if (post.categories.length && theme.home.categories.enable === true) { %>
            <span class="home-article-meta-item home-article-category">
                <i class="fa-solid fa-folders"></i>
                <ul class="meta-text">
                    <% let previousParentId = null; %>
                    <% post.categories.forEach((category, i) => { %>
                        <% if (previousParentId !== category.parent) { %>
                            <% if (previousParentId !== null) { %>
                                <li class="meta-sep">></li>
                            <% } %>
                            <li><a href="<%- url_for(category.path) %>"><%= category.name %></a></li>
                        <% } else { %>
                            <li class="meta-sep">|</li>
                            <li><a href="<%- url_for(category.path) %>"><%= category.name %></a></li>
                        <% } %>
                        <% previousParentId = category.parent; %>
                    <% }); %>
                </ul>
            </span>
        <% } %>

        <% if (post.tags.length && theme.home.tags.enable === true) { %>
            <span class="home-article-meta-item home-article-tag">
                <i class="fa-solid fa-tags"></i>
                <ul class="meta-text">
                    <% post.tags.forEach((tag, i) => {
                    if (theme.home.tags.limit === 0 || i + 1 <= theme.home.tags.limit) { %>
                        <% if (i !== 0) { %><li class="meta-sep">|</li><% } %>
                        <li><a href="<%- url_for(tag.path) %>"><%= tag.name %></a></li>
                    <% }}); %>
                </ul>
            </span>
        <% } %>
    </div>

    <%# margin-left:auto rather than space-between on the container: when the meta
        entries wrap onto their own line this link still sits at the right edge
        instead of falling back to flex-start. %>
    <a class="home-article-read-more" href="<%- url_for(post.path) %>"><%- __('read_more') %><span class="seo-reader-text"><%= post.title %></span><i class="fa-solid fa-angle-right"></i></a>
</div>
