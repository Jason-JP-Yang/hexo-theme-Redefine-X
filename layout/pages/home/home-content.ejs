<%
    // ── Bento tiers ──────────────────────────────────────────────────────────
    // A tile's size comes from `bento:` in the post's front matter when it is
    // set, and is derived otherwise.
    //
    //   wide      full width, cover beside the text, sides alternating
    //   standard  half width, cover on top
    //   compact   half width, text-forward, no cover
    //
    // There is deliberately no full-width-cover tier: at the width the home
    // column now runs to, a 16:9 cover spanning it stands ~676px tall, which
    // buries everything under it.
    const BENTO_TIERS = ["wide", "standard", "compact"];
    const bentoEnabled = theme.home.bento && theme.home.bento.enable !== false;
    const baseExcerptLength = theme.home.excerpt_length || 200;

    // How much excerpt material each tier gets, as a multiple of the configured
    // length. The tile clamps the text visually; this only decides how much
    // there is to clamp — so a compact tile, which has no cover to carry it, has
    // enough text to hold its column.
    const EXCERPT_SCALE = { wide: 0.9, standard: 1, compact: 2 };

    // `thumbnail` wins here — it exists precisely to override the cover in the
    // list — and everything else falls through to the same file the post page
    // uses for its banner. The RATIO is shared either way; see
    // global.cover_aspect_ratio.
    function resolveCover(post) {
        if (post.thumbnail === false) return "";
        if (!post.thumbnail && !post.cover && !post.banner) return "";
        if (post.thumbnail) return post.thumbnail;
        if (post.cover && post.cover.includes("/")) return post.cover;
        if (post.banner && post.banner.includes("/")) return post.banner;
        if (config.marked && config.marked.postAsset === true) {
            return [post.path, post.cover || post.banner].join("/");
        }
        return "";
    }

    function resolveTier(post, cover) {
        const declared = typeof post.bento === "string" ? post.bento.trim().toLowerCase() : "";
        if (BENTO_TIERS.includes(declared)) return declared;
        if (post.sticky) return "wide";
        return cover ? "standard" : "compact";
    }

    // Numbering runs on across pagination rather than restarting at 1 on page 2.
    const perPage =
        (config.index_generator && config.index_generator.per_page) ||
        config.per_page ||
        page.posts.length ||
        0;
    const numberOffset = ((page.current || 1) - 1) * perPage;

    // Every second `wide` tile puts its cover on the right. Counted over the
    // wide tiles alone, so the zig-zag survives any number of half-width tiles
    // landing between them.
    let wideCount = 0;
%>
<div class="home-content-container">
    <ul class="home-article-list<%= bentoEnabled ? " bento" : "" %>">
        <% page.posts.forEach((post, index) => { %>
            <%
                const cover = resolveCover(post);
                const tier = bentoEnabled ? resolveTier(post, cover) : "standard";
                // `compact` drops the cover on purpose: being text-forward is
                // what lets it stand next to a tile that has one instead of
                // looking like a tile that lost its image.
                const showCover = !!cover && tier !== "compact";
                const excerptLength = Math.round(baseExcerptLength * (EXCERPT_SCALE[tier] || 1));
                const coverRight = tier === "wide" && wideCount++ % 2 === 1;
                const postNumber = numberOffset + index + 1;
            %>
            <li class="home-article-item tier-<%= tier %><%= showCover ? "" : " no-cover" %><%= coverRight ? " cover-right" : "" %>">

                <% if (post.sticky) { %>
                    <div class="home-article-sticky-badge">
                        <i class="fa-regular fa-thumbtack"></i><%- __('sticky') %>
                    </div>
                <% } %>

                <% if (showCover) { %>
                    <div class="home-article-thumbnail">
                        <%# aria-hidden + tabindex="-1": this links to the same place as the
                            title below it, so it is decorative to a screen reader and should
                            not cost a second tab stop. %>
                        <a href="<%- url_for(post.path) %>" tabindex="-1" aria-hidden="true">
                            <img src="<%- url_for(cover) %>" alt="<%= post.title %>"
                                <%- index === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async" />
                        </a>
                    </div>
                <% } %>

                <div class="home-article-body">
                    <span class="home-article-index" aria-hidden="true"><%= postNumber %></span>

                    <h3 class="home-article-title">
                        <a href="<%- url_for(post.path) %>">
                            <%= post.title %>
                        </a>
                    </h3>

                    <div class="home-article-content markdown-body">
                        <% if (post.excerpt && post.excerpt == "false") { %>
                        <% } else if (post.excerpt && post.excerpt !== "false") { %>
                            <%- render(post.excerpt, "markdown") %>
                        <% } else { %>
                            <%- truncate(strip_html(post.content), {length: excerptLength}) %>
                        <% } %>
                    </div>

                    <%- partial('pages/home/home-article', {post: post}) %>
                </div>
            </li>
        <% }) %>
    </ul>

    <div class="home-paginator px-7 py-5">
        <%- partial('utils/paginator', {pageObject: page}) %>
    </div>
</div>
