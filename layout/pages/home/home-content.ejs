<%
    // ── Home grid ────────────────────────────────────────────────────────────
    // Sizes come from the plan (scripts/helpers/bento-helpers.js), which weighs
    // every post — pinned, cover, length, excerpt, recency, taxonomy, title —
    // and hands it a slot to match. This file fills the slot it is handed.
    //
    // A slot fixes WHERE a tile goes and HOW BIG it is, and nothing else. How
    // much of the summary is printed is not decided here or anywhere else in the
    // build: the tile hands the excerpt whatever height it has left and the
    // excerpt stops on the last line that fits (layout/home-content.styl,
    // layouts/bentoFit.js).
    const bentoEnabled = theme.home.bento !== false;
    const baseExcerptLength = theme.home.excerpt_length || 200;

    // `thumbnail` wins here — it exists precisely to override the cover in the
    // list — and everything else falls through to the same file the post page
    // uses for its banner. Covers are always shown when a post has one.
    function resolveCover(post) {
        if (post.thumbnail === false) return "";
        if (!post.thumbnail && !post.cover && !post.banner) return "";
        if (post.thumbnail) return post.thumbnail;
        if (post.cover && post.cover.includes("/")) return post.cover;
        if (post.banner && post.banner.includes("/")) return post.banner;
        if (config.marked && config.marked.postAsset === true) {
            return [post.path, post.cover || post.banner].join("/");
        }
        return "";
    }

    const posts = page.posts.toArray ? page.posts.toArray() : page.posts;

    // Numbering runs on across pagination rather than restarting at 1 on page 2.
    const perPage =
        (config.index_generator && config.index_generator.per_page) ||
        config.per_page ||
        posts.length ||
        0;
    const currentPage = page.current || 1;
    const numberOffset = (currentPage - 1) * perPage;

    // The site cards replace the old sidebar rail, so `home.sidebar.enable` now
    // means "open the grid with them". They are on every page, in the first
    // band, and the paginator leaves them alone.
    const withFeatures =
        bentoEnabled && theme.home.sidebar && theme.home.sidebar.enable === true;

    // The classic list is one cell wide by one cell's worth of text: it clamps at
    // three lines and has no grid to place anything in.
    const plan = bentoEnabled
        ? bentoPlan(posts, { features: withFeatures })
        : posts.map((post, i) => ({ kind: "post", tier: "standard", postIndex: i, lg: { cn: 1, rn: 1 } }));

    // How much RAW text to put in the document — a payload question, not a
    // display one. The tile decides how many lines of it to show; all this has to
    // guarantee is that it never runs out before the tile does, because a tile
    // that has exhausted its excerpt shows white space with no ellipsis, which
    // reads as broken rather than as truncated.
    //
    // One cell of tile at the grid's widest column holds a little under 500
    // characters once the cover, title and meta row have taken their share, so a
    // tile is given its cell count's worth with a little over. `excerpt_length`
    // is the floor.
    const CHARS_PER_CELL = 520;
    function excerptBudget(tile) {
        const cells = ((tile.lg && tile.lg.cn) || 1) * ((tile.lg && tile.lg.rn) || 1);
        return Math.max(baseExcerptLength, CHARS_PER_CELL * cells);
    }
%>
<div class="home-content-container">
    <ul class="home-article-list<%= bentoEnabled ? " bento" : "" %>" data-page="<%= currentPage %>"
        <%- bentoEnabled ? ' data-lg-rows="' + bentoRows(plan, "lg") + '" data-md-rows="' + bentoRows(plan, "md") + '"' : "" %>>
        <% plan.forEach((tile) => { %>
            <% if (tile.kind === "feature") { %>
                <%- partial('pages/home/home-feature-tile', { tile: tile }) %>
            <% } else { %>
                <%
                    const post = posts[tile.postIndex];
                    const cover = resolveCover(post);
                %>
                <%- partial('pages/home/home-article-card', {
                    post: post,
                    tile: tile,
                    bentoEnabled: bentoEnabled,
                    cover: cover ? url_for(cover) : "",
                    href: url_for(post.path),
                    postNumber: numberOffset + tile.postIndex + 1,
                    excerptChars: excerptBudget(tile),
                    isVault: false,
                }) %>
            <% } %>
        <% }) %>
    </ul>

    <%- partial('pages/home/home-paginator') %>
</div>
