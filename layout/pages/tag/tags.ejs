<% if (site.tags.length){ %>
	<h1 class="tagcloud-header">
		<%- getPageTitle(page) %>
	</h1>

	<% if (theme.page_templates.tags_style == 'cloud') { %>
	<div class="tagcloud-content">
		<%- tagcloud({ min_font: 1, max_font: 3, unit: 'rem', amount: 100 }) %>
	</div>

	<% } else {%>
	<div class="tagcloud-content">
		<ul class="tag-list" data-show-value="true">
			<%# Sorted, because `site.tags` has no order of its own: Hexo builds the
			    tag model while processing posts CONCURRENTLY, so the collection comes
			    out in whatever order those reads finished in — a different permutation
			    per machine, and in principle per run. The `cloud` branch above is
			    already safe; tagcloud() defaults to orderby: 'name'. Warehouse compares
			    with bare < and >, so this is code-unit order and not the runner's locale. %>
			<% site.tags.sort('name').forEach(function(tag){ %>
				<li>
					<a data-weight="<%- tag.posts.length %>" href="<%- url_for("/" + tag.path) %>">
						<i class="fa-solid fa-hashtag"></i><%- tag.name %>
					</a>
				</li>
			<% }) %>
		</ul>
	</div>
	<% } %>
<% } %>
