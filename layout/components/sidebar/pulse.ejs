<%#
    The activity card — one cell of the home grid's furniture row.

    Nothing is rendered here but the frame and its one label. The calendar is
    drawn by layouts/pulseCard.js, which cannot know its own shape until the row
    has been measured: the cell size comes from the height the row hands it and
    the day count from the width, so neither is expressible here.
%>
<div class="sidebar-pulse" data-pulse data-l-title="<%= __('analytics.activity') %>"
     data-ux="bento" data-ux-card="activity">
    <div class="pulse-head">
        <span class="pulse-title"><%= __('analytics.activity') %></span>
    </div>
    <div class="pulse-plot" data-pulse-plot>
        <div class="pulse-grid" data-pulse-grid role="img"
             aria-label="<%= __('analytics.activity') %>"></div>
    </div>
</div>
