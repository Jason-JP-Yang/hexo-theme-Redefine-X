<div class="side-tools-container">
	<ul class="hidden-tools-list">
		<li class="right-bottom-tools tool-font-adjust-plus flex justify-center items-center" data-ux="tool" data-ux-name="font">
			<i class="fa-regular fa-magnifying-glass-plus"></i>
		</li>

		<li class="right-bottom-tools tool-font-adjust-minus flex justify-center items-center" data-ux="tool" data-ux-name="font">
			<i class="fa-regular fa-magnifying-glass-minus"></i>
		</li>

		<li class="right-bottom-tools tool-dark-light-toggle flex justify-center items-center" data-ux="tool" data-ux-name="theme">
			<i class="fa-regular fa-moon"></i>
		</li>

		<!-- rss -->
		<% if (theme.plugins.feed.enable && config.feed) { %>
		<li class="right-bottom-tools rss flex justify-center items-center">
			<a class="flex justify-center items-center" href="<%= '/' + config.feed.path %>" target="_blank"
			   data-ux="external" data-ux-kind="rss">
				<i class="fa-regular fa-rss"></i>
			</a>
		</li>
		<% } %>

		<% if (theme.global.scroll_progress.percentage !== true) { %>
		<li class="right-bottom-tools tool-scroll-to-top flex justify-center items-center" data-ux="tool" data-ux-name="top">
			<i class="fa-regular fa-arrow-up"></i>
		</li>
		<% } %>

		<li class="right-bottom-tools tool-scroll-to-bottom flex justify-center items-center" data-ux="tool" data-ux-name="bottom">
			<i class="fa-regular fa-arrow-down"></i>
		</li>
	</ul>

	<ul class="visible-tools-list">
		<%# The article's own tools rail is hidden below 640px, and the pencil with
			it. The corner rail is what a phone has instead, so the pencil is
			rendered here too and CSS shows exactly one of the two. %>
		<% if (backend_config().online_editor.enable && (is_post() || (page.type === "vault" && page.vault_kind !== "masonry"))) { %>
		<li class="right-bottom-tools tool-edit-post blog-admin-only flex justify-center items-center" title="<%= __('editor.edit_post') %>">
			<i class="fa-regular fa-pen-to-square"></i>
		</li>
		<% } %>

		<%# An album has no tools rail of its own — a masonry page is a page, not an
			article — so this is the ONLY pencil it gets, and it shows at every
			width rather than only on a phone. A class of its own, so the rule that
			hides the article's spare pencil on a desktop cannot reach it, and so
			admin.js can tell which of the two editors to load. %>
		<% if (backend_config().online_editor.enable && (page.type === "masonry" || (page.type === "vault" && page.vault_kind === "masonry"))) { %>
		<li class="right-bottom-tools tool-edit-album blog-admin-only flex justify-center items-center" title="<%= __('editor.edit_album') %>">
			<i class="fa-regular fa-pen-to-square"></i>
		</li>
		<% } %>
		<li class="right-bottom-tools toggle-tools-list flex justify-center items-center">
			<i class="fa-regular fa-cog <% if (theme.global.side_tools && theme.global.side_tools.gear_rotation !== false) { %>fa-spin<% } %>"></i>
		</li>
		<% if (theme.global.scroll_progress.percentage === true) { %>
		<li class="right-bottom-tools tool-scroll-to-top flex justify-center items-center" data-ux="tool" data-ux-name="top">
			<i class="arrow-up fas fa-arrow-up"></i>
			<span class="percent"></span>
		</li>
		<% } %>
		<% if (theme.plugins.aplayer.enable && theme.plugins.aplayer.type === "mini") { %>
		<li class="right-bottom-tools tool-aplayer flex justify-center items-center" data-ux="tool" data-ux-name="player">

		</li>
		<% } %>
	</ul>
</div>
